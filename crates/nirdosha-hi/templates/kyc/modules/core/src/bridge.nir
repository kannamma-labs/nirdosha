pub const HUMAN_ROLES: &[&str] = &[
    "kyc_analyst",
    "kyc_senior_analyst",
    "kyc_mlro",
    "compliance_officer",
    "relationship_manager",
    "auditor",
    "platform_admin",
    "customer",
];

pub const DEMO_TENANT: &str = "default";
/// Boot-time seeding for singleton guarded rows. Idempotent per
/// process: `std::sync::Once` (the guarded store lives for the process
/// lifetime, and `system_write` refuses a duplicate create rather than
/// upserting). Called from the generated `serve` main and from tests
/// that build a router without running main.
pub fn seed_singletons() {
    static ONCE: std::sync::Once = std::sync::Once::new();
    ONCE.call_once(|| {
        risk_rule_table().system_write(DEMO_TENANT, &RiskRuleRow { id: 0, rule_id: "current".into(), tenant_id: DEMO_TENANT.into(), rule_name: Default::default(), severity: Default::default(), expression: Default::default() });
        checklist_template_table().system_write(DEMO_TENANT, &ChecklistTemplateRow { id: 0, template_id: "current".into(), tenant_id: DEMO_TENANT.into(), name: Default::default(), applies_to: Default::default(), steps: Default::default() });
    });
}
