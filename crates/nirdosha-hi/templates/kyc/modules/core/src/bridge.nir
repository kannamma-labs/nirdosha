pub fn watchlist_entry_cell() -> &'static nirdosha_rt::prelude::SharedCell<Vec<WatchlistEntryRow>> {
    static CELL: std::sync::OnceLock<nirdosha_rt::prelude::SharedCell<Vec<WatchlistEntryRow>>> = std::sync::OnceLock::new();
    CELL.get_or_init(|| nirdosha_rt::prelude::SharedCell::new(Vec::new()))
