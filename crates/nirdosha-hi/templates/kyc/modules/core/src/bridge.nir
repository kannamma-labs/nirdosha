    TABLE.get_or_init(|| {
        nirdosha_guard_screens::GuardedTable::new(
            nirdosha_guard_mic::MemStoreDriver::new(),
            nirdosha_guard_registry::candidates(),
            nirdosha_guard_registry::dump().policies,
            "kyc-demo",
            std::env::temp_dir().join(format!("kyc-audit-verificationrun-{}.jsonl", std::process::id())),
            HUMAN_ROLES.iter().map(|r| r.to_string()).collect(),
            DEMO_TENANT,
            corpus_approval_chains(),
        )
    })
}

pub fn verification_run_store() -> &'static nirdosha_rt::prelude::SharedTable<i64, VerificationRunRow> {
    static STORE: std::sync::OnceLock<nirdosha_rt::prelude::SharedTable<i64, VerificationRunRow>> = std::sync::OnceLock::new();
    STORE.get_or_init(nirdosha_rt::prelude::SharedTable::new)
}

pub fn verification_run_cell() -> &'static nirdosha_rt::prelude::SharedCell<Vec<VerificationRunRow>> {
    static CELL: std::sync::OnceLock<nirdosha_rt::prelude::SharedCell<Vec<VerificationRunRow>>> = std::sync::OnceLock::new();
    CELL.get_or_init(|| nirdosha_rt::prelude::SharedCell::new(Vec::new()))
}

#[derive(Debug, Clone, Default, serde::Serialize, serde::Deserialize)]
pub struct WatchlistEntryRow {
    pub id: i64,
    pub entry_id: String,
    pub tenant_id: String,
    pub list_name: String,
    pub subject_name: String,
    pub reason: String,
    pub source_ref: String,
}

impl nirdosha_guard_screens::GuardedEntity for WatchlistEntryRow {
    const RESOURCE: &'static str = "watchlistentry";
    fn row_id(&self) -> String {
        self.entry_id.clone()
    }
}

pub fn watchlist_table() -> &'static nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, WatchlistEntryRow> {
    static TABLE: std::sync::OnceLock<nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, WatchlistEntryRow>> = std::sync::OnceLock::new();
    TABLE.get_or_init(|| {
        nirdosha_guard_screens::GuardedTable::new(
            nirdosha_guard_mic::MemStoreDriver::new(),
            nirdosha_guard_registry::candidates(),
            nirdosha_guard_registry::dump().policies,
            "kyc-demo",
            std::env::temp_dir().join(format!("kyc-audit-watchlistentry-{}.jsonl", std::process::id())),
            HUMAN_ROLES.iter().map(|r| r.to_string()).collect(),
            DEMO_TENANT,
            corpus_approval_chains(),
        )
    })
}

pub fn watchlist_entry_store() -> &'static nirdosha_rt::prelude::SharedTable<i64, WatchlistEntryRow> {
    static STORE: std::sync::OnceLock<nirdosha_rt::prelude::SharedTable<i64, WatchlistEntryRow>> = std::sync::OnceLock::new();
    STORE.get_or_init(nirdosha_rt::prelude::SharedTable::new)
