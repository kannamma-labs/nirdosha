//! Generated by `cargo nirdosha generate-screens` from kyc's screens.toml.
//! Entities, `GuardedEntity` impls, `GuardedTable` constructors, managed stores,
//! `roles!`, and one real `guard_policy!` per (guarded screen, allowed action) —
//! synthesized from each guarded screen's own `policy` block. Do not edit by
//! hand; edit screens.toml and regenerate.

nirdosha_rt::roles! {
    KycAnalyst = "kyc_analyst";
    KycSeniorAnalyst = "kyc_senior_analyst";
    KycMlro = "kyc_mlro";
    ComplianceOfficer = "compliance_officer";
    RelationshipManager = "relationship_manager";
    Auditor = "auditor";
    PlatformAdmin = "platform_admin";
    Customer = "customer";
}

// ---- approval chains ----

nirdosha_rt::approval_chain! {
    chain document_review { quorum(1, of = [KycAnalyst, KycSeniorAnalyst]); timeout(deny);  } }

nirdosha_rt::approval_chain! {
    chain screening_hit_review { quorum(2, of = [KycSeniorAnalyst, KycMlro]); timeout(deny);  } }

nirdosha_rt::approval_chain! {
    chain case_review { quorum(1, of = [KycAnalyst, KycSeniorAnalyst]); timeout(deny);  } }

nirdosha_rt::approval_chain! {
    chain case_escalation { quorum(1, of = [KycMlro]); timeout(deny);  } }

pub fn corpus_approval_chains() -> Vec<nirdosha_guard_core::approval_chain::ApprovalChainDefinition> {
    nirdosha_guard_registry::dump()
        .approval_chains
        .iter()
        .map(|c| nirdosha_guard_core::approval_chain::ApprovalChainDefinition { name: c.name.clone(), quorum: c.quorum, approver_roles: c.approvers.to_vec(), cooling_period_ms: c.cooling_ms })
        .collect()
}

// ---- guard policies, synthesized from each guarded screen's policy block ----

nirdosha_rt::guard_policy! {
    allow "kyc-1-3-read" for kyc_analyst, kyc_senior_analyst, kyc_mlro, compliance_officer, relationship_manager, auditor, platform_admin
    when action == "read" && resource == "kyccase"
    purpose(view_kyc_dashboard)
    filter tenant_scope()
    field_policy { allowed(case_id, status, risk_rating) }
    cap(row_cap = 200, max_scan_rows = 20_000)
    obligate audit(sampled)
}

