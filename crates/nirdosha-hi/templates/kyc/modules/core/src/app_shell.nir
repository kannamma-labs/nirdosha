//! Generated app shell + landing (menus.toml, read at compile time) + login.

nirdosha_rt::app_shell_from_toml!(
    "menus.toml",
    title: "Nirdosha KYC",
);

nirdosha_rt::login! {
    mount: mount_login,
    path: "/login",
    mode: demo,
    demo_users: [
        { username: "alice", password: "pass123", roles: ["Customer"] },
        { username: "bob", password: "pass123", roles: ["Customer", "LoanOfficer"] },
        { username: "carol", password: "pass123", roles: ["BranchManager"] },
        { username: "dave", password: "pass123", roles: ["TreasuryHead"] },
        { username: "eve", password: "pass123", roles: ["ComplianceOfficer"] },
    ],
    landing: landing_path,
}

