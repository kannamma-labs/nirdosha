# Mechanically generated by `nirdosha::grammar_gen` -- run the real,
# current parser over crates/compiler's example corpus and trace which
# productions actually fired (see grammar_gen.rs's own doc comment for
# exactly what "mechanical" means and what it doesn't cover). Do not
# hand-edit -- regenerate instead (`nirdosha grammar-export`).

action_block ::= "{" action_call "}"
action_call ::= call
action_decl ::= str-lit "->" ident
    | str-lit "->" ident "{" (kv_entry)* "}"
additive ::= multiplicative "+" multiplicative
    | multiplicative "-" multiplicative
    | multiplicative "-" multiplicative "+" multiplicative
    | (multiplicative "+")* multiplicative
assignment ::= logic_or
    | logic_or "=" assignment
audited_stmt ::= "audited" str-lit block
block ::= "{" (stmt)* "}"
call ::= postfix
    | postfix "(" ")"
    | postfix "(" expr "," expr ")"
    | postfix "(" (expr ",")* expr ")"
comparison ::= additive
    | additive "<" additive
    | additive "<=" additive
    | additive ">" additive
    | additive ">=" additive
dashboard_decl ::= "dashboard" "{" ident str-lit "->" ident "}"
    | "dashboard" "{" (ident str-lit "->" ident)* "}"
    | "dashboard" "{" (ident str-lit "->" ident "{" kv_entry "}")* "}"
effect_annotation ::= ε
    | "effect" "(" (ident ",")* ident ")"
enum_decl ::= "enum" ident type_param_list "{" ident "(" type-name ")" "," ident "(" type-name "," type-name ")" "," "}"
    | "enum" ident type_param_list "{" ident "(" type-name ")" "," ident "(" type-name "," type-name ")" "," ident "," "}"
    | "enum" ident type_param_list "{" ident "(" type-name ")" ("," ident)* "," "}"
    | "enum" ident type_param_list "{" ident "," "}"
    | "enum" ident type_param_list "{" ident "}"
    | "enum" ident type_param_list "{" (ident "(" type-name ")" ",")* "}"
    | "enum" ident type_param_list "{" (ident "(" qualified_name ")" ",")* "}"
    | "enum" ident type_param_list "{" (ident ",")* "}"
    | "enum" ident type_param_list "{" (ident ",")* ident "(" type-name ")" "," "}"
equality ::= comparison
    | comparison "!=" comparison
    | comparison "==" comparison
expr ::= assignment
    | if_expr
    | match_expr
    | transact_expr
field_mask_requires ::= ε
    | "requires" "(" ident ":" str-lit ")"
field_override ::= ident "{" (kv_entry)* "}"
fn_decl ::= "fn" ident "(" ")" "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ")" "->" qualified_name "(" type-name "," qualified_name ")" effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ")" "->" qualified_name "(" qualified_name "," qualified_name ")" effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ")" "->" qualified_name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ")" effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" "&" type-name ")" "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" "&" qualified_name ")" "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" "Vector" "(" type-name "," int-lit ")" "," ident ":" type-name ")" "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" "box" type-name ")" "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" "box" qualified_name ")" "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" "chan" "box" type-name ")" "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" "chan" type-name ")" "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" "chan" type-name "," ident ":" type-name ")" "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" "fn" "(" type-name ")" "->" type-name "," ident ":" "fn" "(" type-name ")" "->" type-name "," ident ":" type-name ")" "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" "fn" "(" type-name ")" "->" type-name "," ident ":" type-name ")" "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" "froze" type-name ")" "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" type-name ")" "->" "box" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" type-name "," ident ":" type-name ")" "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" type-name "," ident ":" type-name ")" "->" qualified_name "(" type-name "," qualified_name ")" effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" type-name "," ident ":" qualified_name ")" "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" type-name "," ident ":" qualified_name ")" "->" qualified_name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" type-name "," ident ":" qualified_name "," ident ":" type-name ")" "->" qualified_name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" type-name "," ident ":" qualified_name ("," ident ":" type-name)* ")" "->" qualified_name "(" type-name "," qualified_name ")" effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" qualified_name "(" type-name ")" "," ident ":" type-name ")" "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" qualified_name "(" type-name "," type-name (")")* "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" qualified_name "(" type-name "," type-name (")")* "->" qualified_name "(" type-name "," type-name ")" effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" qualified_name "(" type-name (")")* "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" qualified_name ")" "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" qualified_name ")" "->" qualified_name "(" qualified_name "," qualified_name ")" effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" qualified_name "," ident ":" type-name ")" "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" qualified_name "," ident ":" type-name "," ident ":" qualified_name ")" "->" qualified_name "(" type-name "," qualified_name ")" effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" qualified_name "," ident ":" type-name "," ident ":" qualified_name "," ident ":" type-name ")" "->" qualified_name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" qualified_name "," ident ":" qualified_name ")" "->" qualified_name "(" qualified_name "," qualified_name ")" effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" ident ":" qualified_name ("," ident ":" type-name)* ")" "->" qualified_name "(" type-name "," qualified_name ")" effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" (ident ":" type-name ",")* ident ":" type-name ")" "->" type-name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" (ident ":" type-name ",")* ident ":" type-name ")" "->" qualified_name "(" type-name "," qualified_name ")" effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" (ident ":" type-name ",")* ident ":" type-name ")" "->" qualified_name "(" qualified_name "," qualified_name ")" effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" (ident ":" type-name ",")* ident ":" qualified_name "," ident ":" type-name ")" "->" qualified_name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" (ident ":" qualified_name ",")* ident ":" type-name ")" "->" qualified_name effect_annotation requires_annotation nfr_annotation block
    | "fn" ident "(" (ident ":" qualified_name ",")* ident ":" qualified_name ")" "->" qualified_name effect_annotation requires_annotation nfr_annotation block
if_expr ::= "if" expr block
    | "if" expr block "else" block
    | "if" expr block "else" if_expr
kv_entry ::= ident ":" expr
landing_decl ::= "landing" "{" (ident "(" str-lit ")" "->" ident)* ident "->" ident "}"
layout_container_body ::= "{" (layout_node)* "}"
layout_decl ::= "{" layout_node "}"
layout_node ::= ident "{" kv_entry "}"
    | ident "{" (ident str-lit "{" layout_node "}")* "}"
    | ident str-lit
    | ident str-lit layout_container_body
    | ident layout_container_body
    | (ident)*
let_stmt ::= "let" ident ":" "&" type-name "=" expr
    | "let" ident ":" "Matrix" "(" type-name ("," int-lit)* ")" "=" expr
    | "let" ident ":" "Vector" "(" type-name "," int-lit ")" "=" expr
    | "let" ident ":" "box" type-name "=" expr
    | "let" ident ":" "box" qualified_name "=" expr
    | "let" ident ":" "chan" "box" type-name "=" expr
    | "let" ident ":" "chan" type-name "=" expr
    | "let" ident ":" "fn" "(" type-name ")" "->" type-name "=" expr
    | "let" ident ":" "froze" type-name "=" expr
    | "let" ident ":" "sandbox" "=" expr
    | "let" ident ":" "thread" type-name "=" expr
    | "let" ident ":" "thread" qualified_name "=" expr
    | "let" ident ":" type-name "=" expr
    | "let" ident ":" qualified_name "(" type-name ")" "=" expr
    | "let" ident ":" qualified_name "(" type-name "," type-name ")" "=" expr
    | "let" ident ":" qualified_name "(" type-name "," qualified_name ")" "=" expr
    | "let" ident ":" qualified_name "(" qualified_name "," qualified_name ")" "=" expr
    | "let" ident ":" qualified_name "=" expr
    | "let" ident ":" (qualified_name "(")* type-name ")" "," qualified_name ")" "=" expr
logic_and ::= equality "&&" equality
    | (equality "&&")* equality
logic_or ::= logic_and
    | logic_and "||" logic_and
match_expr ::= "match" expr "{" qualified_name "(" ident ")" "=>" expr "," qualified_name "(" ident "," ident ")" "=>" expr "," "}"
    | "match" expr "{" qualified_name "(" ident ")" "=>" expr "," qualified_name "(" ident "," ident ")" "=>" expr "," qualified_name "(" ")" "=>" expr "," "}"
    | "match" expr "{" qualified_name "(" ident ")" "=>" expr "," qualified_name "=>" expr "," "}"
    | "match" expr "{" (int-lit "=>" expr ",")* ident "=>" expr "," "}"
    | "match" expr "{" (qualified_name "(" ")" "=>" expr ",")* "}"
    | "match" expr "{" (qualified_name "(" ident ")" "=>" expr ",")* "}"
    | "match" expr "{" (qualified_name "=>" expr ",")* qualified_name "(" ident ")" "=>" expr "," "}"
module_decl ::= "module" str-lit "{" struct_decl (fn_decl)* "}"
    | "module" namespace_module_decl
multiplicative ::= unary "*" unary
    | unary ".*" unary
    | unary "./" unary
    | unary "/" unary
    | (unary "*")* unary
namespace_module_decl ::= ident "{" "pub" (struct_decl)* "pub" fn_decl "}"
nfr_annotation ::= ε
    | "nfr" "(" ident ":" float-lit ")"
    | "nfr" "(" ident ":" int-lit "," ident ":" float-lit ")"
    | "nfr" "(" ident ":" int-lit "," ident ":" int-lit ")"
optional_int_modifier ::= ε
    | ident int-lit
optional_transact_slot ::= ε
    | transact_slot
panel_decl ::= str-lit "{" kv_entry "}"
    | str-lit "{" kv_entry ident action_decl "}"
postfix ::= primary
    | primary "." ident
    | primary "[" expr "]"
primary ::= "(" expr ")"
    | "[" expr "," expr "]"
    | "[" (expr ",")* expr "]"
    | "false"
    | "true"
    | float-lit
    | int-lit
    | str-lit
    | qualified_name
program ::= "use" str-lit struct_decl (fn_decl)* workflow_decl (fn_decl)* struct_decl enum_decl (fn_decl)* screen_decl dashboard_decl fn_decl
    | "use" str-lit (module_decl)* fn_decl
    | enum_decl struct_decl (fn_decl)*
    | enum_decl struct_decl (fn_decl)* screen_decl fn_decl
    | enum_decl struct_decl (fn_decl)* workspace_decl fn_decl
    | enum_decl (fn_decl)*
    | enum_decl (fn_decl)* dashboard_decl fn_decl
    | fn_decl enum_decl (fn_decl)*
    | fn_decl struct_decl (fn_decl)*
    | fn_decl workflow_decl (fn_decl)*
    | module_decl
    | module_decl enum_decl module_decl fn_decl
    | module_decl struct_decl enum_decl (struct_decl)* fn_decl struct_decl enum_decl (fn_decl)* validate_decl struct_decl (fn_decl)* screen_decl (fn_decl)* screen_decl dashboard_decl (fn_decl)* workflow_decl (fn_decl)*
    | struct_decl enum_decl (fn_decl)*
    | struct_decl fn_decl enum_decl (fn_decl)*
    | struct_decl (fn_decl)*
    | struct_decl (fn_decl)* screen_decl serve_config_decl fn_decl
    | struct_decl (fn_decl)* validate_decl (fn_decl)*
    | (fn_decl)*
    | (fn_decl)* struct_decl (fn_decl)*
    | (fn_decl)* workflow_decl (fn_decl)*
    | (struct_decl)* enum_decl fn_decl struct_decl enum_decl (fn_decl)*
    | (struct_decl)* fn_decl
    | (struct_decl)* fn_decl validate_decl (fn_decl)*
    | (struct_decl)* (fn_decl)*
    | (struct_decl)* (fn_decl)* workflow_decl fn_decl (screen_decl)* dashboard_decl landing_decl serve_config_decl (fn_decl)*
    | (struct_decl)* (fn_decl)* workflow_decl (fn_decl)*
    | (fn_decl validate_decl)* fn_decl
qualified_name ::= ident
    | ident "::" ident
requires_annotation ::= ε
    | "requires" "(" ident ")"
    | "requires" "(" ident ":" str-lit ")"
    | "requires" "(" ident ":" str-lit "," str-lit ")"
return_stmt ::= "return"
    | "return" expr
screen_decl ::= "screen" ident "{" ident action_decl ident layout_decl "}"
    | "screen" ident "{" kv_entry ident field_override "}"
    | "screen" ident "{" kv_entry ident field_override ident action_decl "}"
    | "screen" ident "{" kv_entry (ident field_override)* "}"
    | "screen" ident "{" kv_entry (ident field_override)* ident action_decl "}"
    | "screen" ident "{" (kv_entry)* ident "{" (kv_entry)* ("}")*
serve_config_decl ::= "serve" "{" (ident)* "}"
    | "serve" "{" (ident)* ("," ident)* "}"
state_decl ::= "state" ident "{" ident action_block transition "}"
    | "state" ident "{" kv_entry ident action_block (transition)* "}"
    | "state" ident "{" kv_entry (transition)* "}"
    | "state" ident "{" (transition)* "}"
    | "state" ident "{" (ident action_block)* (transition)* "}"
    | "state" (ident)* "{" "}"
    | "state" (ident)* "{" ident action_block "}"
stmt ::= audited_stmt
    | expr
    | let_stmt
    | return_stmt
    | while_stmt
struct_decl ::= "struct" ident type_param_list "{" ident ":" type-name field_mask_requires "," "}"
    | "struct" ident type_param_list "{" ident ":" type-name field_mask_requires "," ident ":" qualified_name field_mask_requires "," "}"
    | "struct" ident type_param_list "{" (ident ":" type-name field_mask_requires ",")* "}"
    | "struct" ident type_param_list "{" (ident ":" qualified_name field_mask_requires ",")* "}"
transact_expr ::= "transact" "{" optional_transact_slot transact_slot (optional_int_modifier)* (transact_slot)* (optional_transact_slot)* "}"
transact_slot ::= ident ":" call
transition ::= (ident)* "->" ident
type_param_list ::= ε
    | "(" ident ")"
    | "(" ident "," ident ")"
unary ::= unary_inner
unary_inner ::= "!" unary
    | "&" unary
    | "*" unary
    | "-" unary
    | "accept" "(" expr ")"
    | "acquire" call
    | "box" unary
    | "chan"
    | "connect" "(" expr "," expr ")"
    | "froze" unary
    | "join" unary
    | "listen" "(" expr ")"
    | "open" "(" expr "," expr ")"
    | "recv" "(" expr ")"
    | "sandbox" call
    | "send" "(" expr "," expr ")"
    | "spawn" call
    | "stop" unary
    | call
validate_decl ::= "validate" ident "{" (kv_entry)* "}"
while_stmt ::= "while" expr block
workflow_data_block ::= ident "{" "}"
    | ident "{" ident ":" type-name "," "}"
workflow_decl ::= "workflow" ident "{" workflow_data_block (state_decl)* "}"
    | "workflow" ident "{" (state_decl)* "}"
workspace_decl ::= "workspace" ident "{" (kv_entry)* (ident panel_decl)* "}"

int-lit    ::= [0-9]+
float-lit  ::= [0-9]+ "." [0-9]+
str-lit    ::= "\"" str-char* "\""
str-char   ::= [^"\\] | "\\" ["\\ntr]
ident      ::= [a-zA-Z_] [a-zA-Z0-9_]*
type-name  ::= "i8" | "i16" | "i32" | "i64" | "u8" | "u16" | "u32" | "u64" | "usize" | "f64" | "dec128" | "bool" | "unit" | "str" | "tcp" | "tcp_listener" | "file" | "json" | "db" | "mq"
