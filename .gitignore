# Generated bundles (kept locally only)
/all_examples.md

# `nirdosha_guard_registry::write_dump_from_env`'s default output path —
# written by any dialect crate's `nirdosha_guard_dump` test (see that
# function's doc comment) when NIRDOSHA_GUARD_DUMP_PATH isn't set, e.g.
# running `cargo test nirdosha_guard_dump` directly rather than through
# `cargo nirdosha verify --guard` (which always sets it to a target/ path).
nirdosha-registry.json
/nir_files.zip

# Runtime database artifacts
*.db
*.db.lock

# `transact`'s durability log (kernel::transact's default
# NIRDOSHA_TRANSACT_LOG_PATH, cwd-relative) — a compiled binary's own
# runtime output, not source. Left behind by running any compiled `.nir`
# program with a live `transact` block from the repo root or a crate
# directory without overriding the env var.
nirdosha_transact_log.sqlite*

# Flight recorder dump — a compiled `.nir` binary's own runtime output
# (kernel::recorder's default NIRDOSHA_KERNEL_RECORDER_PATH), not source
*flight_recorder*.log.gz

# Claude Code local session/state (never commit)
/.claude

# Locally-run compiled binaries (e.g. the Ops Console server kept
# running for a live browser demo) -- build artifacts, not source
/.local-bin

# `hi`'s per-project scratch state -- auto-scaffolded by `hi_graph::open`/
# `hi_plugin::ensure_default_packs` on first run (hi.db, the confirmed-
# unit graph; plugins/, an installed copy of each domain pack) and
# regenerated freely. Local runtime state, not source.
/.nir/

# Launch marketing drafts (not project documentation)
/announcements
scratch/

migrations/*.sql
.playwright-cli/

crates/nirdosha-hi/.nir/
