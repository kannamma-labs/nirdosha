//! M3 Alert Management / L1 Triage (`screen.md` module 3, 10 screens).
//! Policies: `50_alerts.nir`. RTM live-demo plan Phase B.
//!
//! Real, guard-enforced: 3.1 queue + 3.2 detail (`crud_screens!`, list +
//! detail-by-id, `analyst-search-transaction`'s M6 sibling shape —
//! here `analyst-read-alert`), 3.3 disposition (the same screen's
//! `update_fields`, `analyst-disposition-alert`'s real `field_policy` +
//! `requires field(status).transition_allowed() && invariant
//! (rationale_present)` — both checked for real, see `bridge.nir`'s
//! `AlertRow`), a status-column board covering 3.1's kanban view
//! (`kanban_board!`, same `guard:` bridge), and 3.5 bulk reassignment
//! (`lead-bulk-alert`, hand-written: `crud_screens!`/`kanban_board!`
//! have no "act on N selected rows" archetype, so this is a real
//! `POST` handler looping `GuardedTable::guarded_update` per id, each
//! iteration independently policy-checked — not a single bulk grant
//! rubber-stamped once).
//!
//! Also real, guard-enforced (C1, screens-plan.md): 3.7 Pending Info/RFI
//! — list + create over `PG.case_task` (`case-task-read`/`case-task-
//! create`), scoped to this alert.
//!
//! Not built this pass (`screen-field-mappings.md`'s own validation-UX
//! detail — checklists, attestation modals, min/max text lengths — is a
//! frontend concern the `guard_policy!` corpus doesn't encode at all,
//! and building it wouldn't prove anything about guard enforcement):
//! 3.4 related/merge, 3.6 reassignment (single-row shortcut of 3.5, not
//! separately wired), 3.8 escalation form (3.8's real
//! substance — creating a case draft — is M4's `analyst-create-case`,
//! reachable from the case screens instead), 3.9 SLA monitor
//! (`lead-sla-aggregate` — an `aggregate` action, same shape M2's
//! dashboards use `guarded_aggregate` for; left to M2's own
//! `ComplianceLead` dashboard rather than duplicated here), 3.10 audit
//! history (no dedicated audit-trail read policy for alerts in this
//! corpus — `GuardClient`'s own JSONL audit log is real but has no
//! screen anywhere yet).

use crate::bridge::alert_table;
use crate::bridge::AlertRow;
use nirdosha_rt::prelude::SharedTable;

fn unused_alert_store() -> &'static SharedTable<i64, AlertRow> {
    static STORE: std::sync::OnceLock<SharedTable<i64, AlertRow>> = std::sync::OnceLock::new();
    STORE.get_or_init(SharedTable::new)
}

nirdosha_rt::crud_screens! {
    mount: mount_alert_screens,
    entity: AlertRow,
    store: unused_alert_store,
    path: "/alerts",
    fields: [
        alert_id: String,
        tenant_id: String,
        txn_id: String,
        score: f64,
        model_version: String,
        policy_version: String,
        status: String,
        assignee: String,
        disposition_code: String,
        rationale: String,
        case_id: String,
    ],
    create: public,
    read: public,
    update: public,
    delete: public,
    guard: {
        table: alert_table,
        purpose: "AmlInvestigation",
        update_fields: [
            status: String,
            assignee: String,
            disposition_code: String,
            rationale: String,
            case_id: String,
        ],
    },
}

nirdosha_rt::kanban_board! {
    mount: mount_alert_board,
    entity: AlertRow,
    store: unused_alert_store,
    path: "/alerts/board",
    access: public,
    title_field: alert_id,
    column_field: status,
    columns: ["new", "in_progress", "pending_info", "escalated", "closed_false_positive"],
    move_path: "/alerts/{id}/board-move/{to}",
    guard: {
        table: alert_table,
        purpose: "AmlInvestigation",
    },
}

/// 3.5 Bulk Actions — `lead-bulk-alert` (`ComplianceLead`, `purpose
/// (Operations)`, `field_policy { allowed(assignee, severity, tags)
/// forbidden(everything_else) }`, `cap(affected_rows = 100)`). Hand-
/// written: no archetype macro has a "many rows, one submitted form"
/// shape. Each id gets its own independent `guarded_update` call — one
/// bad row fails that row only, matching the corpus's own per-record
/// audit posture (`obligate audit(full)` is per-write, not per-batch).
///
/// Also exposes an HTML bulk-actions page at `/alerts/bulk` so the menu
/// entry for 3.5 resolves to a real GET-rendered screen, not only a JSON
/// endpoint.
pub fn mount_bulk_alert_reassign(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    use std::collections::HashSet;
    router
        .get_with_auth("/alerts/bulk", "Bulk alert actions", |_req, _params, _auth| {
            let body = r#"<!doctype html>
<html>
<head><title>Bulk Alert Reassign</title></head>
<body style="font-family:system-ui,sans-serif;max-width:60rem;margin:2rem auto">
<h1>Bulk alert reassign</h1>
<form method="post" action="/alerts/bulk-reassign">
<p>
<label>Alert IDs (comma-separated):<br>
<textarea name="ids" rows="4" cols="60" placeholder="A-1001, A-1002"></textarea>
</label>
</p>
<p>
<label>New assignee:<br>
<input name="assignee" type="text" />
</label>
</p>
<p><button type="submit">Reassign</button></p>
</form>
</body>
</html>"#;
            nirdosha_rt::Response::html(200, body)
        })
        .post_with_auth("/alerts/bulk-reassign", "Bulk reassign", |req, _params, auth| {
            let form = req.form_or_json();
        let Some(ids_raw) = form.get("ids") else { return nirdosha_rt::Response::bad_request("ids required (comma-separated alert_id list)") };
        let Some(new_assignee) = form.get("assignee") else { return nirdosha_rt::Response::bad_request("assignee required") };
        let ids: Vec<&str> = ids_raw.split(',').map(str::trim).filter(|s| !s.is_empty()).collect();
        if ids.len() > 100 {
            return nirdosha_rt::Response::bad_request("cap(affected_rows = 100): at most 100 ids per bulk call");
        }
        let mut results: Vec<serde_json::Value> = Vec::new();
        let changed: HashSet<String> = ["assignee".into()].into();
        for id in ids {
            let assignee = new_assignee.clone();
            let outcome = alert_table().guarded_update(auth, "Operations", id, &changed, move |row| row.assignee = assignee);
            let entry = match outcome {
                Ok(_) => serde_json::json!({ "id": id, "ok": true }),
                Err(e) => serde_json::json!({ "id": id, "ok": false, "error": format!("{e:?}") }),
            };
            results.push(entry);
        }
            nirdosha_rt::Response::json(200, &serde_json::json!({ "results": results }))
        })
}

/// 3.8 Escalation to Case -- form to create a case draft from an alert.
/// The real policy work is `analyst-create-case` (M4); this is the M3
/// entry point that passes the alert_id as a query param to `/cases/new`.
/// 3.9 SLA & Aging Monitor -- guard-enforced aggregate dashboard over
/// `alert_table` joined with `sla_config_table` for SLA minutes and
/// auto-escalate flags. `AlertRow` has no `severity` field in the
/// corpus, so this demo uses `severity`/`tags` fields added to the
/// screen projection (`bridge.nir`) and falls back to the config's own
/// severity mapping.
pub fn mount_sla_monitor(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    router.get_with_auth("/alerts/sla", "SLA & Aging Monitor (3.9)", |_req, _params, auth| {
        let sla_rows = match crate::bridge::sla_config_table().guarded_snapshot(auth, "Operations") {
            Ok(rows) => rows,
            Err(e) => return nirdosha_guard_screens::guard_error_response(e),
        };
        let alerts = match alert_table().guarded_aggregate(auth, "Operations") {
            Ok(rows) => rows,
            Err(e) => return nirdosha_guard_screens::guard_error_response(e),
        };
        let _configs: std::collections::HashMap<String, i64> = sla_rows.iter().map(|r| (r.severity.clone(), r.sla_minutes)).collect();
        let mut buckets: std::collections::BTreeMap<String, i64> = std::collections::BTreeMap::new();
        buckets.insert("new".into(), 0);
        buckets.insert("in_progress".into(), 0);
        buckets.insert("pending_info".into(), 0);
        buckets.insert("escalated".into(), 0);
        buckets.insert("closed_false_positive".into(), 0);
        for a in &alerts {
            *buckets.entry(a.status.clone()).or_insert(0) += 1;
        }
        nirdosha_rt::Response::json(200, &serde_json::json!({
            "sla_configs": sla_rows,
            "aging_buckets": buckets,
            "total_alerts": alerts.len(),
        }))
    })
}

pub fn mount_escalate_to_case(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    router
        .get_with_auth("/alerts/{id}/escalate", "Escalate to Case (3.8)", |_req, params, _auth| {
            let Some(id) = params.get("id").map(|s| s.to_string()) else { return nirdosha_rt::Response::bad_request("id required") };
            let body = format!(
                r#"<!doctype html>
<html><head><title>Escalate alert {id}</title></head>
<body style="font-family:system-ui,sans-serif;max-width:60ch;margin:2rem auto">
<h1>Escalate alert {id} to a case</h1>
<form method="post" action="/alerts/{id}/escalate">
<p><label>Rationale:<br><textarea name="rationale" rows="4" cols="50"></textarea></label></p>
<p><button type="submit">Create case draft</button></p>
</form>
</body></html>"#
            );
            nirdosha_rt::Response::html(200, body)
        })
        .post_with_auth("/alerts/{id}/escalate", "Escalate to Case submit", |req, params, _auth| {
            let Some(id) = params.get("id").map(|s| s.to_string()) else { return nirdosha_rt::Response::bad_request("id required") };
            let values = req.form_or_json();
            let _rationale = values.get("rationale").cloned().unwrap_or_default();
            // This route only records the escalation intent; the actual
            // case creation is delegated to M4's `/cases/new?alert_id=`.
            nirdosha_rt::Response::json(200, &serde_json::json!({
                "status": "redirect",
                "next": format!("/cases/new?alert_id={id}")
            }))
        })
}

/// T-06/B11: 3.4 Related & Linked Alerts (`related_alerts_for_alert` —
/// same-case alerts, or same-customer-transaction siblings when the
/// alert has no case yet) and 3.10 Alert Audit History
/// (`entity_audit_timeline`, reusing T-11/B8's real `AC.all_chains`
/// projection under `purpose(Audit)` — `Auditor`/`Mlro`/`ComplianceLead`/
/// `Admin` only; `Analyst` has no grant on this resource, a pre-existing,
/// disclosed corpus gap, not invented around here).
pub fn mount_alert_context(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    router
        .get_with_auth("/alerts/{id}/related", "Related & Linked Alerts (3.4)", |_req, params, auth| {
            let Some(id) = params.get("id").map(|s| s.to_string()) else { return nirdosha_rt::Response::bad_request("id required") };
            match crate::bridge::related_alerts_for_alert(auth, &id) {
                Ok(rows) => nirdosha_rt::Response::json(200, &serde_json::json!(rows)),
                Err(reason) => nirdosha_rt::Response::html(422, format!("<p>{reason}</p>")),
            }
        })
        .get_with_auth("/alerts/{id}/audit", "Alert Audit History (3.10)", |_req, params, auth| {
            let Some(id) = params.get("id").map(|s| s.to_string()) else { return nirdosha_rt::Response::bad_request("id required") };
            match crate::bridge::entity_audit_timeline(auth, "alert", &id) {
                Ok(rows) => nirdosha_rt::Response::json(200, &serde_json::json!(rows)),
                Err(reason) => nirdosha_rt::Response::html(422, format!("<p>{reason}</p>")),
            }
        })
}

/// C1 (screens-plan.md): 3.7 Pending Info/RFI — real guard-enforced list
/// + create over `PG.case_task` (`case-task-read`/`case-task-create`,
/// `00_core.nir`), scoped to this alert via `item_ref = "alert:<id>"`,
/// `task_type = "rfi"`. **Disclosed scope**: the screen's own SLA-clock-
/// pause semantics are `AlertStatus`'s already-real `pending_info` state
/// (`10_domains.nir`'s `machine AlertStatus`), set independently through
/// `mount_alert_screens`'s `update_fields` — this route only tracks the
/// RFI task record itself, not the clock.
pub fn mount_alert_rfi(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    use std::collections::HashSet;
    router
        .get_with_auth("/alerts/{id}/rfi", "Pending Info / RFI (3.7)", |_req, params, auth| {
            let Some(id) = params.get("id").map(|s| s.to_string()) else { return nirdosha_rt::Response::bad_request("id required") };
            let item_ref = format!("alert:{id}");
            match crate::bridge::case_task_table().guarded_snapshot(auth, "Operations") {
                Ok(rows) => {
                    let filtered: Vec<_> = rows.into_iter().filter(|r| r.item_ref == item_ref && r.task_type == "rfi").collect();
                    nirdosha_rt::Response::json(200, &serde_json::json!(filtered))
                }
                Err(e) => nirdosha_guard_screens::guard_error_response(e),
            }
        })
        .post_with_auth("/alerts/{id}/rfi", "Raise RFI (3.7)", |req, params, auth| {
            let Some(id) = params.get("id").map(|s| s.to_string()) else { return nirdosha_rt::Response::bad_request("id required") };
            let form = req.form_or_json();
            let Some(title) = form.get("title").cloned() else { return nirdosha_rt::Response::bad_request("title required") };
            let assignee = form.get("assignee").cloned().unwrap_or_else(|| auth.user().to_string());
            let due_date = form.get("due_date").cloned().unwrap_or_default();
            let priority = form.get("priority").cloned().unwrap_or_else(|| "normal".into());
            let detail = form.get("detail").cloned().unwrap_or_default();
            let task_id = format!("task-{}", ::std::time::SystemTime::now().duration_since(::std::time::UNIX_EPOCH).unwrap().as_millis());
            let submitted: HashSet<String> = ["item_ref".into(), "task_type".into(), "title".into(), "assignee".into(), "due_date".into(), "priority".into()].into();
            let entity = crate::bridge::CaseTaskRow {
                id: 0,
                task_id,
                tenant_id: crate::bridge::DEMO_TENANT.into(),
                item_ref: format!("alert:{id}"),
                task_type: "rfi".into(),
                title,
                detail,
                assignee,
                due_date,
                priority,
                status: "open".into(),
                blocked_reason: String::new(),
                completion_note: String::new(),
            };
            match crate::bridge::case_task_table().guarded_insert_checked(auth, "Operations", &submitted, entity) {
                Ok(row) => nirdosha_rt::Response::json(201, &serde_json::json!(row)),
                Err(e) => nirdosha_guard_screens::guard_error_response(e),
            }
        })
}
