//! M16 Notifications & Collaboration (`screen.md` module 16, 5 screens).
//! Policies: wherever `obligate notify(channel(...))` appears across the
//! corpus (`50_alerts.nir`'s `analyst-inbox`, `60_case_management.nir`'s
//! `case-inbox`, `95_qa.nir`'s `qa-inbox`, `65_sar.nir`'s
//! `regulatory-log`), plus `90_ops_admin.nir`'s `notification-read` so
//! the `menus.toml` V5 route-guard invariant resolves. RTM live-demo plan
//! Phase B batch 3.
//!
//! Notifications are still a pure obligation SIDE EFFECT of an
//! already-authorized action on a different resource. The read path now
//! goes through `GuardedTable::guarded_snapshot` under the real
//! `notification-read` policy (`90_ops_admin.nir`); the in-process
//! channel-to-role filter remains as defense-in-depth.
use crate::bridge::handover_table;
use crate::bridge::notification_table;
use crate::bridge::user_profile_table;
use nirdosha_rt::screens::FieldSpec;

/// 16.3 Shift Handover -- `handover-read` (real, `Analyst`,
/// `ComplianceLead`, `OpsAnalyst`; `90_ops_admin.nir`).
pub fn mount_shift_handover(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    router.get_with_auth("/handover", "Shift Handover (16.3)", |_req, _params, auth| {
        match handover_table().guarded_snapshot(auth, "Operations") {
            Ok(rows) => {
                let fields = [
                    FieldSpec { name: "handover_id", input_type: "text" },
                    FieldSpec { name: "from_user", input_type: "text" },
                    FieldSpec { name: "to_user", input_type: "text" },
                    FieldSpec { name: "summary", input_type: "text" },
                    FieldSpec { name: "acknowledged", input_type: "text" },
                ];
                let values: Vec<serde_json::Value> = rows.iter().map(|r| serde_json::to_value(r).unwrap()).collect();
                nirdosha_rt::Response::html(200, nirdosha_rt::screens::read_only_list_html("Shift Handover", &fields, &values))
            }
            Err(e) => nirdosha_guard_screens::guard_error_response(e),
        }
    })
}

/// Which human roles a given `obligate notify(channel(...))` channel is
/// meant for -- transcribed from each policy's own real subject +
/// obligation pairing (`alert-raise`'s `analyst-inbox` reaches the
/// `Analyst` who works the queue it feeds; `case-inbox` reaches both the
/// analyst who opened the case and the lead who may need to four-eyes it;
/// `qa-inbox` reaches the `QaReviewer` who owns the review queue;
/// `regulatory-log` is `sar-export`'s own obligation, reaching
/// compliance leadership). Not itself a `guard_policy!` -- a UI routing
/// table over data this table's own writes already exist independent of
/// who's allowed to look at them here.
fn roles_for_channel(channel: &str) -> &'static [&'static str] {
    match channel {
        "analyst-inbox" => &["Analyst"],
        "case-inbox" => &["Analyst", "ComplianceLead"],
        "qa-inbox" => &["QaReviewer"],
        "regulatory-log" => &["ComplianceLead", "Mlro"],
        _ => &[],
    }
}

pub fn mount_notification_feed(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    router.get_with_auth("/notifications", "Notifications", |_req, _params, auth| {
        let rows = match notification_table().guarded_snapshot(auth, "Operations") {
            Ok(rows) => rows,
            Err(e) => return nirdosha_guard_screens::guard_error_response(e),
        };
        let visible: Vec<_> = rows
            .into_iter()
            .filter(|row| roles_for_channel(&row.channel).iter().any(|role| auth.has_role(role)))
            .collect();
        nirdosha_rt::Response::json(200, &serde_json::json!(visible))
    })
}

/// C1 (screens-plan.md): 16.4 My Tasks -- real guard-enforced,
/// cross-entity `PG.case_task` list (`case-task-read`, `00_core.nir`),
/// the same shape `mount_notification_feed` gives 16.1. **Disclosed
/// gap**: menus.toml's own badge filter ("assignee=me AND due<=today")
/// is not implemented -- this route returns every row the requester's
/// `case-task-read` grant can see (tenant-scoped, not self-scoped); no
/// screen or badge anywhere in this corpus computes a live count yet
/// (the same gap B6 already disclosed for every other `badge = {...}`
/// declaration in menus.toml).
pub fn mount_my_tasks(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    router
        .get_with_auth("/tasks", "My Tasks (16.4)", |_req, _params, auth| {
            match crate::bridge::case_task_table().guarded_snapshot(auth, "Operations") {
                Ok(rows) => nirdosha_rt::Response::json(200, &serde_json::json!(rows)),
                Err(e) => nirdosha_guard_screens::guard_error_response(e),
            }
        })
        .get_with_auth("/preferences/notifications", "Notification Preferences (16.5)", |_req, _params, auth| {
            let user_id = auth.user().to_string();
            match user_profile_table().guarded_get(auth, "Operations", &user_id) {
                Ok(Some(row)) => nirdosha_rt::Response::json(200, &serde_json::json!({
                    "digest": row.digest,
                    "quiet_hours": row.quiet_hours,
                })),
                Ok(None) => nirdosha_rt::Response::json(200, &serde_json::json!({ "digest": true, "quiet_hours": "" })),
                Err(e) => nirdosha_guard_screens::guard_error_response(e),
            }
        })
}
