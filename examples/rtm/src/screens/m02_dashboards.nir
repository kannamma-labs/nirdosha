//! M2 Dashboards & Landing (`screen.md` module 2, 7 screens) + the
//! app-wide shell/landing every other module depends on. RTM live-demo
//! plan Phase B.
//!
//! The navigation shell and post-login landing rules are now generated
//! from `menus.toml` via `app_shell_from_toml!`, so the nav/landing stay
//! in sync with the 152-screen inventory as screens move through
//! `built` / `emittable` / `interim` / `blocked` stages.
//!
//! Real, guard-enforced: 2.1 Global Navigation Shell, landing, 2.2 L1
//! dashboard, 2.3 Team Dashboard — same grounded details as before.
//!
//! **Real, disclosed corpus gaps** remain listed for 2.4–2.7.

use crate::bridge::alert_table;
use crate::bridge::payment_table;
use nirdosha_rt::prelude::SharedTable;

fn unused_wall_store() -> &'static SharedTable<i64, crate::bridge::PaymentRow> {
    static STORE: std::sync::OnceLock<SharedTable<i64, crate::bridge::PaymentRow>> = std::sync::OnceLock::new();
    STORE.get_or_init(SharedTable::new)
}

fn my_pending_alerts(auth: &nirdosha_rt::Auth) -> i64 {
    match alert_table().guarded_snapshot(auth, "AmlInvestigation") {
        Ok(rows) => rows.iter().filter(|r| r.status == "new" || r.status == "in_progress").count() as i64,
        Err(_) => 0,
    }
}

fn my_alerts_by_status(auth: &nirdosha_rt::Auth) -> String {
    let counts = match alert_table().guarded_snapshot(auth, "AmlInvestigation") {
        Ok(rows) => rows,
        Err(_) => return "[]".to_string(),
    };
    let mut by_status: std::collections::BTreeMap<String, i64> = std::collections::BTreeMap::new();
    for row in &counts {
        *by_status.entry(row.status.clone()).or_insert(0) += 1;
    }
    serde_json::to_string(&by_status.into_iter().map(|(k, v)| serde_json::json!({ "label": k, "value": v })).collect::<Vec<_>>()).unwrap_or_else(|_| "[]".into())
}

fn team_alert_volume(auth: &nirdosha_rt::Auth) -> i64 {
    match alert_table().guarded_aggregate(auth, "Operations") {
        Ok(rows) => rows.len() as i64,
        Err(_) => 0,
    }
}

fn team_alerts_by_status(auth: &nirdosha_rt::Auth) -> String {
    let rows = match alert_table().guarded_aggregate(auth, "Operations") {
        Ok(rows) => rows,
        Err(_) => return "[]".to_string(),
    };
    let mut by_status: std::collections::BTreeMap<String, i64> = std::collections::BTreeMap::new();
    for row in &rows {
        *by_status.entry(row.status.clone()).or_insert(0) += 1;
    }
    serde_json::to_string(&by_status.into_iter().map(|(k, v)| serde_json::json!({ "label": k, "value": v })).collect::<Vec<_>>()).unwrap_or_else(|_| "[]".into())
}

nirdosha_rt::dashboard! {
    mount: mount_l1_dashboard,
    path: "/dashboard/my-day",
    title: "My Day",
    refresh_seconds: 60,
    widgets {
        Metric { label: "My pending alerts", fn: my_pending_alerts, guarded: true },
        Chart  { label: "My alerts by status", fn: my_alerts_by_status, mark: bar, guarded: true },
    }
}

nirdosha_rt::dashboard! {
    mount: mount_team_dashboard,
    path: "/dashboard/team",
    title: "Team Dashboard",
    refresh_seconds: 60,
    widgets {
        Metric { label: "Team alert volume", fn: team_alert_volume, guarded: true },
        Chart  { label: "Team alerts by status", fn: team_alerts_by_status, mark: bar, guarded: true },
    }
}

// → 2.5 Real-Time Monitoring Wall [T-09]. Real, guard-enforced
// (`ops-read-holds`, `OpsAnalyst`, `FraudMonitoring`) over the SAME
// `payment_table()` M11 writes -- one real data plane, not a second
// fork. `refresh_seconds` is a real `<meta http-equiv="refresh">` poll
// (`crud_screens!` gained this combo this ticket -- it previously only
// existed on `dashboard!`/`communication_feed!`, a disclosed governance
// hole D1 named); `sort_by`/`countdown_field` make the queue genuinely
// sorted-by-time-remaining with a live "Xm Ys remaining" column, not a
// decorative table. **Disclosed gap, not built this pass**: the
// screen's OTHER named dataset, `K.guard.decisions` -- a live decision
// ticker/audit-stream -- has no real topic consumer or queryable
// projection anywhere in this corpus yet (the closest real thing,
// `GuardClient`'s own JSONL audit log, is file-backed and unqueried by
// any screen; see `m03_alerts.nir`'s 3.10 doc comment for the same,
// already-disclosed gap). That half stays exactly what its own note
// already called it: "true ticker = realtime archetype later" -- this
// ticket closes the `refresh_seconds` poll mechanism it was always
// meant to sit behind, not the ticker itself. ComplianceLead (also in
// this screen's `roles`) has no plain `read payment` grant in this
// corpus (only `hold-stats`'s `aggregate`) -- a real, disclosed denial,
// same posture `m05_customer.nir`'s Analyst-denied-on-customer already
// established, not routed around by inventing a grant.
nirdosha_rt::crud_screens! {
    mount: mount_monitoring_wall,
    entity: crate::bridge::PaymentRow,
    store: unused_wall_store,
    path: "/wall",
    fields: [
        payment_id: String,
        tenant_id: String,
        status: String,
        currency: String,
        hold_reason: Option<String>,
        hold_expires_at: i64,
        decision_by: Option<String>,
        decision_rationale: Option<String>,
    ],
    create: public,
    read: public,
    update: public,
    delete: public,
    guard: {
        table: payment_table,
        purpose: "FraudMonitoring",
    },
    refresh_seconds: 15,
    sort_by: hold_expires_at,
    countdown_field: hold_expires_at,
}

nirdosha_rt::app_shell_from_toml!(
    "menus.toml",
    title: "RTM — Real-Time Transaction Monitoring (demo)",
);
