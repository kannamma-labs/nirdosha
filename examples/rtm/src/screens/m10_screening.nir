/// 10.6 Historical Rescreen Campaigns -- `rescreen-campaign-read` (real,
/// `Admin`, `ComplianceLead`).
pub fn mount_rescreen_campaigns(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    router.get_with_auth("/screening/campaigns", "Historical Rescreen Campaigns (10.6)", |_req, _params, auth| {
        match rescreen_campaign_table().guarded_snapshot(auth, "Operations") {
            Ok(rows) => {
                let fields = [
                    FieldSpec { name: "campaign_id", input_type: "text" },
                    FieldSpec { name: "list_id", input_type: "text" },
                    FieldSpec { name: "started_at", input_type: "text" },
                    FieldSpec { name: "matches_found", input_type: "number" },
                ];
                let values: Vec<serde_json::Value> = rows.iter().map(|r| serde_json::to_value(r).unwrap()).collect();
                nirdosha_rt::Response::html(200, nirdosha_rt::screens::read_only_list_html("Historical Rescreen Campaigns", &fields, &values))
            }
            Err(e) => nirdosha_guard_screens::guard_error_response(e),
        }
    })
}

nirdosha_rt::crud_screens! {
    mount: mount_screening_hit_screens,
    entity: ScreeningHitRow,
    store: unused_screening_hit_store,
    path: "/screening/hits",
    fields: [
        hit_id: String,
        tenant_id: String,
        subject_ref: String,
        list_id: String,
        match_score: f64,
        disposition: String,
        rationale: String,
    ],
    create: public,
    read: public,
    update: public,
    delete: public,
    guard: {
        table: screening_hit_table,
        purpose: "AmlInvestigation",
        update_fields: [
            disposition: String,
            rationale: String,
        ],
    },
}

/// Read-only `matcher!` catalog view -- role-gated (`PolicyEngineer`,
/// `Admin`) rather than policy-gated, disclosed in this module's own
/// doc comment. Real values transcribed from `40_scoring.nir:33-46`, not
/// generated.
pub fn mount_matcher_catalog(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    router.get_gated::<crate::nirdosha_roles::PolicyEngineer>("/screening/matchers", "Matcher catalog", |_req, _params, _proof| {
        nirdosha_rt::Response::json(200, &serde_json::json!({
            "note": "role-gated (PolicyEngineer), not policy-gated: no guard_policy! covers a \"matcher\" read anywhere in this corpus.",
            "matchers": [
                { "name": "sanctions", "algorithm": "fuzzy_jaro_winkler", "threshold": 0.92, "lists": ["ofac_sdn", "un_consolidated", "eu_fsf"] },
                { "name": "internal_watchlist", "algorithm": "fuzzy_jaro_winkler", "threshold": 0.95, "lists": ["internal_watch", "pep_global"] },
            ],
        }))
    })
}
