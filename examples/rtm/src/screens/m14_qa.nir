//! M14 Quality Assurance & Oversight (`screen.md` module 14, 5 screens).
//! Policies: `95_qa.nir`. RTM live-demo plan Phase B batch 3.
//!
//! Real, guard-enforced: 14.1/14.2 QA review create/update
//! (`qa-write-review`'s real `field_policy { required(item_ref,
//! rubric_scores, result) forbidden(item_ref_content) }` + `requires
//! field(status).transition_allowed()` against the real `QaReviewStatus`
//! machine, wired via `guard.create_fields`/`update_fields` the same way
//! every prior batch has), 14.3 self scorecard (`self-read-qa`'s real
//! `filter subject_scope()`, keyed on `bridge.nir`'s disclosed
//! `subject_user_id` field), and the corpus's own bidirectional SoD
//! denies (`qa-no-disposition`, `analyst-no-qa`) -- exercised by this
//! batch's own test suite as real denials, not asserted as theory.
//!
//! Also real, guard-enforced (C1, screens-plan.md): 14.4 Feedback &
//! Coaching's `task_form` combo -- a real, guard-enforced coaching
//! action-item mini-list/create over `PG.case_task`
//! (`case-task-read`/`case-task-create`), scoped to the review via
//! `item_ref = "qa:<id>"`, `task_type = "coaching_action"`. The screen's
//! own primary resource stays `qa_review` (`/qa/{id}/feedback`,
//! `mount_qa_review_screens`'s `update_fields` -- `feedback`); this is
//! the embedded action-items widget the combo label names, not a second
//! primary resource.
//!
//! 14.5 Overturned Decisions Log (T-11, this batch): `qa_review_table`'s
//! own `returned` status (`QaReviewStatus`'s real machine, `scored ->
//! returned` -- a QA reviewer overturning an analyst's disposition) cross-
//! referenced against `AC.all_chains`'s `alert` entries, the real
//! `AC.alert_chain` half of this screen's declared `datasets`.

use crate::bridge::all_chains_table;
use crate::bridge::qa_review_table;
use crate::bridge::refresh_all_chains;
use crate::bridge::QaReviewRow;
use nirdosha_rt::prelude::SharedTable;

fn unused_qa_review_store() -> &'static SharedTable<i64, QaReviewRow> {
    static STORE: std::sync::OnceLock<SharedTable<i64, QaReviewRow>> = std::sync::OnceLock::new();
    STORE.get_or_init(SharedTable::new)
}

nirdosha_rt::crud_screens! {
    mount: mount_qa_review_screens,
    entity: QaReviewRow,
    store: unused_qa_review_store,
    path: "/qa",
    fields: [
        review_id: String,
        item_ref: String,
        rubric_scores: String,
        result: String,
        error_severity: String,
        retraining_flag: bool,
        feedback: String,
        status: String,
    ],
    create: public,
    read: public,
    update: public,
    delete: public,
    guard: {
        table: qa_review_table,
        purpose: "QaReview",
        create_fields: [
            review_id: String,
            tenant_id: String,
            subject_user_id: String,
            item_ref: String,
            rubric_scores: String,
            result: String,
        ],
        update_fields: [
            status: String,
            error_severity: String,
            retraining_flag: bool,
            feedback: String,
        ],
    },
}

/// 14.3 Own/team scorecard -- `self-read-qa` (`Analyst`, `filter
/// subject_scope()`, `cap(row_cap = 50)`, no `purpose(...)` clause at
/// all, so it matches any incoming purpose per
/// `matching_allow_records`'s own `r.purpose.as_deref().is_none_or(...)`
/// check) alongside two real policies that landed after this doc
/// comment was first written -- `compliance-lead-read-qa-review`
/// (`ComplianceLead`) and `qa-review-queue-read` (`QaReviewer`), both
/// `purpose(QaReview)` -- superseded, same "policy landed later"
/// posture disclosed elsewhere in this batch. The old `guarded_snapshot
/// (auth, "")` call only ever matched `self-read-qa`'s purpose-less
/// grant, so `ComplianceLead`/`QaReviewer` (both real `screens.toml`
/// roles for 14.3) 403'd even though a real policy backs each of them
/// now; passing the real `"QaReview"` purpose matches all three (the
/// purpose-less grant still matches, unconditionally) without narrowing
/// what `Analyst` already had.
pub fn mount_qa_self_scorecard(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    // `get_with_auth`, not `get_gated::<Analyst>` -- the real
    // authorization is per-role `guard_policy!` evaluation inside
    // `guarded_snapshot` itself, the same "let the bridge decide, don't
    // pre-filter by role" posture every other guard-backed route in this
    // phase uses.
    router.get_with_auth("/qa/mine", "My QA scorecard", |_req, _params, auth| match qa_review_table().guarded_snapshot(auth, "QaReview") {
        Ok(rows) => nirdosha_rt::Response::json(200, &serde_json::json!(rows)),
        Err(e) => nirdosha_guard_screens::guard_error_response(e),
    })
}

/// 14.5 Overturned Decisions Log -- `ComplianceLead`/`Mlro`: every QA
/// review that reached `returned` (the real `QaReviewStatus` machine's
/// "overturn" edge, `scored -> returned`), alongside the real alert
/// audit-chain activity (`AC.all_chains` filtered to the `alert` module)
/// for context on what was overturned.
pub fn mount_overturned_decisions_log(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    router.get_with_auth("/qa/overturned", "Overturned Decisions Log (14.5)", |_req, _params, auth| {
        refresh_all_chains();
        let overturned = match qa_review_table().guarded_snapshot(auth, "QaReview") {
            Ok(rows) => rows.into_iter().filter(|r: &QaReviewRow| r.status == "returned").collect::<Vec<_>>(),
            Err(e) => return nirdosha_guard_screens::guard_error_response(e),
        };
        let alert_chain = match all_chains_table().guarded_snapshot(auth, "Audit") {
            Ok(rows) => rows.into_iter().filter(|r| r.module == "alert").collect::<Vec<_>>(),
            Err(e) => return nirdosha_guard_screens::guard_error_response(e),
        };
        nirdosha_rt::Response::json(200, &serde_json::json!({ "overturned_reviews": overturned, "alert_chain": alert_chain }))
    })
}

/// C1 (screens-plan.md): 14.4's `task_form` combo -- real guard-enforced
/// list + create over `PG.case_task` (`case-task-read`/`case-task-
/// create`, `00_core.nir`), scoped to this review via `item_ref =
/// "qa:<id>"`, `task_type = "coaching_action"`.
pub fn mount_qa_task_form(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    use std::collections::HashSet;
    router
        .get_with_auth("/qa/{id}/tasks", "Coaching action items (14.4)", |_req, params, auth| {
            let Some(id) = params.get("id").map(|s| s.to_string()) else { return nirdosha_rt::Response::bad_request("id required") };
            let item_ref = format!("qa:{id}");
            match crate::bridge::case_task_table().guarded_snapshot(auth, "Operations") {
                Ok(rows) => {
                    let filtered: Vec<_> = rows.into_iter().filter(|r| r.item_ref == item_ref && r.task_type == "coaching_action").collect();
                    nirdosha_rt::Response::json(200, &serde_json::json!(filtered))
                }
                Err(e) => nirdosha_guard_screens::guard_error_response(e),
            }
        })
        .post_with_auth("/qa/{id}/tasks", "Add coaching action item (14.4)", |req, params, auth| {
            let Some(id) = params.get("id").map(|s| s.to_string()) else { return nirdosha_rt::Response::bad_request("id required") };
            let form = req.form_or_json();
            let Some(title) = form.get("title").cloned() else { return nirdosha_rt::Response::bad_request("title required") };
            let assignee = form.get("assignee").cloned().unwrap_or_else(|| auth.user().to_string());
            let due_date = form.get("due_date").cloned().unwrap_or_default();
            let priority = form.get("priority").cloned().unwrap_or_else(|| "normal".into());
            let detail = form.get("detail").cloned().unwrap_or_default();
            let task_id = format!("task-{}", ::std::time::SystemTime::now().duration_since(::std::time::UNIX_EPOCH).unwrap().as_millis());
            let submitted: HashSet<String> = ["item_ref".into(), "task_type".into(), "title".into(), "assignee".into(), "due_date".into(), "priority".into()].into();
            let entity = crate::bridge::CaseTaskRow {
                id: 0,
                task_id,
                tenant_id: crate::bridge::DEMO_TENANT.into(),
                item_ref: format!("qa:{id}"),
                task_type: "coaching_action".into(),
                title,
                detail,
                assignee,
                due_date,
                priority,
                status: "open".into(),
                blocked_reason: String::new(),
                completion_note: String::new(),
            };
            match crate::bridge::case_task_table().guarded_insert_checked(auth, "Operations", &submitted, entity) {
                Ok(row) => nirdosha_rt::Response::json(201, &serde_json::json!(row)),
                Err(e) => nirdosha_guard_screens::guard_error_response(e),
            }
        })
}
