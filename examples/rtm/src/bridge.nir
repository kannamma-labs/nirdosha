//! RTM live-demo plan: the `nirdosha_guard_screens::GuardedEntity` impls
//! and shared demo constants every `screens/*.nir` module wires into.
//! Grown module-by-module across Phase A (`Transaction`) and Phase B's
//! rollout batches (`Alert`/`Case`/`Customer`, then `Model`/`ScreeningHit`/
//! `RefDataset`/`WindowConfig`) -- see the plan's per-module rollout
//! table for what's still owed.
//!
//! **`crud_screens!`'s `requires role "..."` grammar cannot name any RTM
//! role.** `nirdosha-contract-core::role::role_ident` requires
//! lowercase snake_case (`"hr_staff"`) and PascalCases it into the
//! `RoleProof<R>` type name it needs; RTM's `00_core.nir` roles are
//! *already* PascalCase idents (`role Analyst;` → wire name
//! `stringify!(Analyst)` = `"Analyst"`, the same string every
//! `guard_policy!` `for Analyst` subject match needs verbatim -- see
//! that macro's own doc comment on why it can't invent a second,
//! snake_case name for the same role without breaking that string
//! equality). So no RTM `crud_screens!` invocation can pass a real role
//! name to `create:`/`read:`/`update:`/`delete:` today; every one in
//! this phase uses `public` for those four verbs and relies on `guard:`
//! (this crate's own bridge) for the real authorization instead. This is
//! a real, workspace-wide blocker for every one of the remaining 21
//! modules, not an RTM-local one -- flagged for Phase B, not routed
//! around by renaming RTM's roles.

use nirdosha_guard_screens::GuardedEntity;

pub const DEMO_TENANT: &str = "acme-demo";

/// Wire role names both `m01_auth.nir`'s avatar picker and every
/// `GuardedTable` in this crate check `Auth::has_role(...)` against --
/// the 11 human roles `00_core.nir`'s `roles!` block declares, service
/// principals (`SvcIngest`, ...) excluded: those are backend identities
/// a browser session never authenticates as.
pub const HUMAN_ROLES: &[&str] = &[
    "Analyst",
    "ComplianceLead",
    "Mlro",
    "QaReviewer",
    "OpsAnalyst",
    "PolicyEngineer",
    "Admin",
    "Auditor",
    "CsAgent",
    "RmUser",
    "RegulatorViewer",
];

/// The screen-row projection of `crate::domains::Transaction`. Not that
/// struct itself: every `nirdosha_rt::screens` render helper
/// (`detail_html`, `list_html`, ...) and `crud_screens!`'s own generated
/// code assume a synthetic `id: i64`, which the corpus's real dataset
/// struct deliberately has no room for (`TxnId` is RTM's real identity,
/// a string newtype). Keeping the UI-only synthetic key here, off the
/// corpus's own dataset declaration, is the RTM live-demo plan's Phase A
/// call -- see `bridge.nir`'s module doc comment.
///
/// `occurred_at` is `i64`, not the domain type's `u64`
/// (`domain_types::Timestamp(pub u64)`): `nirdosha_rt::screens::ParseField`
/// has no `u64` impl (only `String`/`i64`/`f64`/`bool`) -- `crud_screens!`'s
/// generated `__parse` needs one for every `fields:` entry regardless of
/// whether the guard-backed read path (which never calls `__parse`) uses
/// it. A demo-scale epoch-ms value fits `i64` with room to spare.
#[derive(Debug, Clone, Default, serde::Serialize, serde::Deserialize)]
pub struct TransactionRow {
    pub id: i64,
    pub txn_id: String,
    pub tenant_id: String,
    pub subject_id: String,
    pub account_id: String,
    pub amount: f64,
    pub currency: String,
    pub status: String,
    pub occurred_at: i64,
    pub channel: String,
    pub merchant_id: String,
    pub card_token: String,
    pub device_id: String,
    pub geo: String,
    /// Neither field exists on the corpus's own `#[dataset] struct
    /// Transaction` (`10_domains.nir`) either -- `20_ingestion.nir`'s
    /// `analyst-flag-transaction` policy names them in its own
    /// `field_policy { allowed(analyst_flag, analyst_flag_reason) }`
    /// (a real, pre-existing corpus drift Phase A's own
    /// `account_id` fix already established the precedent for: a
    /// `guard_policy!` block naming a field its dataset never declared).
    /// Real, checked fields here (unlike `id`/`txn_id`, which are
    /// screen-only and `field_policy_exempt`) -- proving this policy's
    /// G1 enforcement for real is the point of wiring them at all.
    pub analyst_flag: bool,
    pub analyst_flag_reason: String,
}

impl GuardedEntity for TransactionRow {
    const RESOURCE: &'static str = "transaction";
    fn row_id(&self) -> String {
        self.txn_id.clone()
    }
    // Neither field exists on the corpus's own `#[dataset] struct
    // Transaction` (`10_domains.nir`) -- `id` is the synthetic screen
    // key every `nirdosha_rt::screens` render helper needs, `txn_id` is
    // this row's own storage/guard identity (`Transaction` itself has no
    // self-referencing id field at all; `Alert.txn_id` is a *reference*
    // to one, a different thing). `20_ingestion.nir`'s `ingest-create-txn`
    // field_policy was never written with either in mind, and shouldn't
    // be -- exempting them here is the honest fix, not editing that
    // policy to mention fields that aren't part of its own dataset.
    fn field_policy_exempt() -> &'static [&'static str] {
        &["id", "txn_id"]
    }
    // `analyst_flag`/`analyst_flag_reason` are real, checked fields for
    // *update* (`analyst-flag-transaction`'s own `field_policy` names
    // them, see `check_invariant`'s neighboring comment) but
    // `ingest-create-txn`'s `field_policy` never mentions them at all --
    // create-time exempt-only, not exempt everywhere, is the honest fix
    // (see `GuardedEntity::create_field_policy_exempt`'s own doc
    // comment); swallowing them into `field_policy_exempt` above would
    // silently blind the update check to the one thing it exists to
    // enforce.
    fn create_field_policy_exempt() -> &'static [&'static str] {
        &["id", "txn_id", "analyst_flag", "analyst_flag_reason"]
    }

    /// `analyst-flag-transaction`'s real `requires invariant
    /// (amount_positive) && invariant(currency_iso)` (`00_core.nir`),
    /// dispatched to the same real, shared logic those invariant fns
    /// use: `Money::is_positive`/`CurrencyCode::is_iso_4217`
    /// (`10_domains.nir`) -- not a `Transaction` reconstruction (this
    /// row is a flat screen projection, not that struct) and not a
    /// re-typed duplicate of the check either.
    fn check_invariant(&self, name: &str) -> Option<bool> {
        match name {
            "amount_positive" => Some(crate::domains::Money(self.amount).is_positive()),
            "currency_iso" => Some(crate::domain_types::CurrencyCode(self.currency.clone()).is_iso_4217()),
            _ => None,
        }
    }
}

/// The one process-wide, guard-enforced `Transaction` table -- backed by
/// `MemStoreDriver` in Phase A (real Postgres wiring is a Phase C item
/// per the plan, gated on `docker-compose.dev.yml`'s Postgres service
/// actually being up). Every `guard_policy!` this table evaluates
/// against comes from `rtm`'s own linked-in corpus
/// (`nirdosha_guard_registry::candidates()`/`dump()`), not a hand-built
/// fixture.
pub fn transaction_table() -> &'static nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, TransactionRow> {
    static TABLE: std::sync::OnceLock<nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, TransactionRow>> = std::sync::OnceLock::new();
    TABLE.get_or_init(|| {
        nirdosha_guard_screens::GuardedTable::new(
            nirdosha_guard_mic::MemStoreDriver::new(),
            nirdosha_guard_registry::candidates(),
            nirdosha_guard_registry::dump().policies,
            "rtm-demo",
            std::env::temp_dir().join(format!("rtm-demo-audit-{}.jsonl", std::process::id())),
            // HUMAN_ROLES (browser sessions) plus "SvcIngest" -- the one
            // service principal that writes `transaction` rows
            // (`20_ingestion.nir`'s `ingest-create-txn`; the generator's
            // seed path authenticates as this principal, not a human
            // role -- see `Auth::has_role` being just a string check,
            // with nothing that actually distinguishes a human session
            // from a service one).
            HUMAN_ROLES.iter().chain(["SvcIngest"].iter()).map(|r| r.to_string()).collect(),
            DEMO_TENANT,
            vec![],
        )
    })
}

/// The corpus's own registered `approval_chain!` definitions
/// (`nirdosha_guard_registry::dump().approval_chains`), converted to
/// `ApprovalChainDefinition` -- the real, single source of truth every
/// `GuardedTable` that needs escalation support (M4's `case_review`
/// chain today) is seeded from, rather than each screen module
/// hand-copying `00_core.nir`'s `quorum(...)`/`of = [...]` numbers.
pub fn corpus_approval_chains() -> Vec<nirdosha_guard_core::approval_chain::ApprovalChainDefinition> {
    nirdosha_guard_registry::dump()
        .approval_chains
        .into_iter()
        .map(|c| nirdosha_guard_core::approval_chain::ApprovalChainDefinition { name: c.name, quorum: c.quorum, approver_roles: c.approvers, cooling_period_ms: c.cooling_ms })
        .collect()
}

// ============================================================================
// M3 Alerts — screens/m03_alerts.nir's row type + table.
//
// `nirdosha_guard_macros::workflow! { machine AlertStatus { ... } }`
// (`10_domains.nir`) is catalog-only -- same posture this file's own
// module doc comment already establishes for `#[relation]`: it registers
// the block's raw source text (`CatalogRegistration`), not a real Rust
// enum or `advance_*` fn (confirmed by reading `workflow!`'s own
// expansion in `nirdosha-guard-macros/src/lib.rs`: it emits nothing but
// a `CatalogRegistration` static). `AlertRow::transition_allowed` below
// is a hand-written, disclosed reimplementation of that same declared
// graph -- not a stub, but not compiler-enforced type-state either.
// ============================================================================

#[derive(Debug, Clone, Default, serde::Serialize, serde::Deserialize)]
pub struct AlertRow {
    pub id: i64,
    pub alert_id: String,
    pub tenant_id: String,
    pub txn_id: String,
    pub score: f64,
    pub model_version: String,
    pub policy_version: String,
    pub status: String,
    pub assignee: String,
    pub disposition_code: String,
    pub rationale: String,
    pub case_id: String,
    /// Real, checked field -- `50_alerts.nir`'s `analyst-read-alert`
    /// `field_policy { forbidden(sar_linked) }` names it; kept here (not
    /// on the corpus's own `#[dataset] struct Alert`, `10_domains.nir`)
    /// so the G1 check has something real to enforce, the same
    /// `account_id`/`analyst_flag` precedent `TransactionRow` set.
    /// **`Option<String>`, not `bool` or bare `String`** -- T-02's fix to
    /// `nirdosha_guard_screens::field_policy::read_masks_from_field_policy`
    /// synthesizes `MaskTransform::Drop` (true key removal) for this
    /// field_policy-forbidden field, not `Full`/`"[REDACTED]"` (batch
    /// 4's earlier fix, since superseded): the tipping-off rule this
    /// field exists to enforce means a forbidden reader must not see
    /// that `sar_linked` even EXISTS, not just see it masked. `Option`
    /// so a dropped key decodes to `None` instead of a hard deserialize
    /// error, and `skip_serializing_if` so it round-trips back out of
    /// the typed entity still absent, not reintroduced as `null`.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub sar_linked: Option<String>,
    /// `lead-bulk-alert`'s `field_policy { allowed(assignee, severity,
    /// tags) }` -- `severity`/`tags` don't exist on the corpus's own
    /// `Alert` dataset either (another real, disclosed drift, same shape
    /// as `analyst_flag`).
    pub severity: String,
    pub tags: String,
}

impl GuardedEntity for AlertRow {
    const RESOURCE: &'static str = "alert";
    fn row_id(&self) -> String {
        self.alert_id.clone()
    }
    fn field_policy_exempt() -> &'static [&'static str] {
        &["id", "alert_id"]
    }
    fn create_field_policy_exempt() -> &'static [&'static str] {
        // `alert-raise`'s real `field_policy { required(tenant_id,
        // txn_id, score, model_version, policy_version) forbidden
        // (status) }` -- caught by this test suite's own
        // `seed_alert` helper the first time it ran: `status` is
        // FORBIDDEN even for `SvcAlerts` at create (the corpus's own
        // `10_domains.nir` comment: "status — analyst-only field, guard
        // rejects writes to it" -- creation implicitly starts at `new`,
        // never submitted), and `sar_linked` is named by no create
        // policy at all (set later, by whatever links an alert to a
        // SAR). Same real "not submitted, not this action's business"
        // reasoning as every other field below.
        &["id", "alert_id", "status", "assignee", "disposition_code", "rationale", "case_id", "sar_linked", "severity", "tags"]
    }
    fn check_invariant(&self, name: &str) -> Option<bool> {
        match name {
            "rationale_present" => Some(!self.rationale.is_empty()),
            // `00_core.nir`'s real `disposition_code_valid` [NEW: T-03] --
            // unset (not yet dispositioned) is fine; a non-empty value must
            // be in the closed set.
            "disposition_code_valid" => Some(
                self.disposition_code.is_empty()
                    || crate::domains::DISPOSITION_CODES.contains(&self.disposition_code.as_str()),
            ),
            _ => None,
        }
    }
    fn transition_allowed(&self, requested_status: &serde_json::Value) -> Option<bool> {
        let Some(requested) = requested_status.as_str() else { return Some(false) };
        // `10_domains.nir`'s declared `machine AlertStatus` graph,
        // verbatim: `new -> in_progress -> [closed_false_positive,
        // escalated, pending_info]; pending_info -> [in_progress,
        // escalated]; closed_false_positive -> in_progress;`
        let legal: &[&str] = match self.status.as_str() {
            "" | "new" => &["in_progress"], // "" -- a freshly-created row this policy forbids setting `status` on (see AlertRow doc) starts implicitly at the machine's initial state
            "in_progress" => &["closed_false_positive", "escalated", "pending_info"],
            "pending_info" => &["in_progress", "escalated"],
            "closed_false_positive" => &["in_progress"],
            _ => &[],
        };
        Some(legal.contains(&requested))
    }
}

pub fn alert_table() -> &'static nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, AlertRow> {
    static TABLE: std::sync::OnceLock<nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, AlertRow>> = std::sync::OnceLock::new();
    TABLE.get_or_init(|| {
        nirdosha_guard_screens::GuardedTable::new(
            nirdosha_guard_mic::MemStoreDriver::new(),
            nirdosha_guard_registry::candidates(),
            nirdosha_guard_registry::dump().policies,
            "rtm-demo",
            std::env::temp_dir().join(format!("rtm-demo-audit-alert-{}.jsonl", std::process::id())),
            HUMAN_ROLES.iter().chain(["SvcAlerts"].iter()).map(|r| r.to_string()).collect(),
            DEMO_TENANT,
            corpus_approval_chains(),
        )
        // `alert-raise`'s real `obligate notify(channel("analyst-inbox"))`
        // -- see M16's `notify_into_inbox`/`notification_table` doc
        // comments for the real obligation-consumption this wires into.
        .with_notify_hook(notify_into_inbox)
    })
}

// ============================================================================
// M4 Cases — screens/m04_cases.nir's row type + table.
// ============================================================================

#[derive(Debug, Clone, Default, serde::Serialize, serde::Deserialize)]
pub struct CaseRow {
    pub id: i64,
    pub case_id: String,
    pub tenant_id: String,
    pub status: String,
    pub assigned_to: String,
    /// Comma-joined `Vec<AlertId>` -- a flat screen projection, per this
    /// file's own established convention (`TransactionRow`'s doc comment)
    /// of never re-declaring the corpus's own dataset types verbatim.
    pub alert_ids: String,
    pub subject_ref: String,
    // T-02: `case-read`'s real `field_policy { forbidden(sar_id) }`
    // (`60_case_management.nir`) -- tipping-off, same posture as
    // `AlertRow.sar_linked` -- means this field must be genuinely absent
    // for `Analyst`'s own read, not a `"[REDACTED]"` placeholder.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub sar_id: Option<String>,
    pub disposition: String,
    pub rationale: String,
    /// `case-close-confirm`'s own `field_policy { allowed(review_verdict,
    /// review_note) forbidden(everything_else) }` -- real, checked fields
    /// for the escalated four-eyes write (`m04_cases.nir`'s
    /// `guarded_propose_escalated_update`/`guarded_confirm_escalated_update`
    /// calls), same `analyst_flag`-style drift as `AlertRow.severity`.
    pub review_verdict: String,
    pub review_note: String,
}

impl GuardedEntity for CaseRow {
    const RESOURCE: &'static str = "case";
    fn row_id(&self) -> String {
        self.case_id.clone()
    }
    fn field_policy_exempt() -> &'static [&'static str] {
        &["id", "case_id"]
    }
    fn create_field_policy_exempt() -> &'static [&'static str] {
        // `analyst-create-case`'s `field_policy { required(tenant_id,
        // subject_ref, alert_ids, rationale) forbidden(status, sar_id,
        // disposition) }` -- `status`/`sar_id`/`disposition` are
        // explicitly FORBIDDEN at create (svc:case seeds `status`
        // separately per `60_case_management.nir`'s own comment), so
        // they must never be treated as "submitted" even though
        // `CaseRow::default()` still gives them empty-string values.
        // `review_verdict`/`review_note` are a different (later,
        // ComplianceLead-only) action's fields, never set at create
        // time.
        &["id", "case_id", "status", "sar_id", "disposition", "assigned_to", "review_verdict", "review_note"]
    }
    fn check_invariant(&self, name: &str) -> Option<bool> {
        match name {
            "rationale_present" => Some(!self.rationale.is_empty()),
            // `00_core.nir`'s real `case_disposition_valid` [NEW: T-03] --
            // unset (still investigating) is fine; a non-empty value must
            // be in the closed set (mirrors the CaseStatus terminal states).
            "case_disposition_valid" => Some(
                self.disposition.is_empty()
                    || crate::domains::CASE_DISPOSITION_CODES.contains(&self.disposition.as_str()),
            ),
            _ => None,
        }
    }
    fn transition_allowed(&self, requested_status: &serde_json::Value) -> Option<bool> {
        let Some(requested) = requested_status.as_str() else { return Some(false) };
        // `10_domains.nir`'s declared `machine CaseStatus` graph,
        // verbatim: `open -> investigating -> [confirmed_fraud,
        // false_positive, escalate]; confirmed_fraud -> sar_filed ->
        // closed; false_positive -> closed;`
        let legal: &[&str] = match self.status.as_str() {
            "" | "open" => &["investigating"], // "" -- same freshly-created-row convention as AlertRow
            "investigating" => &["confirmed_fraud", "false_positive", "escalate"],
            "confirmed_fraud" => &["sar_filed"],
            "sar_filed" => &["closed"],
            "false_positive" => &["closed"],
            _ => &[],
        };
        Some(legal.contains(&requested))
    }
}

pub fn case_table() -> &'static nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, CaseRow> {
    static TABLE: std::sync::OnceLock<nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, CaseRow>> = std::sync::OnceLock::new();
    TABLE.get_or_init(|| {
        nirdosha_guard_screens::GuardedTable::new(
            nirdosha_guard_mic::MemStoreDriver::new(),
            nirdosha_guard_registry::candidates(),
            nirdosha_guard_registry::dump().policies,
            "rtm-demo",
            std::env::temp_dir().join(format!("rtm-demo-audit-case-{}.jsonl", std::process::id())),
            HUMAN_ROLES.iter().chain(["SvcCase"].iter()).map(|r| r.to_string()).collect(),
            DEMO_TENANT,
            corpus_approval_chains(),
        )
        // `analyst-create-case`'s real `obligate notify(channel("case-inbox"))`.
        .with_notify_hook(notify_into_inbox)
    })
}

// ============================================================================
// M5 Customer — screens/m05_customer.nir's row type + table.
//
// **Real, disclosed corpus gap** (found building this module, not
// routed around): grepping every `.nir` file under `src/` for `resource
// == "customer"` / `resource in [...]` finds exactly two human-role
// grants -- `rm-restriction-view` (`96_restricted_views.nir`, `RmUser`,
// one field) and `auditor-read` (same file, `Auditor`, broad). No
// `Analyst`/`ComplianceLead`/other L1-L2 role has ANY `guard_policy!`
// read grant on `customer` anywhere in this corpus, despite
// `screen.md`'s Module 5 ("Customer & Entity Intelligence") clearly
// being written for L1/L2 investigators (5.2 "Customer 360" etc.). This
// screen is built against the policies that actually exist, not a
// fabricated one -- inventing a new `guard_policy!` grant to make the
// screen "work" for Analyst would be writing new security policy, which
// isn't this phase's call to make silently. `m05_customer.nir`'s own doc
// comment repeats this for anyone landing there first.
// ============================================================================

#[derive(Debug, Clone, Default, serde::Serialize, serde::Deserialize)]
pub struct CustomerRow {
    pub id: i64,
    pub customer_id: String,
    pub tenant_id: String,
    // T-02: `rm-restriction-view`'s real `field_policy {
    // allowed(restriction_status) forbidden(national_id, name, dob,
    // ..., pep_flag, sanctions_status, ...) }` (`96_restricted_views.nir`)
    // means these fields must come back genuinely ABSENT for `RmUser`,
    // not a `"[REDACTED]"` placeholder -- `read_masks_from_field_policy`
    // now synthesizes `MaskTransform::Drop` (true key removal) for a
    // `forbidden(...)` name, so every field it can name here is
    // `Option<T>` with `skip_serializing_if`, not a bare masked-shaped
    // `String`/`bool`.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub name: Option<String>,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub national_id: Option<String>,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub dob: Option<String>,
    pub occupation: String,
    pub kyc_status: String,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub risk_rating: Option<String>,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub pep_flag: Option<String>,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub sanctions_status: Option<String>,
    /// The ONE field `rm-restriction-view` actually grants `RmUser` --
    /// every other field above is real (matches `10_domains.nir`'s
    /// `#[dataset] struct Customer`) but only reachable by `Auditor`'s
    /// broad `auditor-read` grant; `RmUser`'s own read is masked down to
    /// this single field by that policy's own `field_policy {
    /// allowed(restriction_status) forbidden(...) }` -- real, read-side
    /// enforcement since batch 4's `read_masks_from_field_policy` fix
    /// (`nirdosha-guard-screens`'s own module doc comment), exercised
    /// live by `m21_restricted.nir`'s masked view.
    pub restriction_status: String,
    pub legal_hold: bool,
}

impl GuardedEntity for CustomerRow {
    const RESOURCE: &'static str = "customer";
    fn row_id(&self) -> String {
        self.customer_id.clone()
    }
    fn field_policy_exempt() -> &'static [&'static str] {
        &["id", "customer_id"]
    }
}

pub fn customer_table() -> &'static nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, CustomerRow> {
    static TABLE: std::sync::OnceLock<nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, CustomerRow>> = std::sync::OnceLock::new();
    TABLE.get_or_init(|| {
        nirdosha_guard_screens::GuardedTable::new(
            nirdosha_guard_mic::MemStoreDriver::new(),
            nirdosha_guard_registry::candidates(),
            nirdosha_guard_registry::dump().policies,
            "rtm-demo",
            std::env::temp_dir().join(format!("rtm-demo-audit-customer-{}.jsonl", std::process::id())),
            HUMAN_ROLES.iter().map(|r| r.to_string()).collect(),
            DEMO_TENANT,
            // `dsar-export`'s real `escalate to approval(chain
            // egress_release)` (`90_ops_admin.nir`) -- wired here in
            // batch 3, `vec![]` before this had no escalating customer
            // policy to serve.
            corpus_approval_chains(),
        )
    })
}

// ============================================================================
// M9 ML Models — screens/m09_ml_models.nir's row type + table.
//
// `scoring-model-swap` (`40_scoring.nir`): `for PolicyEngineer`,
// `action == "update" && resource == "model"`, `escalate to
// approval(chain model_release)` (`quorum(2, of = [PolicyEngineer,
// ComplianceLead])`) -- PolicyEngineer both proposes AND is chain-
// eligible, same "four-eyes among peers" shape M4's `case-close-confirm`
// already exercises; reuses `guarded_propose_escalated_update`/
// `guarded_confirm_escalated_update` verbatim, no new engine work.
//
// `model_artifact! { model rt_fraud_v1 { format = onnx; inputs = [...];
// outputs = [...]; threshold_alert = 0.85; } }` (`40_scoring.nir`) is
// catalog-only (same posture `stream_port!`/`window!` already establish
// elsewhere in this file) -- no `update`/`create` action exists on it at
// runtime; `40_scoring.nir`'s own comment calls the swap "a guarded admin
// mutation, never a config edit". This row is seeded ONCE at process
// startup from that real catalog record via `raw_driver_seed` -- a
// deliberate exception to that method's own "not for anything this
// crate's own runtime code should call" doc comment: a one-time boot
// load from the compiled-in catalog is the same posture a real
// deployment's migration/backfill step has, not a live guarded write a
// human or service ever performs, so there is no `guarded_apply`-shaped
// call this could be instead.
#[derive(Debug, Clone, Default, serde::Serialize, serde::Deserialize)]
