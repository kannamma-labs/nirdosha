// ============================================================================
// M12 SAR / Regulatory Reporting — screens/m12_sar.nir's row type + table.
// Final Phase B batch.
//
// `65_sar.nir`'s real policies: `analyst-draft-sar` (`for Analyst`,
// `requires invariant(sar_subject_in_case)`, `field_policy {
// required(case_id, subject) forbidden(status, goaml_ref, filed_at) }`),
// `analyst-edit-sar` (`requires field(status) == "draft"`, `field_policy
// { allowed(narrative, activity_codes, amount_total, txn_refs,
// next_review_at) forbidden(case_id, subject, status, goaml_ref) }`),
// `mlro-decide-sar` (`for Mlro`, `requires
// field(status).transition_allowed()`, `field_policy { allowed(status,
// mlro_rationale) forbidden(narrative, txn_refs) }`), `sar-export` (`for
// ComplianceLead`, `requires field(status) == "confirmed_fraud"`,
// `escalate to approval(chain sar_release)`). `mlro_rationale` is named
// by `mlro-decide-sar`'s own `field_policy` but never declared on the
// corpus's own `SarBundle` struct (`10_domains.nir`) -- same
// `analyst_flag`-style drift as `TransactionRow`/`CaseRow`'s own extra
// screen-only fields, added here for the same reason.
#[derive(Debug, Clone, Default, serde::Serialize, serde::Deserialize)]
pub struct SarBundleRow {
    pub id: i64,
    pub sar_id: String,
    pub tenant_id: String,
    pub case_id: String,
    pub subject: String,
    pub status: String,
    pub narrative: String,
    /// Comma-joined `Vec<ActivityCode>` -- flat screen projection, per
    /// this file's established convention.
    pub activity_codes: String,
    pub amount_total: f64,
    /// Comma-joined `Vec<TxnId>`.
    pub txn_refs: String,
    pub filed_at: i64,
    pub goaml_ref: String,
    pub next_review_at: i64,
    pub mlro_rationale: String,
}

impl GuardedEntity for SarBundleRow {
    const RESOURCE: &'static str = "sar_bundle";
    fn row_id(&self) -> String {
        self.sar_id.clone()
    }
    fn field_policy_exempt() -> &'static [&'static str] {
        &["id", "sar_id"]
    }
    fn check_invariant(&self, name: &str) -> Option<bool> {
        match name {
            // `00_core.nir`'s real `sar_subject_in_case` invariant,
            // rewritten (per that file's own doc comment) to what's
            // actually checkable from `SarBundle`'s own fields: non-empty
            // `case_id`/`subject`.
            "sar_subject_in_case" => Some(!self.case_id.is_empty() && !self.subject.is_empty()),
            _ => None,
        }
    }
    fn transition_allowed(&self, requested_status: &serde_json::Value) -> Option<bool> {
        let Some(requested) = requested_status.as_str() else { return Some(false) };
        // `10_domains.nir`'s declared `machine SarStatus` graph,
        // verbatim: `draft -> in_review -> [filed, rejected,
        // do_not_file]; rejected -> draft; filed -> continuation_due ->
        // [filed, ceased];`
        let legal: &[&str] = match self.status.as_str() {
            "" | "draft" => &["in_review"], // "" -- same freshly-created-row convention as AlertRow
            "in_review" => &["filed", "rejected", "do_not_file"],
            "rejected" => &["draft"],
            "filed" => &["continuation_due"],
            "continuation_due" => &["filed", "ceased"],
            _ => &[],
        };
        Some(legal.contains(&requested))
    }
}

pub fn sar_bundle_table() -> &'static nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, SarBundleRow> {
    static TABLE: std::sync::OnceLock<nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, SarBundleRow>> = std::sync::OnceLock::new();
    TABLE.get_or_init(|| {
        nirdosha_guard_screens::GuardedTable::new(
            nirdosha_guard_mic::MemStoreDriver::new(),
            nirdosha_guard_registry::candidates(),
            nirdosha_guard_registry::dump().policies,
            "rtm-demo",
            std::env::temp_dir().join(format!("rtm-demo-audit-sar-bundle-{}.jsonl", std::process::id())),
            HUMAN_ROLES.iter().map(|r| r.to_string()).collect(),
            DEMO_TENANT,
            // `sar_release` (`sar-export`'s real quorum(2)).
            corpus_approval_chains(),
        )
    })
}

