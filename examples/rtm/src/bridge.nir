#[derive(Debug, Clone, Default, serde::Serialize, serde::Deserialize)]
pub struct CatalogProjectionRow {
    pub id: i64,
    pub entry_id: String,
    pub kind: String,
    pub name: String,
    pub source_ref: String,
}

impl GuardedEntity for CatalogProjectionRow {
    const RESOURCE: &'static str = "catalog_projection";
    fn row_id(&self) -> String { self.entry_id.clone() }
    fn field_policy_exempt() -> &'static [&'static str] { &["id", "entry_id"] }
}

pub fn catalog_projection_table() -> &'static nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, CatalogProjectionRow> {
    static TABLE: std::sync::OnceLock<nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, CatalogProjectionRow>> = std::sync::OnceLock::new();
    TABLE.get_or_init(|| {
        let table = nirdosha_guard_screens::GuardedTable::new(
            nirdosha_guard_mic::MemStoreDriver::new(),
            nirdosha_guard_registry::candidates(),
            nirdosha_guard_registry::dump().policies,
            "rtm-demo",
            std::env::temp_dir().join(format!("rtm-demo-audit-catalog-projection-{}.jsonl", std::process::id())),
            HUMAN_ROLES.iter().map(|r| r.to_string()).collect(),
            DEMO_TENANT,
            vec![],
        );
        // Seed from real guard registry dump: policies, windows, models, matchers.
        let dump = nirdosha_guard_registry::dump();
        for (i, p) in dump.policies.iter().enumerate() {
            table.raw_driver_seed(DEMO_TENANT, &CatalogProjectionRow { id: i as i64 + 1, entry_id: format!("policy-{}", i), kind: "policy".into(), name: p.id.clone(), source_ref: format!("{}/{}", p.action, p.resource) });
        }
        for (i, w) in dump.windows.iter().enumerate() {
            table.raw_driver_seed(DEMO_TENANT, &CatalogProjectionRow { id: 1000 + i as i64, entry_id: format!("window-{}", i), kind: "window".into(), name: w.name.clone(), source_ref: w.name.clone() });
        }
        for (i, m) in dump.models.iter().enumerate() {
            table.raw_driver_seed(DEMO_TENANT, &CatalogProjectionRow { id: 2000 + i as i64, entry_id: format!("model-{}", i), kind: "model".into(), name: m.name.clone(), source_ref: m.name.clone() });
        }
        for (i, m) in dump.matchers.iter().enumerate() {
            table.raw_driver_seed(DEMO_TENANT, &CatalogProjectionRow { id: 3000 + i as i64, entry_id: format!("matcher-{}", i), kind: "matcher".into(), name: m.name.clone(), source_ref: m.name.clone() });
        }
        table
    })
}

