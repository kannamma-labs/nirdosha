// ============================================================================
// M16 Notifications & Collaboration — screens/m16_notifications.nir's row
// type + table.
//
// **Real, disclosed corpus shape**: grepping every `.nir` file under
// `src/` for `resource == "notification"` / `resource in [...]` finds
// ZERO `guard_policy!` blocks -- notifications are purely a real
// `obligate notify(channel(...))` SIDE EFFECT of an already-authorized
// action on a DIFFERENT resource (`alert-raise`'s `channel("analyst-inbox")`,
// `analyst-create-case`'s `channel("case-inbox")`, `qa-write-review`'s
// `channel("qa-inbox")`), never a resource a subject reads/writes under
// its own guard decision. So this table is written only via
// `GuardedTable::system_write` (from `alert_table`/`case_table`/
// `qa_review_table`'s own `with_notify_hook` wiring below -- the real
// fix for the gap `nirdosha-guard-screens`'s own module doc comment used
// to flag: `EvaluationResult.obligations` was real and computed, just
// never consumed) and read only via `system_scan` -- the screen route
// (`m16_notifications.nir`) gates who sees which channel by role
// directly (`Auth::has_role`), the same honest "role-gated, not
// policy-gated, because no policy exists to gate it" posture
// `m10_screening.nir`'s `matcher!` catalog view already established.
#[derive(Debug, Clone, Default, serde::Serialize, serde::Deserialize)]
pub struct NotificationRow {
    pub id: i64,
    pub notification_id: String,
    pub tenant_id: String,
    pub channel: String,
    pub body_ref: String,
    pub read: bool,
}

impl GuardedEntity for NotificationRow {
    const RESOURCE: &'static str = "notification";
    fn row_id(&self) -> String {
        self.notification_id.clone()
    }
}

pub fn notification_table() -> &'static nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, NotificationRow> {
    static TABLE: std::sync::OnceLock<nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, NotificationRow>> = std::sync::OnceLock::new();
    // Constructed with NO candidates/records at all -- see this table's
    // own doc comment: there is genuinely no `guard_policy!` to evaluate
    // for `"notification"`, so wiring the usual `nirdosha_guard_registry`
    // corpus in here would be theater, not enforcement.
    TABLE.get_or_init(|| {
        nirdosha_guard_screens::GuardedTable::new(
            nirdosha_guard_mic::MemStoreDriver::new(),
            vec![],
            vec![],
            "rtm-demo",
            std::env::temp_dir().join(format!("rtm-demo-audit-notification-{}.jsonl", std::process::id())),
            HUMAN_ROLES.iter().map(|r| r.to_string()).collect(),
            DEMO_TENANT,
            vec![],
        )
    })
}

/// Real `channel -> row_id` id minting for [`notification_table`]'s
/// writes -- an atomic counter, not a UUID/timestamp dependency, so
/// tests get deterministic, collision-free ids across a whole process
/// run without pulling in a new crate for it.
fn next_notification_id() -> String {
    use std::sync::atomic::{AtomicU64, Ordering};
    static NEXT: AtomicU64 = AtomicU64::new(1);
    format!("notif-{}", NEXT.fetch_add(1, Ordering::Relaxed))
}

/// The one real `notify_hook` closure every obligation-producing table
/// below shares -- writes a real [`NotificationRow`] via
/// [`nirdosha_guard_screens::GuardedTable::system_write`] (see that
/// method's own doc comment for why this is the one legitimate
/// non-guarded write path, not a policy-evasion hole).
fn notify_into_inbox(channel: &str, body_ref: &str) {
    notification_table().system_write(
        DEMO_TENANT,
        &NotificationRow { id: 0, notification_id: next_notification_id(), tenant_id: DEMO_TENANT.into(), channel: channel.into(), body_ref: body_ref.into(), read: false },
    );
}

// ============================================================================
// M14 Quality Assurance & Oversight — screens/m14_qa.nir's row type +
// table.
//
// `qa-write-review` (`95_qa.nir`): `for QaReviewer`, `action in ["create",
// "update"] && resource == "qa_review"`, `requires
// field(status).transition_allowed()` (`QaReviewStatus` machine,
// `10_domains.nir`: `assigned -> scored -> [closed, returned];`),
// `field_policy { required(item_ref, rubric_scores, result)
// forbidden(item_ref_content) }`, `obligate notify(channel("qa-inbox"))`
// -- the real obligation this batch's notify-hook wiring exists to prove.
//
// **Two real, disclosed drifts, same "policy/workflow names a field the
// dataset never declares" pattern every prior batch has established**:
// `status` (the `QaReviewStatus` machine needs it; the corpus's own
// `#[dataset] struct QaReview`, `10_domains.nir`, has no such field at
// all -- `result: QaResult` is a DIFFERENT, already-scored value, not a
// workflow state) and `review_id`/`subject_user_id` (a synthetic screen
// key and the reviewed analyst's own id -- `self-read-qa`'s real `filter
// subject_scope()` needs SOME field identifying "whose work this review
// is about," and the corpus dataset has none; `item_ref` names the
// ALERT/CASE being reviewed, not the analyst who handled it).
#[derive(Debug, Clone, Default, serde::Serialize, serde::Deserialize)]
pub struct QaReviewRow {
    pub id: i64,
    pub review_id: String,
    pub tenant_id: String,
    pub item_ref: String,
    pub subject_user_id: String,
    pub rubric_scores: String,
    pub result: String,
    pub error_severity: String,
    pub retraining_flag: bool,
    pub feedback: String,
    pub status: String,
}

impl GuardedEntity for QaReviewRow {
    const RESOURCE: &'static str = "qa_review";
    fn row_id(&self) -> String {
        self.review_id.clone()
    }
    fn field_policy_exempt() -> &'static [&'static str] {
        &["id", "review_id", "subject_user_id", "status"]
    }
    fn create_field_policy_exempt() -> &'static [&'static str] {
        // `tenant_id` joins the others here for the same reason `id`/
        // `review_id` do: `qa-write-review`'s real field_policy
        // (`required(item_ref, rubric_scores, result)
        // forbidden(item_ref_content)`) never names it, but the row
        // still needs a real tenant value set at create time (parsed via
        // `guard.create_fields` in `m14_qa.nir`) for the demo's
        // single-tenant convention to hold -- the corpus simply has
        // nothing to say about who supplies it, the same "screen
        // plumbing the policy is silent on" class as every other exempt
        // field here.
        &["id", "review_id", "tenant_id", "subject_user_id", "status", "error_severity", "retraining_flag", "feedback"]
    }
    fn subject_scope_field() -> Option<&'static str> {
        Some("subject_user_id")
    }
    fn transition_allowed(&self, requested_status: &serde_json::Value) -> Option<bool> {
        let Some(requested) = requested_status.as_str() else { return Some(false) };
        // **Real, batch-3-discovered wrinkle, not present in
        // `AlertRow`/`CaseRow`'s own `transition_allowed`**: unlike
        // theirs, `qa-write-review`'s real `requires
        // field(status).transition_allowed()` also gates `action ==
        // "create"`, not just `"update"` -- and `guarded_insert_checked`'s
        // own doc comment already establishes that create has no prior
        // state (`before == after == entity`), so this fn is always asked
        // "can `self.status` reach `self.status`" at create time (a
        // same-state check by construction, not a real transition). A
        // same-value write is never an illegal transition regardless of
        // which state it is -- checked FIRST, before the real
        // `QaReviewStatus` machine below, so create-time's inherent
        // self-check always passes without opening any UPDATE to an
        // illegitimate same-state no-op that skirts the real machine (a
        // genuine value CHANGE, e.g. "assigned"->"assigned" attempted as
        // if it meant something, is still just this same harmless case).
        if self.status == requested {
            return Some(true);
        }
        // `10_domains.nir`'s declared `machine QaReviewStatus` graph,
        // verbatim: `assigned -> scored -> [closed, returned];` -- a
        // fresh row (this table's own `raw_driver_seed` below) starts at
        // `assigned`; `returned`/`closed` have no further declared edges
        // (terminal here, same posture `AlertRow`/`CaseRow` give a
        // dead-end state).
        let legal: &[&str] = match self.status.as_str() {
            "assigned" => &["scored"],
            "scored" => &["closed", "returned"],
            _ => &[],
        };
        Some(legal.contains(&requested))
    }
}

pub fn qa_review_table() -> &'static nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, QaReviewRow> {
    static TABLE: std::sync::OnceLock<nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, QaReviewRow>> = std::sync::OnceLock::new();
    TABLE.get_or_init(|| {
        let table = nirdosha_guard_screens::GuardedTable::new(
            nirdosha_guard_mic::MemStoreDriver::new(),
            nirdosha_guard_registry::candidates(),
            nirdosha_guard_registry::dump().policies,
            "rtm-demo",
            std::env::temp_dir().join(format!("rtm-demo-audit-qa-{}.jsonl", std::process::id())),
            HUMAN_ROLES.iter().map(|r| r.to_string()).collect(),
            DEMO_TENANT,
            vec![],
        )
        .with_notify_hook(notify_into_inbox);
        // Demo bootstrap only (see `ModelRow`'s identical disclosure) --
        // one closed-item review already assigned to a real analyst id,
        // standing in for what `qa-read-closed`'s own sampling would have
        // produced from real alert/case closures.
        table.raw_driver_seed(DEMO_TENANT, &QaReviewRow { id: 1, review_id: "qa-001".into(), tenant_id: DEMO_TENANT.into(), item_ref: "alert:alert-001".into(), subject_user_id: "an".into(), rubric_scores: String::new(), result: String::new(), error_severity: String::new(), retraining_flag: false, feedback: String::new(), status: "assigned".into() });
        table
    })
}

