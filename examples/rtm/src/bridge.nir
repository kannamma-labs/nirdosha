            nirdosha_guard_registry::candidates(),
            nirdosha_guard_registry::dump().policies,
            "rtm-demo",
            std::env::temp_dir().join(format!("rtm-demo-audit-model-{}.jsonl", std::process::id())),
            HUMAN_ROLES.iter().map(|r| r.to_string()).collect(),
            DEMO_TENANT,
            corpus_approval_chains(),
        );
        // Real `model_artifact! { model rt_fraud_v1 { ... } }` values,
        // `40_scoring.nir:8-15`, transcribed by hand (the catalog record
        // itself carries `inputs`/`outputs` as opaque source text per
        // `model_artifact!`'s own doc comment, not a `Vec<String>` this
        // row could read directly).
        table.raw_driver_seed(DEMO_TENANT, &ModelRow {
            id: 1,
            model_id: "rt_fraud_v1".into(),
            format: "onnx".into(),
            threshold_alert: 0.85,
            shadow_mode: false,
