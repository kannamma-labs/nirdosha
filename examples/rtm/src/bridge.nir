// fields this catalog actually governs (`customer.kyc_status`,
// `alert.disposition_code`, `customer.risk_rating`,
// `transaction.currency`, `case.disposition`, `country_risk`) -- this
// row is `RefDataset`'s own three columns verbatim (`code`, `label`,
// `class`), not a re-derivation of those six reference bindings (no
// separate dataset exists for the binding itself, only for the
// enumerated values a bound field may take).
#[derive(Debug, Clone, Default, serde::Serialize, serde::Deserialize)]
pub struct RefDatasetRow {
    pub id: i64,
