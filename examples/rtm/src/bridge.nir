pub fn user_profile_table() -> &'static nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, UserProfileRow> {
    static TABLE: std::sync::OnceLock<nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, UserProfileRow>> = std::sync::OnceLock::new();
    TABLE.get_or_init(|| {
        let table = nirdosha_guard_screens::GuardedTable::new(
            nirdosha_guard_mic::MemStoreDriver::new(),
            nirdosha_guard_registry::candidates(),
            nirdosha_guard_registry::dump().policies,
            "rtm-demo",
            std::env::temp_dir().join(format!("rtm-demo-audit-user-profile-{}.jsonl", std::process::id())),
            HUMAN_ROLES.iter().map(|r| r.to_string()).collect(),
            DEMO_TENANT,
            vec![],
        );
        // One profile per demo login (`m01_auth.nir`'s `HUMAN_ROLES`
        // lowercased usernames, matching `Auth::user()`'s real value —
        // see `m01_auth.nir`'s `demo_users:` list), so `subject_scope()`
        // has a real row to find for whichever role signs in.
        for role in HUMAN_ROLES {
            let user_id = role.to_lowercase();
            table.raw_driver_seed(DEMO_TENANT, &UserProfileRow { id: 0, user_id: user_id.clone(), locale: "en-US".into(), tz: "UTC".into(), digest: true, quiet_hours: String::new() });
        }
        table
    })
}

