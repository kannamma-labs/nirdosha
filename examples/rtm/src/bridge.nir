            std::env::temp_dir().join(format!("rtm-demo-audit-refdata-{}.jsonl", std::process::id())),
            HUMAN_ROLES.iter().map(|r| r.to_string()).collect(),
            DEMO_TENANT,
            corpus_approval_chains(),
        );
        // Demo bootstrap only (see `ModelRow`'s identical disclosure) --
        // one seed row per `#[reference(...)]` binding this corpus
        // actually declares, standing in for whatever a real deployment's
        // initial refdata load would have populated.
        table.raw_driver_seed(DEMO_TENANT, &RefDatasetRow { id: 1, code: "USD".into(), label: "US Dollar".into(), class: "Internal".into() });
        table.raw_driver_seed(DEMO_TENANT, &RefDatasetRow { id: 2, code: "kyc_verified".into(), label: "KYC: Verified".into(), class: "Internal".into() });
        table.raw_driver_seed(DEMO_TENANT, &RefDatasetRow { id: 3, code: "country_risk:US".into(), label: "United States — Low".into(), class: "Internal".into() });
        table
    })
}

// ============================================================================
// M8 Detection Scenario & Rule Management — screens/m08_rules.nir's row
// type + table.
//
// `threshold-migrate` (`75_lineage.nir`): `for PolicyEngineer`, `action ==
