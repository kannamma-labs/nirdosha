// ============================================================================
// M21 Restricted / Downstream Views — screens/m21_restricted.nir's row
// type + table. RECONCILED with M11 Intervention (final Phase B batch):
// `PaymentRow` already carried every real `Payment` field
// (`10_domains.nir`'s full list) from the day M21 added it, so M11's own
// hold queue/decision screens read and write this SAME table rather than
// forking a second one — `cs-payment-status`'s masked view and M11's
// real intervention queue now share one real data plane, exactly the
// posture the plan called for. Only `check_invariant`/`transition_allowed`
// were missing (M21 never needed them; M11's `ops-decide-hold`/
// `ops-decide-hold-highvalue` do) — added below.
//
// `cs-payment-status` (`96_restricted_views.nir`): `for CsAgent`, `action
// == "read" && resource == "payment"`, `field_policy { allowed(status,
// hold_expires_at, currency) forbidden(amount, rail_ref, originator,
// beneficiary, hold_reason, decision_by, decision_rationale) }`.
// `Payment` is a real `#[dataset]` (`10_domains.nir`).
#[derive(Debug, Clone, Default, serde::Serialize, serde::Deserialize)]
pub struct PaymentRow {
    pub id: i64,
    pub payment_id: String,
    pub tenant_id: String,
    // T-02: `cs-payment-status` (`96_restricted_views.nir`) and
    // `ops-decide-hold` (`85_intervention.nir`) both `forbidden(...)`
    // every field below except `status`/`currency`/`hold_expires_at`.
    // `read_masks_from_field_policy` now synthesizes `MaskTransform::Drop`
    // (true key removal, not a `"[REDACTED]"` placeholder) for those --
    // `Option<T>`, not a bare masked-shaped `String`/`f64`, so a dropped
    // key decodes to `None` instead of a hard deserialize error, and
    // `skip_serializing_if` so it stays absent on the way back out.
    // `amount` was already flattened to `String` (not `f64`) for the
    // identical "masking always produces a JSON string" reason, before
    // this fix could remove the key outright.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub rail_ref: Option<String>,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub originator: Option<String>,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub beneficiary: Option<String>,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub amount: Option<String>,
    pub currency: String,
    pub status: String,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub hold_reason: Option<String>,
    pub hold_expires_at: i64,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub decision_by: Option<String>,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub decision_rationale: Option<String>,
}

impl GuardedEntity for PaymentRow {
    const RESOURCE: &'static str = "payment";
    fn row_id(&self) -> String {
        self.payment_id.clone()
    }
    fn field_policy_exempt() -> &'static [&'static str] {
        &["id", "payment_id"]
    }
    fn check_invariant(&self, name: &str) -> Option<bool> {
        match name {
            // `ops-decide-hold`'s own `requires invariant(rationale_present)`
            // -- this dataset's rationale field is `decision_rationale`,
            // not the generic `rationale` `AlertRow`/`CaseRow` use.
            "rationale_present" => Some(!self.decision_rationale.as_deref().unwrap_or("").is_empty()),
            // `00_core.nir`'s real `hold_reason_valid` [NEW: T-03] --
            // `ingest-create-hold` requires `hold_reason` non-empty, so
            // (unlike the disposition checks) empty is never valid here.
            "hold_reason_valid" => {
                let hold_reason = self.hold_reason.as_deref().unwrap_or("");
                Some(!hold_reason.is_empty() && crate::domains::HOLD_REASON_CODES.contains(&hold_reason))
            }
            _ => None,
        }
    }
    fn transition_allowed(&self, requested_status: &serde_json::Value) -> Option<bool> {
        let Some(requested) = requested_status.as_str() else { return Some(false) };
        // `10_domains.nir`'s declared `machine PaymentStatus` graph,
        // verbatim: `received -> held -> [released, blocked]; held ->
        // held;` (the comment on that last edge, "no self-loop
        // releases", documents intent for `ops-decide-hold`'s own
        // runtime revalidation at commit -- I3 -- not that the edge
        // itself is illegal; the machine as declared permits it).
        let legal: &[&str] = match self.status.as_str() {
            "" | "received" => &["held"], // "" -- same freshly-created-row convention as AlertRow
            "held" => &["released", "blocked", "held"],
            _ => &[],
        };
        Some(legal.contains(&requested))
    }
}

pub fn payment_table() -> &'static nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, PaymentRow> {
    static TABLE: std::sync::OnceLock<nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, PaymentRow>> = std::sync::OnceLock::new();
    TABLE.get_or_init(|| {
        let table = nirdosha_guard_screens::GuardedTable::new(
            nirdosha_guard_mic::MemStoreDriver::new(),
            nirdosha_guard_registry::candidates(),
            nirdosha_guard_registry::dump().policies,
            "rtm-demo",
            std::env::temp_dir().join(format!("rtm-demo-audit-payment-{}.jsonl", std::process::id())),
            HUMAN_ROLES.iter().chain(["SvcIngest"].iter()).map(|r| r.to_string()).collect(),
            DEMO_TENANT,
            // `override_release` (M11's `ops-decide-hold-highvalue`) --
            // was `vec![]` when M21 first added this table (that batch
            // never needed an escalation); real chain defs added now
            // that M11 does.
            corpus_approval_chains(),
        );
        // Demo bootstrap only (see `ModelRow`'s identical disclosure) --
        // a real `Payment` row for `cs-payment-status`'s masked read to
        // act on, standing in for what `ingest-create-hold` (M11,
        // unbuilt) would have produced.
        table.raw_driver_seed(DEMO_TENANT, &PaymentRow {
            id: 1, payment_id: "pay-001".into(), tenant_id: DEMO_TENANT.into(), rail_ref: Some("rtp-778812".into()),
            originator: Some("subj-77".into()), beneficiary: Some("subj-12".into()), amount: Some("4500.00".into()), currency: "USD".into(),
            status: "held".into(), hold_reason: Some("velocity".into()), hold_expires_at: 1_800_000_000, decision_by: None, decision_rationale: None,
        });
        table
    })
}

