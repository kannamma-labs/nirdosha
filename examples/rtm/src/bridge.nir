        table.raw_driver_seed(DEMO_TENANT, &CaseTaskRow { id: 1, task_id: "task-001".into(), tenant_id: DEMO_TENANT.into(), item_ref: "case:case-001".into(), task_type: "checklist".into(), title: "Confirm subject KYC on file".into(), detail: String::new(), assignee: "an".into(), due_date: "2026-10-01".into(), priority: "high".into(), status: "open".into(), blocked_reason: String::new(), completion_note: String::new() });
        table
