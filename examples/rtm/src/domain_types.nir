}

/// Declared/expected activity profile vs. the observed behavior it's
/// compared against (→ 5.5 deviation meters).
#[derive(Debug, Clone, PartialEq)]
pub struct ActivityProfile {
    pub expected_monthly_volume: f64,
    pub expected_txn_count: u32,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum RestrictionBand {
    None,
    Watch,
    Restricted,
    Exit,
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct NotifPrefs {
    pub digest: bool,
    pub quiet_hours: Option<String>,
}

/// Feeds only the `rationale_present` invariant fix in `00_core.nir` — the
/// doc's original signature (`&AlertUpdate`) never declared this type at all.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct AlertUpdate {
    pub rationale: String,
}

/// Local re-declaration of the guard's classification levels, so
/// `RefDataset.class` doesn't need `nirdosha-guard-core` as a runtime
/// dependency just for one field — this crate only takes it as a
/// dev-dependency, for `tests/guarded_ingest.rs`.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Classification {
    Public,
    Internal,
    Confidential,
    Restricted,
}
