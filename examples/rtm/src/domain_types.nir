/// What a QA review reads: an alert or a case, never the disposition
/// content itself (QA reads originals; it never edits them — see
/// `95_qa.nir`'s `qa-write-review` `forbidden(item_ref_content)`).
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum ItemRef {
    Alert(AlertId),
    Case(CaseId),
}

#[derive(Debug, Clone, Copy, PartialEq)]
pub struct Score(pub f64);

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum QaResult {
    Pass,
    Fail,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Severity {
    Low,
    Medium,
    High,
    Critical,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum TicketCategory {
    Access,
    Bug,
    Question,
    Other,
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct Address {
    pub line1: String,
    pub city: String,
    pub country: String,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum KycStatus {
    Pending,
    Verified,
    Rejected,
    Expired,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum RiskBand {
    Low,
    Medium,
    High,
    Critical,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum ScreeningStatus {
    Clear,
    PendingReview,
