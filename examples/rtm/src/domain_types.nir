// ============================================================================
// domain_types.nir — the ~30 primitive ID/enum/struct types
// `roles-N-guard_policy.md`'s `10_domains.nir` `#[dataset]` structs and
// `00_core.nir` invariants reference but never declare. Not part of the
// original doc — this is exactly the "real implementer supplies them" gap
// `rtm_policy_corpus.rs`'s own doc comment calls out.
//
// `CardToken`, `NationalId`, `SubjectId`, `DeviceId`, `Geo`, `CustomerName`,
// `Money` are declared via `#[classify]` in `00_core.nir` instead — kept
// there, verbatim from the doc, since they're already self-contained.
//
// `AlertStatus`/`CaseStatus`/`PaymentStatus`/`SarStatus` below are plain,
// hand-written enums — NOT generated by `workflow!`. `workflow!`
// (`nirdosha_guard_macros::workflow!`) only registers a `CatalogRegistration`
// documenting the machine; it emits no Rust type. These enums are declared
// independently (one variant per state named in the matching `workflow!`
// block in `00_core.nir`) purely so the `#[dataset]` structs below have a
// real field type — keeping them in sync with the `workflow!` blocks is a
// manual invariant, not something the compiler enforces today.
// ============================================================================

macro_rules! string_id {
    ($name:ident) => {
        #[derive(Debug, Clone, PartialEq, Eq, Hash)]
        pub struct $name(pub String);
    };
}

string_id!(TenantId);
string_id!(AccountId);
string_id!(TxnId);
string_id!(MerchantId);
string_id!(UserId);
string_id!(CaseId);
string_id!(AlertId);
string_id!(SarId);
string_id!(CustomerId);
string_id!(ListId);
string_id!(ChannelId);
string_id!(PolicyVersion);
string_id!(DispositionCode);
string_id!(CustomerRef);
string_id!(SubjectRef);
string_id!(ActivityCode);
string_id!(HoldReason);
string_id!(Locale);
string_id!(Tz);
string_id!(Date);
string_id!(Phone);

/// Epoch milliseconds — kept as a plain newtype rather than pulling in a
/// date/time crate this catalog-only corpus otherwise doesn't need.
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
pub struct Timestamp(pub u64);

/// ISO 4217 currency code. `is_iso_4217` is a real structural check (three
/// uppercase ASCII letters), not a stub that always returns `true` — good
/// enough to catch `"usd"`/`"US"`/`"12A"` without vendoring the full ISO list.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct CurrencyCode(pub String);

impl CurrencyCode {
    pub fn is_iso_4217(&self) -> bool {
        self.0.len() == 3 && self.0.bytes().all(|b| b.is_ascii_uppercase())
    }
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum TxnStatus {
    Pending,
    Authorized,
    Settled,
    Declined,
    Reversed,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum TxnChannel {
    Card,
    Wire,
    Ach,
    Rtp,
    Wallet,
}

/// One matched detection rule contributing to an alert's score.
#[derive(Debug, Clone, PartialEq)]
pub struct RuleHit {
    pub rule_id: String,
    pub weight: f64,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum AlertStatus {
    New,
    InProgress,
    ClosedFalsePositive,
    Escalated,
    PendingInfo,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum CaseStatus {
    Open,
    Investigating,
    ConfirmedFraud,
    FalsePositive,
    Escalate,
    SarFiled,
    Closed,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum CaseDisposition {
    ConfirmedFraud,
    FalsePositive,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum SarStatus {
    Draft,
    InReview,
    Filed,
    Rejected,
    DoNotFile,
    ContinuationDue,
    Ceased,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum HitDisposition {
