// ---- RTM live-demo plan, Phase A: guard-enforced screens ----
// `crate::nirdosha_roles::*` (what `crud_screens!`'s `requires role
// "..."` and every `RoleProof<R>` gate actually name) has to resolve at
// the crate root -- `core`'s own `nirdosha_rt::roles! { ... }`
// invocation expands to `nirdosha_roles` *inside* `mod core` (macros
// expand where they're written, not at the invoking crate's root), so
// without this re-export `crate::nirdosha_roles::Analyst` wouldn't
// exist even though `crate::core::nirdosha_roles::Analyst` does.
pub use core::nirdosha_roles;

