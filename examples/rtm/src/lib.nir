/// Prints what actually linked and registered — called from `main()` (and
/// available to anything else, e.g. a future `cargo nirdosha` integration)
/// so the corpus's presence is asserted from an explicit code path, not
/// left to depend on whether the binary happens to reference this crate by
/// name anywhere.
pub fn boot_banner() {
    let policy_count = nirdosha_guard_registry::POLICIES.len();
    let dump = nirdosha_guard_registry::dump();
    println!("rtm boot — real-time transaction monitoring (Nirdosha v2 dialect demo)");
    println!("  guard_policy! registrations : {policy_count}");
    println!("  approval_chain! chains      : {}", dump.approval_chains.len());
    println!("  stream_port! ports          : {}", dump.ports.len());
    println!("  window! features            : {}", dump.windows.len());
    println!("  model_artifact! models      : {}", dump.models.len());
    println!("  matcher! matchers           : {}", dump.matchers.len());
    println!("  mcp_tools! servers          : {}", dump.mcp_servers.len());
    println!("  purpose_taxonomy! codes     : {}", dump.purposes.len());

    assert!(policy_count >= 76, "expected at least 76 guard_policy! registrations, got {policy_count}");
}
