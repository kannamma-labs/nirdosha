nirdosha_rt::guard_policy! {
    allow "customer-restriction-create" for Analyst, ComplianceLead
    when action == "create" && resource == "customer_restriction"
    purpose(AmlInvestigation)
    obligate audit(full)
}

nirdosha_rt::guard_policy! {
    allow "unlock-request-create" for Analyst, ComplianceLead, Mlro, QaReviewer, OpsAnalyst, PolicyEngineer, Admin, Auditor, CsAgent, RmUser, RegulatorViewer
    when action == "create" && resource == "unlock_request"
    purpose(Operations)
    obligate audit(full)
}
