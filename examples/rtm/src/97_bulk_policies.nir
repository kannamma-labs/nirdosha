// ---- create-side policies for menus.toml routes whose write action was
// disclosed (V5) as unbacked once their read-side dataset landed above;
// each `for` list matches the screen's own `roles =` R/W subset exactly
// (screens-plan.md R4/V2), not a broader grant. ----

nirdosha_rt::guard_policy! {
    allow "evidence-doc-create" for Analyst
    when action == "create" && resource == "evidence_doc"
    purpose(AmlInvestigation)
    obligate audit(full)
}

nirdosha_rt::guard_policy! {
    allow "case-note-create" for Analyst, ComplianceLead, McpCopilot
    when action == "create" && resource == "case_note"
    purpose(AmlInvestigation)
    obligate audit(full)
}

nirdosha_rt::guard_policy! {
