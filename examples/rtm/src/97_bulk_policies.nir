// ============================================================================
// 97_bulk_policies.nir — Phase C read-only guard policies for the dataset
// tables declared in bridge.nir.  These policies intentionally do NOT grant
// write/delete paths; per-screen write handlers (where a real corpus workflow
// exists) live next to their owning module.  Every policy here backs at
// least one built/interim screen in screens-plan Phase C.
// ============================================================================

// ---- M1.6 / M18.x admin & platform config surfaces ----
nirdosha_rt::guard_policy! {
    allow "unlock-request-read" for Admin, ComplianceLead
    when action == "read" && resource == "unlock_request"
    purpose(Operations)
    cap(row_cap = 100)
    obligate audit(sampled)
}

nirdosha_rt::guard_policy! {
    allow "assignment-rules-read" for Admin, ComplianceLead
    when action == "read" && resource == "assignment_rules"
    purpose(PlatformOperations)
    cap(row_cap = 100)
    obligate audit(sampled)
}

nirdosha_rt::guard_policy! {
    allow "disposition-code-read" for Analyst, ComplianceLead, QaReviewer
    when action == "read" && resource == "disposition_code"
    purpose(AmlInvestigation)
    cap(row_cap = 100)
    obligate audit(sampled)
}

nirdosha_rt::guard_policy! {
    allow "notif-template-read" for Admin, ComplianceLead
    when action == "read" && resource == "notif_template"
    purpose(PlatformOperations)
    cap(row_cap = 100)
    obligate audit(sampled)
}

