// Control for race_probe_booking.nir: the *naive* check-then-insert
// version of the same room-booking invariant -- a separate `SELECT`
// (does any existing booking for this room overlap?) followed by a
// separate `INSERT`, with a `sleep_ms` gap between them modeling a real
// round trip, exactly the shape the "check-then-insert" pseudocode in
// RFC 0015's Motivation section describes in prose before the single-
// statement collapse is introduced. This file exists only to prove the
// test harness in race_probe_booking.nir actually detects a race when
// one exists -- the same role race_probe.nir plays opposite
// race_probe_atomic.nir. See RESULTS_BOOKING.md.
//
// Run it:
//   nirdosha build examples/killer_demo/race_probe_booking_naive.nir -o /tmp/race_probe_booking_naive
//   /tmp/race_probe_booking_naive

enum ErrorCode {
    DbError(str),
}

struct Text {
    value: str,
}

fn reset_booking_inner(conn: db) -> Result(Text, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS booking (id INTEGER PRIMARY KEY AUTOINCREMENT, room_id INTEGER, start_ts INTEGER, end_ts INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let cleared: Result(Text, ErrorCode) = match db_execute(conn, "DELETE FROM booking") {
        Ok(n) => Ok(Text("reset")),
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return cleared
}

fn reset_booking() -> Result(Text, ErrorCode) {
    return match db_connect("examples/killer_demo/race_probe_booking_naive.db") {
        Ok(conn) => reset_booking_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

fn count_bookings_inner(conn: db) -> Result(i64, ErrorCode) {
    let result: Result(i64, ErrorCode) = match db_query(conn, "SELECT COUNT(*) as c FROM booking WHERE room_id = 1") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "c") {
                Ok(c) => Ok(c),
                Err(e) => Err(DbError(e)),
            },
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

fn count_bookings() -> Result(i64, ErrorCode) {
    return match db_connect("examples/killer_demo/race_probe_booking_naive.db") {
        Ok(conn) => count_bookings_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

fn overlap_count_inner(conn: db) -> Result(i64, ErrorCode) {
    let result: Result(i64, ErrorCode) = match db_query(conn, "SELECT COUNT(*) as c FROM booking a JOIN booking b ON a.id < b.id AND a.room_id = b.room_id WHERE a.room_id = 1 AND NOT (a.end_ts <= b.start_ts OR a.start_ts >= b.end_ts)") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "c") {
                Ok(c) => Ok(c),
                Err(e) => Err(DbError(e)),
            },
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

fn overlap_count() -> Result(i64, ErrorCode) {
    return match db_connect("examples/killer_demo/race_probe_booking_naive.db") {
        Ok(conn) => overlap_count_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

// Naive: a separate overlap-check SELECT, a sleep_ms gap (modeling a
// real round trip -- application logic, a second query, whatever would
// realistically separate "check" from "write"), then an unconditional
// INSERT. Two concurrent callers can both run the SELECT, both see
// zero conflicts, and both insert.
fn try_book_inner(conn: db, room_id: i64, start_ts: i64, end_ts: i64) -> Result(i64, ErrorCode) {
    let overlap: Result(i64, ErrorCode) = match db_query(conn, "SELECT COUNT(*) as c FROM booking WHERE room_id = ? AND NOT (end_ts <= ? OR start_ts >= ?)", room_id, start_ts, end_ts) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "c") {
                Ok(c) => Ok(c),
                Err(e) => Err(DbError(e)),
            },
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(DbError(e)),
    }
    sleep_ms(2) // the gap a single INSERT ... SELECT ... WHERE NOT EXISTS closes
    let inserted: Result(i64, ErrorCode) = match overlap {
        Ok(c) => if c > 0 {
            Ok(0)
        } else {
            match db_execute(conn, "INSERT INTO booking (room_id, start_ts, end_ts) VALUES (?, ?, ?)", room_id, start_ts, end_ts) {
                Ok(n) => Ok(n),
                Err(e) => Err(DbError(e)),
            }
        },
        Err(e) => Err(e),
    }
    stop conn
    return inserted
}

fn try_book(room_id: i64, start_ts: i64, end_ts: i64) -> Result(i64, ErrorCode) {
    return match db_connect("examples/killer_demo/race_probe_booking_naive.db") {
        Ok(conn) => try_book_inner(conn, room_id, start_ts, end_ts),
        Err(e) => Err(DbError(e)),
    }
}

fn worker(room_id: i64, iterations: i64) -> i64 {
    let i: i64 = 0
    let successes: i64 = 0
    while i < iterations {
        let start_ts: i64 = i * 10
        let end_ts: i64 = start_ts + 10
        let r: Result(i64, ErrorCode) = try_book(room_id, start_ts, end_ts)
        let ok: bool = match r {
            Ok(n) => n >= 1,
            Err(_) => false,
        }
        if ok {
            successes = successes + 1
        }
        i = i + 1
    }
    return successes
}

fn main() {
    let setup: Result(Text, ErrorCode) = reset_booking()
    match setup {
        Ok(n) => print("booking table reset"),
        Err(e) => print("setup error"),
    }

    let t1: thread i64 = spawn worker(1, 250)
    let t2: thread i64 = spawn worker(1, 250)
    let t3: thread i64 = spawn worker(1, 250)
    let t4: thread i64 = spawn worker(1, 250)
    let t5: thread i64 = spawn worker(1, 250)
    let t6: thread i64 = spawn worker(1, 250)
    let t7: thread i64 = spawn worker(1, 250)
    let t8: thread i64 = spawn worker(1, 250)

    let s1: i64 = join t1
    let s2: i64 = join t2
    let s3: i64 = join t3
    let s4: i64 = join t4
    let s5: i64 = join t5
    let s6: i64 = join t6
    let s7: i64 = join t7
    let s8: i64 = join t8

    print("successful bookings (sum across workers, expected 250):")
    print(s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8)

    let final_count: Result(i64, ErrorCode) = count_bookings()
    print("final booking row count for room 1 (expected 250):")
    match final_count {
        Ok(n) => print(n),
        Err(e) => print("error reading count"),
    }

    let overlaps: Result(i64, ErrorCode) = overlap_count()
    print("overlapping booking pairs for room 1 (expect > 0 if this races):")
    match overlaps {
        Ok(n) => print(n),
        Err(e) => print("error reading overlap count"),
    }
}
