// Feature: the "Nirdosha Ops Console" -- one coherent program combining
// every real, compiled Track B capability landed this session into a
// single showcase, per the original ask: real Postgres CRUD, a real
// HTTP call, real role-based identity with a per-role `landing` screen,
// and a real workflow-gated, `transact`-backed payment disbursement.
//
// **Honest scope, stated up front, not discovered later**: this program
// is verified by compiling and *running the binary directly*
// (`crates/compiler/tests/nirdosha_ops_console.rs`'s
// `nirdosha_ops_console_runs_the_full_scenario_against_real_postgres_and_http`,
// plus a genuine crash-and-replay test against a second, separately
// compiled binary), not by serving it and clicking through a browser.
// Compiled `serve`'s dispatch-table framework (`crates/compiled-serve`,
// ROADMAP B8) is real and tested on its own but not yet wired to
// `codegen.rs` (that crate's own module doc has the reason) -- so
// nothing here actually answers an HTTP request from this program's own
// compiled binary yet. The `landing`/`screen`/`dashboard` declarations
// below are real and typechecked, and `nirdosha emit-ui` against this
// file produces a real `LANDING` data table a served bundle would use
// (verified directly in the same test file, by inspecting
// `ui_gen::generate`'s own output) -- but "each role lands on their own
// screen" is demonstrated as real, checked *data*, not a live
// click-through.
//
// **One real, previously-undiscovered codegen bug found while writing
// this, disclosed rather than fixed** (`codegen.rs::declare_named_type`'s
// own doc comment has the full detail): `match <result_expr> { Ok(j) =>
// Ok(j), Err(e) => Err(e) }` -- re-wrapping a `Result` where an arm's
// own tail expression directly constructs `Ok(...)`/`Err(...)` -- hits a
// real compiler panic, independent of which concrete types are
// involved. Every `wrap_ok_*`/`wrap_err_*` helper function below exists
// specifically to route around this: a call expression's return type is
// already known from its own signature, sidestepping whatever inference
// gap the bare constructor hits.

struct Text {
    value: str,
}

struct ErrMsg {
    value: str,
}

// ---- domain data --------------------------------------------------------

struct PurchaseOrder {
    id: i64,
    vendor: str,
    amount_cents: i64,
}

struct AdminHome {
    id: i64,
}

struct FinanceQueue {
    id: i64,
}

struct HomeScreen {
    id: i64,
}

// ---- Postgres-backed CRUD (real `db`, Phase 1/B2) -----------------------
//
// `ensure_schema`'s own `CREATE TABLE IF NOT EXISTS` is inlined into
// each `run_*` function below, not factored into a shared helper taking
// `conn: db` as a parameter -- passing an affine `db` handle into
// another function moves it (this language has no `&db` borrow form
// yet), so a later statement in the *same* function reusing `conn`
// after such a call is a real, caught `use of conn after it was moved`
// ownership error, found by actually trying the factored version first.

fn create_purchase_order(vendor: Text, amount_cents: i64) -> Text requires(role: "admin") {
    return match db_connect("postgres://postgres@127.0.0.1:5432/postgres") {
        Err(e) => Text(e),
        Ok(conn) => run_create(conn, vendor, amount_cents),
    }
}

fn run_create(conn: db, vendor: Text, amount_cents: i64) -> Text {
    let schema_ok: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS purchase_orders (id SERIAL PRIMARY KEY, vendor TEXT NOT NULL, amount_cents BIGINT NOT NULL)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let inserted: i64 = match db_execute(conn, "INSERT INTO purchase_orders (vendor, amount_cents) VALUES (?, ?)", vendor.value, amount_cents) {
        Ok(n) => n,
        Err(e) => -1,
    }
    stop conn
    return Text(vendor.value)
}

fn list_purchase_order() -> Result(json, ErrMsg) {
    return match db_connect("postgres://postgres@127.0.0.1:5432/postgres") {
        Err(e) => wrap_err_json(ErrMsg(e)),
        Ok(conn) => run_list(conn),
    }
}

// `codegen.rs::declare_named_type`'s own doc comment has the full
// story: `match ... { Ok(x) => Ok(x), ... }` -- re-wrapping a `Result`
// via a bare `Ok(...)`/`Err(...)` as a match arm's own tail expression
// -- hits a real, pre-existing codegen bug found this session. Routing
// through these two named helpers instead is the disclosed workaround.
fn wrap_ok_json(j: json) -> Result(json, ErrMsg) {
    return Ok(j)
}

fn wrap_err_json(e: ErrMsg) -> Result(json, ErrMsg) {
    return Err(e)
}

fn run_list(conn: db) -> Result(json, ErrMsg) {
    let schema_ok: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS purchase_orders (id SERIAL PRIMARY KEY, vendor TEXT NOT NULL, amount_cents BIGINT NOT NULL)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(json, ErrMsg) = match db_query(conn, "SELECT vendor, amount_cents FROM purchase_orders ORDER BY id") {
        Ok(rows) => wrap_ok_json(rows),
        Err(e) => wrap_err_json(ErrMsg(e)),
    }
    stop conn
    return result
}

fn stat_purchase_order_count() -> i64 {
    return match db_connect("postgres://postgres@127.0.0.1:5432/postgres") {
        Err(e) => -1,
        Ok(conn) => run_count(conn),
    }
}

fn run_count(conn: db) -> i64 {
    let schema_ok: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS purchase_orders (id SERIAL PRIMARY KEY, vendor TEXT NOT NULL, amount_cents BIGINT NOT NULL)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let count: i64 = match db_query(conn, "SELECT COUNT(*) AS n FROM purchase_orders") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "n") {
                Ok(n) => n,
                Err(e) => -1,
            },
            Err(e) => -1,
        },
        Err(e) => -1,
    }
    stop conn
    return count
}

// ---- identity + per-role landing (real `check_role`, B4; `landing`, RFC 0010) --

fn admin_identity() -> VerifiedIdentity {
    return VerifiedIdentity("cfo-1", "https://mock-idp.local", "ops-console", 9999999999, 0, "{\"roles\":[\"admin\"]}")
}

fn finance_identity() -> VerifiedIdentity {
    return VerifiedIdentity("clerk-1", "https://mock-idp.local", "ops-console", 9999999999, 0, "{\"roles\":[\"finance\"]}")
}

fn is_admin(identity: VerifiedIdentity) -> bool {
    return match check_role(identity, "admin") {
        Ok(role) => true,
        Err(e) => false,
    }
}

fn is_finance(identity: VerifiedIdentity) -> bool {
    return match check_role(identity, "finance") {
        Ok(role) => true,
        Err(e) => false,
    }
}

// ---- workflow-gated, `transact`-backed disbursement (real `workflow`
// Layer 1 + real `transact` durability/replay, B10/B1) -------------------
//
// A real `http_post` to a local mock webhook (`127.0.0.1:18099`, this
// program's own fixed port -- the test harness binds a real listener
// there before running the compiled binary) stands in for a payment
// gateway's own webhook. `commit`'s `INSERT ... ON CONFLICT (txn_id) DO
// NOTHING` is the idempotency guard `docs/adr/0009`'s own replay design
// requires: a replayed `commit` re-running against an already-committed
// `txn_id` must be a safe no-op, not a double disbursement.

fn notify_webhook(txn_id: str, amount_cents: i64) -> i64 {
    return match http_post("127.0.0.1", 18099, "/webhook", "payment") {
        Ok(resp) => resp.status,
        Err(e) => -1,
    }
}

fn check_response(status: i64) -> bool {
    return status == 200
}

// `commit`'s own return type is genuinely unconstrained
// (`docs/TRANSACT.md`) -- made `Result(i64, ErrMsg)` here specifically
// (not a bare `i64`) so a real failure actually engages
// `Codegen::emit_call_with_retry`'s bounded retry-with-backoff and, on
// exhaustion, leaves a real `commit_pending` row for replay
// (`docs/adr/0009-transact-durability-and-replay.md`) -- a bare scalar
// return would make every attempt "succeed" unconditionally by this
// same mechanism's own design (`emit_call_with_retry`'s own doc
// comment: a non-`Result` return calls once, unconditionally
// successful), which would make this file's own crash/replay test
// (`crates/compiler/tests/nirdosha_ops_console.rs`) vacuous.
fn wrap_ok_i64(n: i64) -> Result(i64, ErrMsg) {
    return Ok(n)
}

fn wrap_err_i64(e: ErrMsg) -> Result(i64, ErrMsg) {
    return Err(e)
}

fn record_disbursement(txn_id: str, po_id: i64, amount_cents: i64) -> Result(i64, ErrMsg) {
    return match db_connect("postgres://postgres@127.0.0.1:5432/postgres") {
        Err(e) => wrap_err_i64(ErrMsg(e)),
        Ok(conn) => run_record_disbursement(conn, txn_id, po_id, amount_cents),
    }
}

fn run_record_disbursement(conn: db, txn_id: str, po_id: i64, amount_cents: i64) -> Result(i64, ErrMsg) {
    let schema_ok: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS disbursements (txn_id TEXT PRIMARY KEY, po_id BIGINT NOT NULL, amount_cents BIGINT NOT NULL)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrMsg) = match db_execute(conn, "INSERT INTO disbursements (txn_id, po_id, amount_cents) VALUES (?, ?, ?) ON CONFLICT (txn_id) DO NOTHING", txn_id, po_id, amount_cents) {
        Ok(n) => wrap_ok_i64(n),
        Err(e) => wrap_err_i64(ErrMsg(e)),
    }
    stop conn
    return result
}

fn log_disbursement_failure(txn_id: str, po_id: i64) -> unit {
    print("disbursement failed", txn_id, po_id)
}

fn disburse(instance_id: i64, amount_cents: i64) -> bool {
    return transact {
        network:    notify_webhook(txn_id, amount_cents)
        verify:     check_response(network)
        commit:     record_disbursement(txn_id, instance_id, amount_cents)
        compensate: log_disbursement_failure(txn_id, instance_id)
    }
}

// `on_entry`'s only implicit binding is `instance_id` (Layer 1's own
// disclosed restriction -- `52_compiled_workflow_state_machine.nir`'s
// own doc comment: no non-empty `data { ... }` to carry a real amount
// through), so the disbursement amount here is fixed, not read back
// from the approved purchase order itself.
fn disburse_on_approval(instance_id: i64) -> unit {
    let ok: bool = disburse(instance_id, 250000)
    print("disbursement", instance_id, ok)
}

workflow Disbursement {
    state Draft {
        on Approve -> Approved
    }
    state Approved terminal {
        on_entry {
            disburse_on_approval(instance_id)
        }
    }
}

fn advance_disbursement_now(identity: VerifiedIdentity, instance_id: i64, event: DisbursementEvent) -> Result(bool, WorkflowActionError) {
    return match json_parse("{}") {
        Ok(payload) => advance_disbursement(identity, instance_id, event, payload),
        Err(e) => Err(NoSuchTransition()),
    }
}

screen PurchaseOrder {
    title: "Purchase Orders"
    list: list_purchase_order
    create: create_purchase_order
    paginate {
        page_size: 25
        total: stat_purchase_order_count
    }
}

screen AdminHome {
    title: "Admin Home"
}

screen FinanceQueue {
    title: "Finance Queue"
}

screen HomeScreen {
    title: "Home"
}

dashboard {
    tile "Open POs" -> stat_purchase_order_count
}

landing {
    role("admin") -> AdminHome
    role("finance") -> FinanceQueue
    default -> HomeScreen
}

serve {
    expose stat_purchase_order_count
}

// `create_purchase_order` is `requires(role: "admin")` -- reaching it at
// all needs a real `acquire`, not a direct call (`f` below is the real
// callable value `acquire` hands back on success, same pattern
// `examples/features/50_field_masking_and_check_role.nir` already
// establishes).
fn create_as_admin(vendor: Text, amount_cents: i64) -> Text {
    return match check_role(admin_identity(), "admin") {
        Err(e) => Text(e),
        Ok(proof) => match acquire create_purchase_order(proof) {
            Err(msg) => Text(msg),
            Ok(f) => f(vendor, amount_cents),
        },
    }
}

// The same call, attempted with a `finance`-only identity -- `acquire`
// itself must refuse it (no `RoleView` proving "admin" exists), a real
// `Err`, never a trap.
fn create_as_finance_is_denied() -> bool {
    return match check_role(finance_identity(), "finance") {
        Err(e) => false,
        Ok(finance_proof) => match acquire create_purchase_order(finance_proof) {
            Err(msg) => true,
            Ok(f) => false,
        },
    }
}

fn main() {
    print(is_admin(admin_identity()))     // 1
    print(is_finance(admin_identity()))   // 0
    print(is_admin(finance_identity()))   // 0
    print(is_finance(finance_identity())) // 1

    // `acquire` refuses a `finance`-only `RoleView` against an
    // `admin`-gated function -- real RBAC, not just a role-string check.
    print(create_as_finance_is_denied()) // 1 (true)

    // Real Postgres CRUD: create two rows, then read the count and the
    // list back for real.
    let created1: Text = create_as_admin(Text("Acme Robotics"), 125000)
    print(created1.value) // Acme Robotics
    let created2: Text = create_as_admin(Text("Globex Supplies"), 48000)
    print(created2.value) // Globex Supplies

    let count: i64 = stat_purchase_order_count()
    print(count >= 2) // 1 (true) -- >= not == : this table isn't dropped between runs

    let listed: Result(json, ErrMsg) = list_purchase_order()
    print(match listed {
        Err(e) => false,
        Ok(rows) => match json_array_len(rows) {
            Err(e) => false,
            Ok(n) => n >= 2,
        },
    }) // 1 (true)

    // Workflow-gated, `transact`-backed disbursement: start a real
    // `Disbursement` instance, approve it (a real state transition,
    // `Draft` -> `Approved`), which runs `Approved`'s own `on_entry` --
    // `disburse_on_approval`, a real `http_post` to the local mock
    // webhook + a real durable Postgres write, all through `transact`.
    let identity: VerifiedIdentity = admin_identity()
    let instance_id: i64 = match start_disbursement(None(), DisbursementData()) {
        Ok(id) => id,
        Err(e) => -1,
    }
    print(instance_id > 0) // 1 (true)

    let approved: bool = match advance_disbursement_now(identity, instance_id, Approve()) {
        Err(e) => false,
        Ok(v) => v,
    }
    print(approved) // 1 (true) -- disbursement's own real "disbursement <id> true" line printed first, from on_entry
}
