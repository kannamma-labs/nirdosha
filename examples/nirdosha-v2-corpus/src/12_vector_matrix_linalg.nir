//! v2 of `examples/features/12_vector_matrix_linalg.nir` — the Phase-2
//! dense linear-algebra builtins, now real code in the prelude
//! (`nirdosha-rt`), not interpreter intrinsics.

use nirdosha_rt::prelude::*;

fn main() {
    let v = Vector([1.0, 2.0, 3.0]);
    let w = Vector([4.0, 5.0, 6.0]);

    println!("{}", dot(&v, &w)); // 32
    println!("{}", cross(&v, &w)); // [-3, 6, -3]
    println!("{}", len(&v)); // 3
    println!("{}", sum(&v)); // 6
    println!("{}", norm(&v)); // sqrt(14)
    println!("{}", norm1(&v)); // 6
    println!("{}", norm_inf(&v)); // 3

    let m = Matrix([[1.0, 2.0], [3.0, 4.0]]);
    println!("{}", transpose(&m)); // [[1, 3], [2, 4]]
    println!("{}", trace(&m)); // 5
    println!("{}", det(&m)); // -2
    println!("{}", inv(&m)); // [[-2, 1], [1.5, -0.5]]
    println!("{}", is_square(&m)); // true
    println!("{}", frobenius_norm(&m)); // sqrt(1+4+9+16)

    let sym = Matrix([[1.0, 2.0], [2.0, 1.0]]);
    println!("{}", is_symmetric(&sym)); // true
    let diag = Matrix([[5.0, 0.0], [0.0, 5.0]]);
    println!("{}", is_diag(&diag)); // true

    println!("{}", zeros::<3>()); // [0, 0, 0]
    println!("{}", ones::<2, 2>()); // [[1, 1], [1, 1]]
    println!("{}", identity::<3>()); // 3x3 identity

    // Solve [[2,0],[0,3]] * x = [4,9] -- x = [2, 3]
    let a = Matrix([[2.0, 0.0], [0.0, 3.0]]);
    let b = Vector([4.0, 9.0]);
    println!("{}", solve(&a, &b)); // [2, 3]
    println!("{}", rank(&a)); // 2
}
