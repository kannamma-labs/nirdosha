//! v2 of `examples/features/54_compiled_workflow_escalation.nir` —
//! per-state `sla_seconds` + the synthesized `list_<workflow>_overdue`,
//! driving the disclosed "external scheduler" pattern: poll the
//! overdue query, then `advance_<workflow>` what it reports.

use nirdosha_rt::prelude::*;
use nirdosha_v2::{identity_with_roles, json_parse, new_instance_id, Json, VerifiedIdentity, WorkflowActionError};

#[derive(Clone)]
enum IncidentEvent {
    Escalate,
    Resolve,
}

#[derive(Clone, PartialEq)]
enum IncidentState {
    Open,
    Escalated,
    Resolved,
}

/// nirdosha:workflow {"name":"Incident","states":{"Open":{"sla_seconds":1,"on_entry":"log_opened","transitions":{"Escalate":"Escalated","Resolve":"Resolved"}},"Escalated":{"on_entry":"log_escalated","transitions":{"Resolve":"Resolved"}},"Resolved":{"terminal":true,"on_entry":"log_resolved"}}}
#[derive(Clone)]
struct IncidentData {}

struct InstanceRecord {
    state: IncidentState,
    entered_at: std::time::Instant,
}

fn instances() -> &'static std::sync::Mutex<std::collections::HashMap<i64, InstanceRecord>> {
    static STORE: std::sync::OnceLock<
        std::sync::Mutex<std::collections::HashMap<i64, InstanceRecord>>,
    > = std::sync::OnceLock::new();
    STORE.get_or_init(|| std::sync::Mutex::new(std::collections::HashMap::new()))
}

/// Per-state SLA, like the declaration reads: only `Open` has one.
fn sla_seconds(state: &IncidentState) -> Option<u64> {
    match state {
        IncidentState::Open => Some(1),
        _ => None,
    }
}

fn log_opened(instance_id: i64) {
    println!("incident {instance_id} opened");
}

fn log_escalated(instance_id: i64) {
    println!("incident {instance_id} escalated to manager");
}

fn log_resolved(instance_id: i64) {
    println!("incident {instance_id} resolved");
}

fn start_incident(_identity: Option<VerifiedIdentity>, _data: IncidentData) -> Result<i64, WorkflowActionError> {
    let id = new_instance_id();
    instances().lock().unwrap().insert(
        id,
        InstanceRecord { state: IncidentState::Open, entered_at: std::time::Instant::now() },
    );
    log_opened(id);
    Ok(id)
}

fn advance_incident(
    _identity: VerifiedIdentity,
    instance_id: i64,
    event: IncidentEvent,
    _payload: Json,
) -> Result<bool, WorkflowActionError> {
    let mut store = instances().lock().unwrap();
    let record = store
        .get_mut(&instance_id)
        .ok_or(WorkflowActionError::InstanceNotFound)?;
    match (&record.state, &event) {
        (IncidentState::Open, IncidentEvent::Escalate) => {
            record.state = IncidentState::Escalated;
            record.entered_at = std::time::Instant::now();
            log_escalated(instance_id);
            Ok(true)
        }
        (IncidentState::Open, IncidentEvent::Resolve)
        | (IncidentState::Escalated, IncidentEvent::Resolve) => {
            record.state = IncidentState::Resolved;
            record.entered_at = std::time::Instant::now();
            log_resolved(instance_id);
            Ok(true)
        }
        _ => Err(WorkflowActionError::NoSuchTransition),
    }
}

/// The synthesized `list_<workflow>_overdue` — real per-state SLA
/// checking against real wall-clock age.
fn list_incident_overdue() -> Result<Json, String> {
    let store = instances().lock().unwrap();
    let mut rows = Vec::new();
    for (id, record) in store.iter() {
        if let Some(sla) = sla_seconds(&record.state) {
            let age = record.entered_at.elapsed().as_secs();
            if age >= sla {
                rows.push(format!(
                    "{{\"instance_id\": {id}, \"state\": \"{}\", \"age_seconds\": {age}}}",
                    match record.state {
                        IncidentState::Open => "Open",
                        IncidentState::Escalated => "Escalated",
                        IncidentState::Resolved => "Resolved",
                    }
                ));
            }
        }
    }
    Ok(format!("[{}]", rows.join(", ")))
}

fn advance_now(
    identity: &VerifiedIdentity,
    instance_id: i64,
    event: IncidentEvent,
) -> Result<bool, WorkflowActionError> {
    match json_parse("{}") {
        Ok(payload) => advance_incident(identity.clone(), instance_id, event, payload),
        Err(_e) => Err(WorkflowActionError::NoSuchTransition),
    }
}

fn instance_is_overdue(j: &Json, target_id: i64) -> bool {
    use nirdosha_v2::{json_array_get, json_get_i64};
    match json_array_get(j, 0) {
        Ok(item) => match json_get_i64(&item, "instance_id") {
            Ok(id) => id == target_id,
            Err(_e) => false,
        },
        Err(_e) => false,
    }
}

fn main() {
    let identity = identity_with_roles("scheduler", "");

    let instance_id: i64 = match start_incident(None, IncidentData {}) {
        Ok(id) => id,
        Err(_e) => -1,
    };
    println!("{instance_id}"); // 1

    // Not overdue yet — `entered_at` is "now".
    match list_incident_overdue() {
        Ok(j) => println!("{j}"), // []
        Err(_e) => println!("overdue query failed"),
    }

    sleep_ms(1100);

    // A real stale instance, real JSON, straight from the store.
    let is_overdue: bool = match list_incident_overdue() {
        Ok(j) => instance_is_overdue(&j, instance_id),
        Err(_e) => false,
    };
    println!("{is_overdue}"); // true

    // The realistic escalation call.
    let escalated: bool = match advance_now(&identity, instance_id, IncidentEvent::Escalate) {
        Err(_e) => false,
        Ok(v) => v,
    };
    println!("{escalated}"); // true

    // `Escalated` declares no `sla_seconds` — structurally never
    // reported overdue, proving the check is per-state.
    match list_incident_overdue() {
        Ok(j) => println!("{j}"), // []
        Err(_e) => println!("overdue query failed"),
    }

    let resolved: bool = match advance_now(&identity, instance_id, IncidentEvent::Resolve) {
        Err(_e) => false,
        Ok(v) => v,
    };
    println!("{resolved}"); // true
}
