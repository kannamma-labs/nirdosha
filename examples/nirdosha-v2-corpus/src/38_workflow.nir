//! v2 of `examples/features/38_workflow.nir` — a durable state machine
//! with an **owner-gated** state: only an identity carrying
//! `role("finance_director")` may advance `Pending`, `Err(NotStateOwner)`
//! on a mismatch, never a trap.
//!
//! **The encoding:** the `workflow` block is a `nirdosha:workflow`
//! claim (with the `owner` role recorded per state); the executable
//! half is the desugared Rust `workflow_lower` synthesizes —
//! `start_approval`/`advance_approval`, `ApprovalData`, `ApprovalEvent`
//! — hand-written here, generated by the proprietary compiler
//! post-migration.
//!
//! Pre-migration: the full behavior runs — submit gets instance 1,
//! the finance-director identity satisfies the owner gate, `Approve`
//! fires the on_entry log. Post-migration: the same, with a durable
//! store, and `serve` auto-exposes `POST /api/<fn>` over the fns.

use nirdosha_v2::{
    json_parse, mock_issue_token, new_instance_id, oidc_validate_token,
    VerifiedIdentity, WorkflowActionError,
};

fn log_decision(instance_id: i64, amount: i64) {
    println!("approval {instance_id} for amount {amount}");
}

/// nirdosha:workflow {"name":"Approval","data":{"struct":"ApprovalData","fields":{"amount":"i64"}},"states":{"Pending":{"owner":"finance_director","transitions":{"Approve":"Approved","Reject":"Rejected"}},"Approved":{"terminal":true,"on_entry":"log_decision"},"Rejected":{"terminal":true}}}
// `Clone`: SharedTable reads clone values out (no reference escapes the
// critical section).
#[derive(Clone)]
struct ApprovalData {
    amount: i64,
}

#[allow(dead_code)]
enum ApprovalEvent {
    Approve,
    Reject,
}

#[derive(Clone, PartialEq)]
enum ApprovalState {
    Pending,
    Approved,
    Rejected,
}

use nirdosha_rt::prelude::SharedTable;
fn instances() -> &'static SharedTable<i64, (ApprovalData, ApprovalState)> {
    static STORE: std::sync::OnceLock<SharedTable<i64, (ApprovalData, ApprovalState)>> = std::sync::OnceLock::new();
    STORE.get_or_init(SharedTable::new)
}

// `workflow_lower`'s synthesized `start_<w>`.
fn start_approval(
    _identity: Option<VerifiedIdentity>,
    data: ApprovalData,
) -> Result<i64, WorkflowActionError> {
    let id = new_instance_id();
    instances().insert(id, (data, ApprovalState::Pending));
    Ok(id)
}

// `workflow_lower`'s synthesized `advance_<w>` — with the disclosed
// leading `identity` param the owner-gated state requires.
fn advance_approval(
    identity: &VerifiedIdentity,
    instance_id: i64,
    decision: ApprovalEvent,
    _payload: String,
) -> Result<bool, WorkflowActionError> {
    // The Pending state's `owner: role("finance_director")` — checked
    // at runtime, `Err(NotStateOwner)` on a mismatch, never a trap.
    if !identity.roles.iter().any(|r| r == "finance_director") {
        return Err(WorkflowActionError::NotStateOwner);
    }
    let (approved, amount) = instances().update(&instance_id, |entry| {
        let Some((data, state)) = entry else {
            return Err(WorkflowActionError::NoSuchTransition);
        };
        if *state != ApprovalState::Pending {
            return Err(WorkflowActionError::NoSuchTransition);
        }
        let approved = match decision {
            ApprovalEvent::Approve => true,
            ApprovalEvent::Reject => false,
        };
        let amount = data.amount;
        *state = if approved {
            ApprovalState::Approved
        } else {
            ApprovalState::Rejected
        };
        Ok((approved, amount))
    })?;
    // The on_entry log runs after the update returns — outside the
    // critical section, exactly where the old `drop(store)` placed it.
    if approved {
        log_decision(instance_id, amount); // Approved's on_entry
    }
    Ok(true)
}

// The thin, `emit-ui`-friendly wrappers.
fn submit_approval(amount: i64) -> Result<i64, WorkflowActionError> {
    start_approval(None, ApprovalData { amount })
}

fn decide_approval(
    identity: &VerifiedIdentity,
    instance_id: i64,
    decision: ApprovalEvent,
) -> Result<bool, WorkflowActionError> {
    match json_parse("{}") {
        Ok(payload) => advance_approval(identity, instance_id, decision, payload),
        Err(_e) => Err(WorkflowActionError::NoSuchTransition),
    }
}

fn main() {
    let jwks = r#"{"keys":[{"kid":"key1","kty":"oct","k":"bXktc2VjcmV0LWtleQ"}]}"#;
    let issuer = "https://mock-idp.local";
    let audience = "features-demo";
    let claims = r#"{"roles":["finance_director"]}"#;
    let token = match mock_issue_token("finance-user", issuer, audience, 1700000000, 999999999, claims, jwks) {
        Ok(t) => t,
        Err(_e) => String::new(),
    };

    let instance_id = match submit_approval(250000) {
        Ok(id) => id,
        Err(_e) => -1,
    };
    println!("{instance_id}"); // 1 — the workflow's own durable instance id

    let approved = match oidc_validate_token(&token, issuer, audience, jwks) {
        Ok(identity) => match decide_approval(&identity, instance_id, ApprovalEvent::Approve) {
            Ok(ok) => ok,
            Err(_e) => false,
        },
        Err(_e) => false,
    };
    println!("{approved}"); // true — also ran Approved's on_entry
}