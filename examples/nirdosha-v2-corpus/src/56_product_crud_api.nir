//! v2 example: a real Product CRUD + categorical-action REST API,
//! served by `nirdosha_rt::web::Router` — `GET /openapi.json` exists
//! automatically, with no opt-in step. Combines everything built for
//! this: per-field validators, `cost_cents` masking via
//! `Option<&RoleProof<Admin>>`, and `is_approved`'s two transitions
//! generated by `nirdosha_rt::categorical_actions!` (RFC 0020 addendum:
//! Road 1 — the generated `approve_product`/`disapprove_product` — is
//! the only thing that decides access; the router's OpenAPI role
//! annotation is a Road 2 read of the same `R::NAME`, never an
//! independent input).

use std::collections::HashMap;
use std::sync::{Mutex, OnceLock};

use nirdosha_rt::{Request, Response, RoleProof, Router};
use nirdosha_v2::{auth_from_identity, mask_unless, new_instance_id, oidc_validate_token};

nirdosha_rt::roles! {
    Admin = "admin";
    Approver = "approver";
    ComplianceOfficer = "compliance_officer";
}

const ISSUER: &str = "https://mock-idp.local";
const AUDIENCE: &str = "product-api";
const JWKS: &str = r#"{"keys":[{"kid":"key1","kty":"oct","k":"bXktc2VjcmV0LWtleQ"}]}"#;

#[derive(Clone)]
struct Product {
    id: i64,
    name: String,
    price_cents: i64,
    cost_cents: i64,
    is_approved: bool,
}

fn product_store() -> &'static Mutex<HashMap<i64, Product>> {
    static STORE: OnceLock<Mutex<HashMap<i64, Product>>> = OnceLock::new();
    STORE.get_or_init(|| Mutex::new(HashMap::new()))
}

// --- per-field validators, each independently testable/reportable ---
fn validate_name(name: &str) -> Result<(), &'static str> {
    if name.is_empty() {
        return Err("name: must not be empty");
    }
    if !name.chars().all(|c| c.is_ascii_alphanumeric() || c == ' ') {
        return Err("name: must match ^[A-Za-z0-9 ]+$");
    }
    Ok(())
}

fn validate_price_cents(price_cents: i64) -> Result<(), &'static str> {
    if price_cents < 0 {
        return Err("price_cents: must be >= 0");
    }
    Ok(())
}

fn validate_cost_cents(cost_cents: i64) -> Result<(), &'static str> {
    if cost_cents < 0 {
        return Err("cost_cents: must be >= 0");
    }
    Ok(())
}

fn validate_product_input(name: &str, price_cents: i64, cost_cents: i64) -> Vec<&'static str> {
    [
        validate_name(name).err(),
        validate_price_cents(price_cents).err(),
        validate_cost_cents(cost_cents).err(),
    ]
    .into_iter()
    .flatten()
    .collect()
}

// --- CRUD: mandatory, type-gated via #[contract(requires(role = ..))] ---
#[nirdosha_rt::contract(requires(role = "admin"))]
fn create_product(name: String, price_cents: i64, cost_cents: i64) -> Result<Product, Vec<&'static str>> {
    let errors = validate_product_input(&name, price_cents, cost_cents);
    if !errors.is_empty() {
        return Err(errors);
    }
    let product = Product {
        id: new_instance_id(),
        name,
        price_cents,
        cost_cents,
        is_approved: false,
    };
    product_store().lock().unwrap().insert(product.id, product.clone());
    Ok(product)
}

#[nirdosha_rt::contract(requires(role = "admin"))]
fn update_product(id: i64, price_cents: i64, cost_cents: i64) -> Result<Product, Vec<&'static str>> {
    let mut errors = Vec::new();
    if let Err(e) = validate_price_cents(price_cents) {
        errors.push(e);
    }
    if let Err(e) = validate_cost_cents(cost_cents) {
        errors.push(e);
    }
    if !errors.is_empty() {
        return Err(errors);
    }
    let mut store = product_store().lock().unwrap();
    let product = store.get_mut(&id).ok_or_else(|| vec!["not found"])?;
    product.price_cents = price_cents;
    product.cost_cents = cost_cents;
    Ok(product.clone())
}

// --- reads: public, but cost_cents masking is optional-proof-gated ---
fn product_json(p: &Product, admin_proof: Option<&RoleProof<nirdosha_roles::Admin>>) -> serde_json::Value {
    let visible_cost = mask_unless(admin_proof, p.cost_cents as f64) as i64;
    serde_json::json!({
        "id": p.id,
        "name": p.name,
        "price_cents": p.price_cents,
        "cost_cents": visible_cost,
        "is_approved": p.is_approved,
    })
}

fn list_products(admin_proof: Option<&RoleProof<nirdosha_roles::Admin>>) -> serde_json::Value {
    let store = product_store().lock().unwrap();
    let mut items: Vec<&Product> = store.values().collect();
    items.sort_by_key(|p| p.id);
    serde_json::json!(items.iter().map(|p| product_json(p, admin_proof)).collect::<Vec<_>>())
}

fn get_product(id: i64, admin_proof: Option<&RoleProof<nirdosha_roles::Admin>>) -> Option<serde_json::Value> {
    let store = product_store().lock().unwrap();
    store.get(&id).map(|p| product_json(p, admin_proof))
}

// --- categorical action: is_approved -> two independently role-gated
// transitions, plus a derived, non-authoritative role_for_is_approved.
nirdosha_rt::categorical_actions! {
    entity: Product,
    store: product_store,
    field: is_approved: bool,
    actions {
        true  => approve_product    requires role "approver",
        false => disapprove_product requires role "compliance_officer",
    }
}

// --- HTTP wiring ---
fn auth_for(req: &Request) -> nirdosha_rt::Auth {
    match req.header("authorization").and_then(|h| h.strip_prefix("Bearer ")) {
        Some(token) => match oidc_validate_token(token, ISSUER, AUDIENCE, JWKS) {
            Ok(identity) => auth_from_identity(&identity),
            Err(_) => nirdosha_rt::Auth::login("anonymous", &[]),
        },
        None => nirdosha_rt::Auth::login("anonymous", &[]),
    }
}

fn parse_id(params: &nirdosha_rt::PathParams) -> Result<i64, Response> {
    params
        .get("id")
        .and_then(|s| s.parse::<i64>().ok())
        .ok_or_else(|| Response::bad_request("id must be an integer"))
}

fn parse_body(req: &Request) -> Result<serde_json::Value, Response> {
    serde_json::from_str(&req.body).map_err(|_| Response::bad_request("malformed JSON body"))
}

fn main() {
    let router = Router::new(auth_for)
        .with_info("Product API", "1.0.0")
        .get("/api/products", "List products (cost_cents masked unless admin)", |_req, _params| {
            Response::json(200, &list_products(None))
        })
        .get("/api/products/{id}", "Get one product", |_req, params| {
            let id = match parse_id(params) {
                Ok(id) => id,
                Err(resp) => return resp,
            };
            match get_product(id, None) {
                Some(json) => Response::json(200, &json),
                None => Response::not_found(),
            }
        })
        .post_gated::<nirdosha_roles::Admin>("/api/products", "Create a product", |req, _params, proof| {
            let body = match parse_body(req) {
                Ok(b) => b,
                Err(resp) => return resp,
            };
            let name = body["name"].as_str().unwrap_or("").to_string();
            let price_cents = body["price_cents"].as_i64().unwrap_or(-1);
            let cost_cents = body["cost_cents"].as_i64().unwrap_or(-1);
            match create_product(proof, name, price_cents, cost_cents) {
                Ok(p) => Response::json(201, &product_json(&p, Some(proof))),
                Err(errors) => Response::json(400, &serde_json::json!({ "errors": errors })),
            }
        })
        .put_gated::<nirdosha_roles::Admin>("/api/products/{id}", "Update price/cost", |req, params, proof| {
            let id = match parse_id(params) {
                Ok(id) => id,
                Err(resp) => return resp,
            };
            let body = match parse_body(req) {
                Ok(b) => b,
                Err(resp) => return resp,
            };
            let price_cents = body["price_cents"].as_i64().unwrap_or(-1);
            let cost_cents = body["cost_cents"].as_i64().unwrap_or(-1);
            match update_product(proof, id, price_cents, cost_cents) {
                Ok(p) => Response::json(200, &product_json(&p, Some(proof))),
                Err(errors) => Response::json(400, &serde_json::json!({ "errors": errors })),
            }
        })
        .post_gated::<nirdosha_roles::Approver>("/api/products/{id}/approve", "Approve a product", |_req, params, proof| {
            let id = match parse_id(params) {
                Ok(id) => id,
                Err(resp) => return resp,
            };
            match approve_product(proof, id) {
                Ok(p) => Response::json(200, &product_json(&p, None)),
                Err(e) => Response::bad_request(e),
            }
        })
        .post_gated::<nirdosha_roles::ComplianceOfficer>(
            "/api/products/{id}/disapprove",
            "Disapprove a product",
            |_req, params, proof| {
                let id = match parse_id(params) {
                    Ok(id) => id,
                    Err(resp) => return resp,
                };
                match disapprove_product(proof, id) {
                    Ok(p) => Response::json(200, &product_json(&p, None)),
                    Err(e) => Response::bad_request(e),
                }
            },
        );

    // `main` loops forever by design — run standalone and drive it with
    // a real client, or let the golden test do exactly that (same
    // convention as `51_compiled_serve.nir`).
    router.serve(8092);
}
