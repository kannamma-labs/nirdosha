//! v2 of `examples/features/53_compiled_workflow_notifications.nir` —
//! `send_email`/`send_sms`/`send_push`/`notify` fired from a
//! workflow's `on_entry`: REAL HTTP POSTs to provider rows in the db
//! store, caught by the self-hosted listener thread — proving the
//! request shape actually leaves the process. `notify` takes the
//! offline (email-delegated) path, the same disclosed narrower cut.

use nirdosha_rt::prelude::*;
use nirdosha_v2::{
    db_connect, db_execute, identity_with_roles, json_parse, mq_connect, new_instance_id,
    send_email, send_push, send_sms, notify, ByRole, Json, VerifiedIdentity, WorkflowActionError,
};

#[derive(Clone)]
#[allow(dead_code)] // declared-complete for the workflow layer
enum IncidentEvent {
    Resolve,
}

#[derive(Clone, PartialEq)]
enum IncidentState {
    Open,
    #[allow(dead_code)] // declared-complete for the workflow layer
    Resolved,
}

/// nirdosha:workflow {"name":"Incident","states":{"Open":{"on_entry":"notify_all_channels","transitions":{"Resolve":"Resolved"}},"Resolved":{"terminal":true}}}
#[derive(Clone)]
struct IncidentData {}

fn instances() -> &'static std::sync::Mutex<std::collections::HashMap<i64, IncidentState>> {
    static STORE: std::sync::OnceLock<
        std::sync::Mutex<std::collections::HashMap<i64, IncidentState>>,
    > = std::sync::OnceLock::new();
    STORE.get_or_init(|| std::sync::Mutex::new(std::collections::HashMap::new()))
}

fn start_incident(_identity: Option<VerifiedIdentity>, _data: IncidentData) -> Result<i64, WorkflowActionError> {
    let id = new_instance_id();
    instances().lock().unwrap().insert(id, IncidentState::Open);
    notify_all_channels(id);
    Ok(id)
}

#[allow(dead_code)] // declared-complete for the workflow layer
fn advance_incident(
    _identity: VerifiedIdentity,
    instance_id: i64,
    event: IncidentEvent,
    _payload: Json,
) -> Result<bool, WorkflowActionError> {
    let mut store = instances().lock().unwrap();
    let state = store
        .get_mut(&instance_id)
        .ok_or(WorkflowActionError::InstanceNotFound)?;
    match (&state, &event) {
        (IncidentState::Open, IncidentEvent::Resolve) => {
            *state = IncidentState::Resolved;
            Ok(true)
        }
        _ => Err(WorkflowActionError::NoSuchTransition),
    }
}

fn notify_with_conn(conn: nirdosha_v2::DbConn, mq_conn: nirdosha_v2::MqConn, _instance_id: i64) {
    let created_email = match db_execute(
        &conn,
        "CREATE TABLE email_provider_config (id INTEGER PRIMARY KEY, active INTEGER, host TEXT, port INTEGER, path TEXT, api_key TEXT, from_address TEXT)",
        &[],
    ) {
        Ok(n) => n,
        Err(_e) => -1,
    };
    let created_sms = match db_execute(
        &conn,
        "CREATE TABLE sms_provider_config (id INTEGER PRIMARY KEY, active INTEGER, host TEXT, port INTEGER, path TEXT, api_key TEXT, from_address TEXT)",
        &[],
    ) {
        Ok(n) => n,
        Err(_e) => -1,
    };
    // `push_provider_config` deliberately stays empty (no INSERT) —
    // `send_push` demonstrates the real not-configured path.
    let created_push = match db_execute(
        &conn,
        "CREATE TABLE push_provider_config (id INTEGER PRIMARY KEY, active INTEGER, host TEXT, port INTEGER, path TEXT, api_key TEXT, from_address TEXT)",
        &[],
    ) {
        Ok(n) => n,
        Err(_e) => -1,
    };
    let inserted_email = match db_execute(
        &conn,
        "INSERT INTO email_provider_config (active, host, port, path, api_key, from_address) VALUES (1, ?, ?, ?, ?, ?)",
        &[
            "127.0.0.1".into(),
            "9730".into(),
            "/send/email".into(),
            "email-secret-key".into(),
            "alerts@example.com".into(),
        ],
    ) {
        Ok(n) => n,
        Err(_e) => -1,
    };
    let inserted_sms = match db_execute(
        &conn,
        "INSERT INTO sms_provider_config (active, host, port, path, api_key, from_address) VALUES (1, ?, ?, ?, ?, ?)",
        &[
            "127.0.0.1".into(),
            "9730".into(),
            "/send/sms".into(),
            "sms-secret-key".into(),
            "+15550100".into(),
        ],
    ) {
        Ok(n) => n,
        Err(_e) => -1,
    };
    println!(
        "{}",
        created_email + created_sms + created_push + inserted_email + inserted_sms
    ); // 2 — three CREATEs report 0, the two INSERTs report 1 each

    match json_parse("{\"ticket\":1}") {
        Ok(vars) => send_and_report(conn, mq_conn, &vars),
        Err(e) => println!("{e}"),
    }
}

fn send_and_report(conn: nirdosha_v2::DbConn, mq_conn: nirdosha_v2::MqConn, vars: &Json) {
    let recipient = ByRole("on_call_engineer");
    match send_email(&conn, &recipient, "incident_opened", vars) {
        Err(_e) => println!("false"),
        Ok(sent) => println!("{sent}"), // 1
    }
    match send_sms(&conn, &recipient, "incident_opened", vars) {
        Err(_e) => println!("false"),
        Ok(sent) => println!("{sent}"), // 1
    }
    // No `push_provider_config` row at all — a real `Err`, never a trap.
    match send_push(&conn, &recipient, "incident_opened", vars) {
        Ok(_sent) => println!("true"),
        Err(_e) => println!("push not configured"),
    }
    match notify(&conn, &mq_conn, &recipient, "incident_opened", vars) {
        Err(_e) => println!("false"),
        Ok(sent) => println!("{sent}"), // 1 — delegated to the configured email provider
    }
    stop(conn);
    stop(mq_conn);
}

fn notify_all_channels(_instance_id: i64) {
    match db_connect(":memory:") {
        Ok(conn) => match mq_connect("127.0.0.1", 6379) {
            Ok(mq_conn) => notify_with_conn(conn, mq_conn, _instance_id),
            Err(e) => println!("{e}"),
        },
        Err(e) => println!("{e}"),
    }
}

// Stands in for a real email/SMS provider: three real, configured
// sends happen above — exactly three real accepts expected here.
fn fake_provider(l: TcpListener) {
    let c1 = accept(&l);
    let r1 = c1.recv();
    println!("{r1}");
    c1.send("HTTP/1.1 200 OK\r\nConnection: close\r\n\r\nok");
    stop(c1);

    let c2 = accept(&l);
    let r2 = c2.recv();
    println!("{r2}");
    c2.send("HTTP/1.1 200 OK\r\nConnection: close\r\n\r\nok");
    stop(c2);

    let c3 = accept(&l);
    let r3 = c3.recv();
    println!("{r3}");
    c3.send("HTTP/1.1 200 OK\r\nConnection: close\r\n\r\nok");
    stop(c3);
    stop(l);
}

fn main() {
    let l = listen(9730);
    let h = spawn(move || fake_provider(l));

    let instance_id: i64 = match start_incident(None, IncidentData {}) {
        Ok(id) => id,
        Err(_e) => -1,
    };
    println!("{instance_id}"); // 1

    let _ = identity_with_roles("ops", "");
    join(h);
}
