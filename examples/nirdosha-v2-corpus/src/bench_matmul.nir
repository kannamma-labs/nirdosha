//! v2 of `benchmarks/nirdosha/matmul.nir` — 4x4 matrix multiply,
//! 200k iterations, one scalar per iteration accumulated as checksum.

use nirdosha_rt::prelude::*;

fn main() {
    let mut n: i64 = 0;
    let n_max: i64 = 200000;
    let mut t: f64 = 0.0;
    let mut checksum: f64 = 0.0;
    while n < n_max {
        let a = Matrix([
            [t, t + 1.0, t + 2.0, t + 3.0],
            [t + 4.0, t + 5.0, t + 6.0, t + 7.0],
            [t + 8.0, t + 9.0, t + 10.0, t + 11.0],
            [t + 12.0, t + 13.0, t + 14.0, t + 15.0],
        ]);
        let b = Matrix([
            [t + 1.0, t, t + 3.0, t + 2.0],
            [t + 5.0, t + 4.0, t + 7.0, t + 6.0],
            [t + 9.0, t + 8.0, t + 11.0, t + 10.0],
            [t + 13.0, t + 12.0, t + 15.0, t + 14.0],
        ]);
        let c = a * b;
        checksum += c.0[0][0];
        t += 0.0001;
        n += 1;
    }
    println!("{checksum}");
}
