//! v2 of `examples/syntax/06_identity_and_declarative_ui.nir` — the
//! whole moat in one file: `requires` (a real compiler-enforced proof),
//! `transact`, a
//! `workflow` state machine, `screen`/`dashboard`, and module
//! namespacing.
//!
//! **The encoding, end to end:**
//! - `use "06_shared_lib.nir"` → a `#[path]` module (extension intact)
//! - `requires(role:)` → `#[nirdosha_rt::contract(requires(role = ..))]`,
//!   a real compiler-enforced proof (`nirdosha_rt::Auth::prove::<R>()`),
//!   not a hand-written string comparison
//! - `requires(public)` → the `nirdosha:serve` channel (serve-surface
//!   metadata, a Phase-0 grammar item)
//! - `transact { ... }` → visible Rust body + `nirdosha:transact` claim
//! - `workflow Approval { ... }` → `nirdosha:workflow` claim + the
//!   desugared Rust (the exact shape `workflow_lower` synthesizes:
//!   `start_approval`/`advance_approval`, `ApprovalData`, `ApprovalEvent`)
//! - `screen`/`dashboard` → `nirdosha:screen`/`nirdosha:dashboard`
//!
//! Pre-migration: everything runs (acquired privilege, saga paths,
//! the state machine's on_entry log, module-qualified access).
//! Post-migration: `emit-ui` renders the Cases screen and dashboard
//! from the comments, the workflow gains its durable store, and the
//! transact claim gains durability enforcement — the file unmodified.

#![allow(dead_code)] // declaration-complete: the UI/CRUD layer exists for emit-ui/serve, not for main

#[path = "06_shared_lib.nir"]
mod shared_lib;

use nirdosha_rt::prelude::txn_id;
use nirdosha_v2::{
    auth_from_identity, json_parse, mock_issue_token, new_instance_id,
    oidc_validate_token, VerifiedIdentity, WorkflowActionError,
};
use shared_lib::Shared::make_entry;

nirdosha_rt::roles! {
    Physician = "physician";
}

struct Text {
    value: String,
}

// --- 6a. Privileged first-class functions --------------------------
// The gate: `transfer_funds` is uncallable without a
// `RoleProof<Physician>` — the macro injects the leading proof
// parameter itself, and its private constructor means only
// `Auth::prove::<Physician>()` can mint one, under any Rust toolchain.
#[nirdosha_rt::contract(requires(role = "physician"))]
fn transfer_funds(amount: i64) -> i64 {
    amount
}

fn double(x: i64) -> i64 {
    x * 2
}

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    f(x)
}

// `requires(public)`: a genuinely open endpoint — serve-surface
// metadata, so `serve`'s "unintentionally open" warning stays quiet.
/// nirdosha:serve {"requires_public":true}
fn health_check() -> bool {
    true
}

// --- transact — the saga claim plus the visible body. --------------
fn call_api(txn_id: &str, amount: i64) -> i64 {
    let _ = txn_id;
    amount
}

fn check_amount(resp: i64) -> bool {
    resp > 0
}

fn commit_amount(amount: i64) -> i64 {
    println!("committing {amount}");
    amount
}

fn refund_amount(amount: i64) -> i64 {
    println!("compensating {amount}");
    amount
}

/// nirdosha:transact {"network":"call_api","verify":"check_amount","commit":"commit_amount","compensate":"refund_amount"}
fn charge(amount: i64) -> bool {
    let id = txn_id();
    let network = call_api(&id, amount);
    let verified = check_amount(network);
    if verified {
        commit_amount(amount);
    } else {
        refund_amount(amount);
    }
    verified
}

// --- workflow — the claim, plus the desugared Rust (what
// `workflow_lower` synthesizes). --------------------------------------
fn log_decision(instance_id: i64, outcome: &Text) {
    println!("approval {instance_id} {}", outcome.value);
}

/// nirdosha:workflow {"name":"Approval","data":{"struct":"ApprovalData","fields":{"amount":"i64"}},"states":{"Pending":{"transitions":{"Approve":"Approved","Reject":"Rejected"}},"Approved":{"terminal":true,"on_entry":"log_decision"},"Rejected":{"terminal":true,"on_entry":"log_decision"}}}
#[derive(Clone)]
struct ApprovalData {
    amount: i64,
}

enum ApprovalEvent {
    Approve,
    Reject,
}

#[derive(Clone, PartialEq)]
enum ApprovalState {
    Pending,
    Approved,
    Rejected,
}

// The workflow's instance store: process-global here (the real tier's
// is durable and survives restarts).
fn instances() -> &'static std::sync::Mutex<std::collections::HashMap<i64, (ApprovalData, ApprovalState)>> {
    static STORE: std::sync::OnceLock<
        std::sync::Mutex<std::collections::HashMap<i64, (ApprovalData, ApprovalState)>>,
    > = std::sync::OnceLock::new();
    STORE.get_or_init(|| std::sync::Mutex::new(std::collections::HashMap::new()))
}

fn start_approval(_identity: Option<VerifiedIdentity>, data: ApprovalData) -> Result<i64, WorkflowActionError> {
    let id = new_instance_id();
    instances().lock().unwrap().insert(id, (data, ApprovalState::Pending));
    Ok(id)
}

fn advance_approval(
    identity: &VerifiedIdentity,
    instance_id: i64,
    decision: ApprovalEvent,
    _payload: nirdosha_v2::Json,
) -> Result<bool, WorkflowActionError> {
    let mut store = instances().lock().unwrap();
    let Some((data, state)) = store.get_mut(&instance_id) else {
        return Err(WorkflowActionError::NoSuchTransition);
    };
    if *state != ApprovalState::Pending {
        return Err(WorkflowActionError::NoSuchTransition);
    }
    let approved = match decision {
        ApprovalEvent::Approve => true,
        ApprovalEvent::Reject => false,
    };
    let _ = identity;
    if approved {
        *state = ApprovalState::Approved;
    } else {
        *state = ApprovalState::Rejected;
    }
    let data = data.clone();
    drop(store);
    let outcome = if approved { "approved" } else { "rejected" };
    log_decision(instance_id, &Text { value: outcome.into() });
    let _ = data;
    Ok(true)
}

// Thin wrappers over the desugared fns, `emit-ui`-friendly — the same
// convention the original file documents.
fn submit_approval(amount: i64) -> Result<i64, WorkflowActionError> {
    start_approval(None, ApprovalData { amount })
}

fn decide_approval(
    identity: &VerifiedIdentity,
    instance_id: i64,
    decision: ApprovalEvent,
) -> Result<bool, WorkflowActionError> {
    match json_parse("{}") {
        Ok(payload) => advance_approval(identity, instance_id, decision, payload),
        Err(_e) => Err(WorkflowActionError::NoSuchTransition),
    }
}

// --- screen/dashboard — pure declarations over the CRUD naming
// conventions (`list_/create_/stat_/chart_` survive the translation
// untouched, so emit-ui needs no encoding for them).
enum ErrorCode {
    MalformedListing(String),
}

/// nirdosha:screen {"for":"Case","title":"Cases","fields":{"title":{"label":"Case Title"}}}
struct Case {
    id: i64,
    title: String,
    status: String,
}

fn list_case() -> Result<nirdosha_v2::Json, ErrorCode> {
    match json_parse("[]") {
        Ok(doc) => Ok(doc),
        Err(e) => Err(ErrorCode::MalformedListing(e)),
    }
}

/// nirdosha:dashboard {"tiles":[{"label":"Open Cases","stat":"stat_case_count"}],"charts":[{"label":"By Status","chart":"chart_cases_by_status"}]}
fn stat_case_count() -> i64 {
    0
}

fn chart_cases_by_status() -> Result<nirdosha_v2::Json, ErrorCode> {
    match json_parse("[]") {
        Ok(doc) => Ok(doc),
        Err(e) => Err(ErrorCode::MalformedListing(e)),
    }
}

fn main() {
    // 6a: apply an ordinary fn (no privilege needed) — 42
    println!("{}", apply(double, 21));

    let jwks = r#"{"keys":[{"kid":"key1","kty":"oct","k":"bXktc2VjcmV0LWtleQ"}]}"#;

    // The fixture IdP mints the same claims the original's real token
    // carries (roles = ["physician"], department = cardiology);
    // (roles = ["physician"]); `oidc_validate_token` then validates.
    let token = match mock_issue_token(
        "alice",
        "https://example.com",
        "my-app",
        1700000000,
        2000000000,
        r#"{"roles":["physician"],"department":"cardiology"}"#,
        jwks,
    ) {
        Ok(t) => t,
        Err(_e) => String::new(),
    };

    let acquired: i64 = match oidc_validate_token(&token, "https://example.com", "my-app", jwks) {
        Ok(identity) => match auth_from_identity(&identity).prove::<nirdosha_roles::Physician>() {
            Ok(proof) => transfer_funds(&proof, 500),
            Err(_e) => -2,
        },
        Err(_e) => -3,
    };
    println!("{acquired}"); // 500
    println!("{}", health_check()); // true, no token needed

    // transact
    println!("{}", charge(10)); // true — committing 10
    println!("{}", charge(-5)); // false — compensating -5

    // workflow: submit, then decide.
    let instance_id = match submit_approval(250) {
        Ok(id) => id,
        Err(_e) => -1,
    };

    let decided = match oidc_validate_token(&token, "https://example.com", "my-app", jwks) {
        Ok(identity) => match decide_approval(&identity, instance_id, ApprovalEvent::Approve) {
            Ok(ok) => ok,
            Err(_e) => false,
        },
        Err(_e) => false,
    };
    println!("{decided}"); // true — on_entry logged "approval <id> approved"

    // module/use: `Shared::` reachable only qualified, never bare.
    let entry = make_entry(1);
    println!("{}", entry.id);
    println!("{}", entry.note);
}