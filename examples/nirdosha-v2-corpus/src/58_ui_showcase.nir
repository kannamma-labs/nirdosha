// ---------------------------------------------------------------------------
// 5. Workflow: generated queue with state stepper
// ---------------------------------------------------------------------------

/// nirdosha:workflow {"name":"Approval","data":{"struct":"ApprovalData","fields":{"amount":"i64"}},"states":{"Draft":{"transitions":{"Submit":"Pending"}},"Pending":{"owner":{"role":"manager"},"transitions":{"Approve":"Approved","Reject":"Rejected"}},"Approved":{"terminal":true,"on_entry":"log_approved"},"Rejected":{"terminal":true,"on_entry":"log_rejected"}}}
#[derive(Clone)]
struct ApprovalData {
    amount: i64,
}

#[derive(Clone, Copy)]
enum ApprovalEvent {
    Submit,
    Approve,
    Reject,
}

#[derive(Clone, Copy, PartialEq, Eq)]
enum ApprovalState {
    Draft,
    Pending,
    Approved,
    Rejected,
}

fn approval_instances() -> &'static SharedTable<i64, (ApprovalData, ApprovalState)> {
    static STORE: std::sync::OnceLock<SharedTable<i64, (ApprovalData, ApprovalState)>> =
        std::sync::OnceLock::new();
    STORE.get_or_init(SharedTable::new)
}

fn start_approval(_identity: Option<VerifiedIdentity>, data: ApprovalData) -> Result<i64, WorkflowActionError> {
    let id = new_instance_id();
    approval_instances().insert(id, (data, ApprovalState::Draft));
    Ok(id)
}

fn advance_approval(
    _identity: &VerifiedIdentity,
    instance_id: i64,
    event: ApprovalEvent,
    _payload: Json,
) -> Result<bool, WorkflowActionError> {
    approval_instances().update(&instance_id, |entry| {
        let Some((_data, state)) = entry else {
            return Err(WorkflowActionError::NoSuchTransition);
        };
        let (new_state, approved) = match (*state, event) {
            (ApprovalState::Draft, ApprovalEvent::Submit) => (ApprovalState::Pending, None),
            (ApprovalState::Pending, ApprovalEvent::Approve) => (ApprovalState::Approved, Some(true)),
            (ApprovalState::Pending, ApprovalEvent::Reject) => (ApprovalState::Rejected, Some(false)),
            _ => return Err(WorkflowActionError::NoSuchTransition),
        };
        *state = new_state;
        Ok(approved.unwrap_or(true))
    })
}

fn log_approved(instance_id: i64) {
    println!("approval {instance_id} approved");
}

fn log_rejected(instance_id: i64) {
    println!("approval {instance_id} rejected");
}

fn submit_approval(amount: i64) -> Result<i64, WorkflowActionError> {
    start_approval(None, ApprovalData { amount })
}

fn decide_approval(
    identity: &VerifiedIdentity,
    instance_id: i64,
    event: ApprovalEvent,
) -> Result<bool, WorkflowActionError> {
    match json_parse("{}") {
        Ok(payload) => advance_approval(identity, instance_id, event, payload),
        Err(_e) => Err(WorkflowActionError::NoSuchTransition),
    }
}

// ---------------------------------------------------------------------------
// 6. Field-level masking + validate contract
// ---------------------------------------------------------------------------

/// nirdosha:field {"struct":"Employee","field":"salary","requires":{"role":"admin"}}
struct Employee {
    name: String,
    department: String,
    salary: f64,
}

/// nirdosha:validate {"pre":["years >= 0"],"post":["result >= 0","result <= 20"]}
/// nirdosha:contract {"effects":["pure"]}
fn tenure_bonus_pct(years: i64) -> i64 {
    if years >= 10 {
        return 20;
    }
    if years >= 5 {
        return 10;
    }
    0
}

#[nirdosha_rt::contract(
    effects(pure),
    requires(role = "hr_staff"),
    nfr(latency_ms = 50, concurrency_max = 1000)
)]
fn get_employee(
    admin_proof: Option<&RoleProof<nirdosha_roles::Admin>>,
    name: String,
    department: String,
    salary: f64,
) -> Employee {
    Employee {
        name,
        department,
        salary: mask_unless(admin_proof, salary),
    }
}

// ---------------------------------------------------------------------------
// 7. Router wiring (screens exist; no need to serve in this demo)
// ---------------------------------------------------------------------------

fn auth_for(req: &Request) -> nirdosha_rt::Auth {
    match req.header("authorization").and_then(|h| h.strip_prefix("Bearer ")) {
        Some(token) => match oidc_validate_token(token, ISSUER, AUDIENCE, JWKS) {
            Ok(identity) => auth_from_identity(&identity),
            Err(_) => nirdosha_rt::Auth::login("anonymous", &[]),
        },
        None => nirdosha_rt::Auth::login("anonymous", &[]),
    }
}

fn verify_login(username: &str, password: &str) -> Option<Vec<String>> {
    match (username, password) {
        ("alice", "admin123") => Some(vec!["admin".to_string(), "approver".to_string(), "manager".to_string()]),
        ("carol", "approve123") => Some(vec!["approver".to_string()]),
        ("dave", "comply123") => Some(vec!["compliance_officer".to_string()]),
        ("mallory", "guest123") => Some(vec![]),
        _ => None,
    }
}

// ---------------------------------------------------------------------------
// Route helpers for every non-CRUD/non-dashboard screen archetype.
// These are the runtime side of the `nirdosha:screen`/`layout`/`workspace`/
// `workflow`/`visual`/`landing` comment claims in this file.
// ---------------------------------------------------------------------------

fn parse_json(j: &Json) -> Result<JsonValue, String> {
    serde_json::from_str(j).map_err(|e| e.to_string())
}

fn verified_identity_from_auth(auth: &nirdosha_rt::Auth) -> VerifiedIdentity {
    let mut roles = Vec::new();
    for r in ["admin", "manager", "approver", "compliance_officer", "auditor", "logistics", "risk_manager", "hr_staff"] {
        if auth.has_role(r) {
            roles.push(r.to_string());
        }
    }
    VerifiedIdentity { subject: auth.user().to_string(), roles }
}

fn landing_handler(req: &Request, _params: &nirdosha_rt::PathParams) -> Response {
    let auth = auth_for(req);
    let roles: Vec<String> = ["admin", "manager", "approver", "compliance_officer", "auditor", "logistics", "risk_manager", "hr_staff"]
        .iter()
        .filter(|r| auth.has_role(r))
        .map(|r| r.to_string())
        .collect();
    let rules = vec![
        LandingRule { label: "Admin Home".into(), href: "/admin_home".into(), required_role: Some("admin".into()) },
        LandingRule { label: "Manager Home".into(), href: "/manager_home".into(), required_role: Some("manager".into()) },
        LandingRule { label: "Products".into(), href: "/products".into(), required_role: None },
        LandingRule { label: "Dashboard".into(), href: "/dashboard".into(), required_role: None },
        LandingRule { label: "Purchase Orders".into(), href: "/purchase_orders".into(), required_role: None },
        LandingRule { label: "PO Workspace".into(), href: "/po_workspace/1".into(), required_role: None },
        LandingRule { label: "Workflows".into(), href: "/workflows".into(), required_role: Some("manager".into()) },
        LandingRule { label: "Visuals".into(), href: "/visuals/network".into(), required_role: None },
    ];
    Response::html(200, render_landing("UI Showcase", &rules, auth.user(), &roles))
}

fn vendor_screen_handler(_req: &Request, _params: &nirdosha_rt::PathParams) -> Response {
    let j = match list_vendor() {
        Ok(j) => j,
        Err(_) => return Response::bad_request("vendor data unavailable"),
    };
    let rows = match parse_json(&j).and_then(|v| v.as_array().cloned().ok_or("not array".into())) {
        Ok(r) => r,
        Err(_) => return Response::bad_request("bad vendor json"),
    };
    let row = rows.first().cloned().unwrap_or(serde_json::json!({"id":0,"name":"","email":"","risk_score":0}));
    let fields = vec![
        LayoutField { name: "name".into(), label: "Supplier Name".into(), value: row["name"].as_str().unwrap_or("").into() },
        LayoutField { name: "email".into(), label: "Contact Email".into(), value: row["email"].as_str().unwrap_or("").into() },
        LayoutField { name: "risk_score".into(), label: "Risk Score".into(), value: row["risk_score"].as_i64().unwrap_or(0).to_string() },
    ];
    let actions = vec![
        LayoutAction { label: "Audit".into(), href: "#".into(), style: "outlined".into() },
    ];
    let layout = LayoutNode::Column(vec![
        LayoutNode::Group { title: "Supplier Details".into(), fields: vec!["name".into(), "email".into(), "risk_score".into()] },
    ]);
    Response::html(200, render_custom_screen("Supplier Directory", &fields, &actions, &layout, &row))
}

fn purchase_order_screen_handler(_req: &Request, _params: &nirdosha_rt::PathParams) -> Response {
    let j = match get_purchase_order(1) {
        Ok(j) => j,
        Err(_) => return Response::bad_request("po data unavailable"),
    };
    let row = match parse_json(&j) {
        Ok(v) => v,
        Err(_) => return Response::bad_request("bad po json"),
    };
    let status_text = row["status"].as_str().unwrap_or("").to_string();
    let deadline = row["deadline"].as_i64().unwrap_or(0);
    let fields = vec![
        LayoutField { name: "vendor_id".into(), label: "Supplier".into(), value: row["vendor_id"].as_i64().unwrap_or(0).to_string() },
        LayoutField { name: "amount_cents".into(), label: "Amount (cents)".into(), value: row["amount_cents"].as_i64().unwrap_or(0).to_string() },
        LayoutField { name: "status".into(), label: "Status".into(), value: status_text.clone() },
        LayoutField { name: "deadline".into(), label: "SLA Deadline".into(), value: deadline.to_string() },
        LayoutField { name: "internal_note".into(), label: "Internal Note".into(), value: row["internal_note"].as_str().unwrap_or("").into() },
    ];
    let actions = vec![
        LayoutAction { label: "Simulate Impact".into(), href: "#".into(), style: "outlined".into() },
    ];
    let timeline = match list_po_timeline(1) {
        Ok(j) => parse_json(&j).unwrap_or(serde_json::json!([])),
        Err(_) => serde_json::json!([]),
    };
    let events: Vec<TimelineEvent> = timeline.as_array().cloned().unwrap_or_default().iter().map(|e| TimelineEvent {
        ts: e["ts"].as_i64().unwrap_or(0),
        label: e["label"].as_str().unwrap_or("").into(),
        detail: e["detail"].as_str().unwrap_or("").into(),
    }).collect();
    let layout = LayoutNode::Row(vec![
        LayoutNode::Column(vec![
            LayoutNode::Group { title: "Header".into(), fields: vec!["vendor_id".into(), "amount_cents".into(), "status".into(), "deadline".into()] },
            LayoutNode::Divider,
            LayoutNode::Group { title: "Internal".into(), fields: vec!["internal_note".into()] },
        ]),
        LayoutNode::Column(vec![
            LayoutNode::Tabs(vec![
                ("Actions".into(), LayoutNode::Column(vec![])),
                ("History".into(), LayoutNode::Timeline { source_label: "PO History".into(), events }),
            ]),
        ]),
    ]);
    Response::html(200, render_custom_screen("Purchase Orders", &fields, &actions, &layout, &row))
}

fn workspace_handler(_req: &Request, params: &nirdosha_rt::PathParams) -> Response {
    let id: i64 = match params.get("id").and_then(|s| s.parse().ok()) {
        Some(id) => id,
        None => return Response::bad_request("id must be an integer"),
    };
    let po = match get_purchase_order(id).and_then(|j| parse_json(&j).map_err(|_| ErrorCode::MalformedListing)) {
        Ok(v) => v,
        Err(_) => return Response::bad_request("po not found"),
    };
    let subject = vec![
        LayoutField { name: "id".into(), label: "ID".into(), value: po["id"].as_i64().unwrap_or(0).to_string() },
        LayoutField { name: "vendor_id".into(), label: "Supplier".into(), value: po["vendor_id"].as_i64().unwrap_or(0).to_string() },
        LayoutField { name: "amount_cents".into(), label: "Amount".into(), value: po["amount_cents"].as_i64().unwrap_or(0).to_string() },
        LayoutField { name: "status".into(), label: "Status".into(), value: po["status"].as_str().unwrap_or("").into() },
    ];
    let shipments = match list_shipment_for_po(id) {
        Ok(j) => parse_json(&j).unwrap_or(serde_json::json!([])),
        Err(_) => serde_json::json!([]),
    };
    let network = match graph_relationships_for_po(id) {
        Ok(j) => parse_json(&j).unwrap_or(serde_json::json!({"nodes":[],"edges":[]})),
        Err(_) => serde_json::json!({"nodes":[],"edges":[]}),
    };
    let history = match list_po_timeline(id) {
        Ok(j) => parse_json(&j).unwrap_or(serde_json::json!([])),
        Err(_) => serde_json::json!([]),
    };
    let panels = vec![
        WorkspacePanel { title: "Shipments".into(), render: "table".into(), data: shipments },
        WorkspacePanel { title: "Network".into(), render: "graph".into(), data: network },
        WorkspacePanel { title: "History".into(), render: "timeline".into(), data: history },
    ];
    Response::html(200, render_workspace("PO Investigation", &subject, &panels))
}

fn workflow_queue_handler(req: &Request, _params: &nirdosha_rt::PathParams) -> Response {
    let auth = auth_for(req);
    if !auth.has_role("manager") {
        return Response::forbidden();
    }
    let states = vec!["Draft".into(), "Pending".into(), "Approved".into(), "Rejected".into()];
    let mut instances = Vec::new();
    approval_instances().snapshot().into_iter().for_each(|(id, (data, state))| {
        let state_name = match state {
            ApprovalState::Draft => "Draft",
            ApprovalState::Pending => "Pending",
            ApprovalState::Approved => "Approved",
            ApprovalState::Rejected => "Rejected",
        };
        instances.push(WorkflowInstance {
            id,
            state: state_name.into(),
            data_label: format!("amount: {}", data.amount),
        });
    });
    // Sort so stable ordering in screenshots
    instances.sort_by(|a, b| a.id.cmp(&b.id));
    let actions = vec![("Submit".into(), "Submit".into()), ("Approve".into(), "Approve".into()), ("Reject".into(), "Reject".into())];
    Response::html(200, render_workflow_queue("Workflows", &states, &instances, &actions))
}

fn workflow_advance_handler(req: &Request, params: &nirdosha_rt::PathParams) -> Response {
    let auth = auth_for(req);
    if !auth.has_role("manager") {
        return Response::forbidden();
    }
    let id: i64 = match params.get("id").and_then(|s| s.parse().ok()) {
        Some(id) => id,
        None => return Response::bad_request("id must be an integer"),
    };
    let form = req.form_or_json();
    let event = match form.get("event").map(String::as_str) {
        Some("Submit") => ApprovalEvent::Submit,
        Some("Approve") => ApprovalEvent::Approve,
        Some("Reject") => ApprovalEvent::Reject,
        _ => return Response::bad_request("event required"),
    };
    let identity = verified_identity_from_auth(&auth);
    match decide_approval(&identity, id, event) {
        Ok(_) => Response::redirect("/workflows"),
        Err(_) => Response::bad_request("advance failed"),
    }
}

fn visual_handler(kind: &str, title: &str, data_fn: fn() -> Result<Json, ErrorCode>) -> Response {
    let j = match data_fn() {
        Ok(j) => j,
        Err(_) => return Response::bad_request("visual data unavailable"),
    };
    let data = match parse_json(&j) {
        Ok(v) => v,
        Err(_) => return Response::bad_request("bad visual json"),
    };
    Response::html(200, render_visual_page(title, kind, &data))
}

fn main() {
    // 1. validate contract
    println!("{}", tenure_bonus_pct(7)); // 10

    // 2. workflow: drive one instance to Approved to exercise state machine
    let manager_identity = identity_with_roles("manager-1", "manager");
    let instance_id = match submit_approval(250000) {
        Ok(id) => id,
        Err(_e) => -1,
    };
    println!("{instance_id}"); // 1

    let _ = decide_approval(&manager_identity, instance_id, ApprovalEvent::Submit);
    let _ = decide_approval(&manager_identity, instance_id, ApprovalEvent::Approve);

    // Seed additional workflow instances so the queue has rows in varied states.
    if let Ok(id2) = submit_approval(100000) {
        let _ = decide_approval(&manager_identity, id2, ApprovalEvent::Submit);
    }
    if let Ok(id3) = submit_approval(50000) {
        let _ = decide_approval(&manager_identity, id3, ApprovalEvent::Submit);
        let _ = decide_approval(&manager_identity, id3, ApprovalEvent::Reject);
    }

    // 3. field masking
    let admin_identity = identity_with_roles("alice", "hr_staff,admin");
    let admin_auth = auth_from_identity(&admin_identity);
    let admin_view = match admin_auth.prove::<nirdosha_roles::HrStaff>() {
        Err(_e) => Employee {
            name: String::new(),
            department: String::new(),
            salary: -1.0,
        },
        Ok(hr_proof) => {
            let admin_proof = admin_auth.prove::<nirdosha_roles::Admin>().ok();
            get_employee(
                &hr_proof,
                admin_proof.as_ref(),
                "Ada Lovelace".into(),
                "Engineering".into(),
                150000.0,
            )
        }
    };
    println!("{}", admin_view.salary); // 150000

    let hr_identity = identity_with_roles("carol", "hr_staff");
    let hr_auth = auth_from_identity(&hr_identity);
    let hr_view = match hr_auth.prove::<nirdosha_roles::HrStaff>() {
        Err(_e) => Employee {
            name: String::new(),
            department: String::new(),
            salary: -2.0,
        },
        Ok(hr_proof) => {
            let admin_proof = hr_auth.prove::<nirdosha_roles::Admin>().ok();
            get_employee(
                &hr_proof,
                admin_proof.as_ref(),
                "Ada Lovelace".into(),
                "Engineering".into(),
                150000.0,
            )
        }
    };
    println!("{}", hr_view.salary); // 0

    // 4. categorical action on a seeded product
    product_store().insert(
        1,
        Product {
            id: 1,
            name: "Widget".into(),
            price_cents: 999,
            cost_cents: 300,
            is_approved: false,
        },
    );

    let approver_identity = identity_with_roles("carol", "approver");
    let approver_auth = auth_from_identity(&approver_identity);
    let product = match approver_auth.prove::<nirdosha_roles::Approver>() {
        Err(_e) => None,
        Ok(proof) => match approve_product(&proof, 1) {
            Ok(p) => Some(p),
            Err(_e) => None,
        },
    };
    match product {
        Some(p) => println!("{} {}", p.name, p.is_approved), // Widget true
        None => println!("approve failed"),
    }

    // 5. Build the router with every screen archetype wired to real routes.
    // Load the theme token file (embedded default if missing or unreadable).
    nirdosha_rt::theme::load(None);

    // Load theme token file (defaults to embedded modern theme if env var absent).
    nirdosha_rt::load_theme(std::env::var("NIRDOSHA_THEME").ok().as_deref().map(std::path::Path::new));

    let router = Router::new(auth_for)
        .with_info("UI Showcase", "1.0.0")
        .with_nav(vec![
            nirdosha_rt::NavLink { label: "Home", href: "/" },
            nirdosha_rt::NavLink { label: "Products", href: "/products" },
            nirdosha_rt::NavLink { label: "Dashboard", href: "/dashboard" },
            nirdosha_rt::NavLink { label: "Supplier", href: "/vendor" },
            nirdosha_rt::NavLink { label: "Purchase Orders", href: "/purchase_orders" },
            nirdosha_rt::NavLink { label: "Workspace", href: "/po_workspace/1" },
            nirdosha_rt::NavLink { label: "Workflows", href: "/workflows" },
            nirdosha_rt::NavLink { label: "Network", href: "/visuals/network" },
            nirdosha_rt::NavLink { label: "Heatmap", href: "/visuals/heatmap" },
            nirdosha_rt::NavLink { label: "Timeline", href: "/visuals/timeline" },
        ])
        .with_login("/login", verify_login)
        .get("/", "Landing", landing_handler)
        .get("/vendor", "Supplier Directory", vendor_screen_handler)
        .get("/purchase_orders", "Purchase Orders", purchase_order_screen_handler)
        .get("/po_workspace/{id}", "PO Investigation", workspace_handler)
        .get("/workflows", "Workflows", workflow_queue_handler)
        .post("/workflows/{id}/advance", "Advance workflow", workflow_advance_handler)
        .get("/visuals/network", "Vendor Network", |_req, _params| visual_handler("graph", "Vendor Network", graph_vendor_network))
        .get("/visuals/heatmap", "Shipment Heatmap", |_req, _params| visual_handler("heatmap", "Shipment Heatmap", heatmap_shipment_density))
        .get("/visuals/timeline", "Company Timeline", |_req, _params| visual_handler("timeline", "Company Timeline", timeline_company_events));
    let router = mount_product_screens(router);
    let router = mount_products_dashboard(router);
    let router = router
        .post_gated::<nirdosha_roles::Approver>("/api/products/{id}/approve", "Approve a product", |_req, params, proof| {
            let id: i64 = match params.get("id").and_then(|s| s.parse().ok()) {
                Some(id) => id,
                None => return Response::bad_request("id must be an integer"),
            };
            match approve_product(proof, id) {
                Ok(p) => Response::json(200, &serde_json::to_value(&p).unwrap()),
                Err(e) => Response::bad_request(e),
            }
        })
        .post_gated::<nirdosha_roles::ComplianceOfficer>("/api/products/{id}/disapprove", "Disapprove a product", |_req, params, proof| {
            let id: i64 = match params.get("id").and_then(|s| s.parse().ok()) {
                Some(id) => id,
                None => return Response::bad_request("id must be an integer"),
            };
            match disapprove_product(proof, id) {
                Ok(p) => Response::json(200, &serde_json::to_value(&p).unwrap()),
                Err(e) => Response::bad_request(e),
            }
        });

    if std::env::var("NIRDOSHA_UI_SHOWCASE_SERVE").is_ok() {
        router.serve(8097);
    } else {
        println!("screens wired (set NIRDOSHA_UI_SHOWCASE_SERVE=1 to start HTTP server)");
    }
}
