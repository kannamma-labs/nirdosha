//! v2 UI showcase -- one program that exercises every declarative
//! screen type the Nirdosha runtime can generate today, encoded as
//! the v2 Rust dialect with `nirdosha:*` comment claims.
//!
//! Screens demonstrated:
//!   * `crud_screens!` -- List / Detail / Create-Form / Edit-Form / Delete
//!   * `categorical_actions!` -- role-gated state transitions on one field
//!   * `dashboard!` -- metric tiles and an inline-SVG bar chart
//!   * `nirdosha:screen` + `nirdosha:layout` -- custom field labels,
//!     validation, badges, countdowns, searchable selects, row/column/
//!     group/tabs/timeline arrangement
//!   * `nirdosha:workspace` -- composite multi-panel screen (table,
//!     graph, timeline)
//!   * `nirdosha:visual` -- dashboard graph/heatmap/timeline visuals
//!   * `nirdosha:nav` -- primary-nav grouping into modules
//!   * `nirdosha:workflow` -- generated workflow queue with state stepper
//!   * `nirdosha:field` -- field-level masking
//!   * `nirdosha:validate` + `nirdosha:contract` -- Hoare contracts,
//!     role gating, NFRs, and effect claims.
//!
//! Theme tokens live in `src/token.js`; override with
//! NIRDOSHA_THEME=/path/to/token.js.

#![allow(dead_code)]

use nirdosha_rt::prelude::SharedTable;
use nirdosha_rt::showcase_screens::{
    LandingRule, LayoutAction, LayoutField, LayoutNode, TimelineEvent, WorkspacePanel,
    WorkflowInstance, render_custom_screen, render_landing, render_visual_page,
    render_workflow_queue, render_workspace,
};
use nirdosha_rt::{Request, Response, RoleProof, Router};
use nirdosha_v2::{
    auth_from_identity, identity_with_roles, json_parse, mask_unless, new_instance_id,
    oidc_validate_token, VerifiedIdentity, WorkflowActionError, Json,
};
use serde_json::Value as JsonValue;

nirdosha_rt::roles! {
    Admin = "admin";
    Approver = "approver";
    ComplianceOfficer = "compliance_officer";
    Manager = "manager";
    Logistics = "logistics";
    Auditor = "auditor";
    RiskManager = "risk_manager";
    HrStaff = "hr_staff";
}

const ISSUER: &str = "https://mock-idp.local";
const AUDIENCE: &str = "ui-showcase";
const JWKS: &str = r#"{"keys":[{"kid":"key1","kty":"oct","k":"bXktc2VjcmV0LWtleQ"}]}"#;

#[derive(Clone, Copy, PartialEq, Eq)]
enum ErrorCode {
    MalformedListing,
    MalformedVisual,
}

// ---------------------------------------------------------------------------
// 1. Product: macro-generated CRUD screen + categorical actions + dashboard
// ---------------------------------------------------------------------------

/// nirdosha:nav {"module":"Catalog"}
/// nirdosha:field {"struct":"Product","field":"cost_cents","requires":{"role":"admin"}}
#[derive(Clone, Default, serde::Serialize)]
struct Product {
    id: i64,
    name: String,
    price_cents: i64,
    cost_cents: i64,
    is_approved: bool,
}

fn product_store() -> &'static SharedTable<i64, Product> {
    static STORE: std::sync::OnceLock<SharedTable<i64, Product>> = std::sync::OnceLock::new();
    STORE.get_or_init(SharedTable::new)
}

nirdosha_rt::crud_screens! {
    mount: mount_product_screens,
    entity: Product,
    store: product_store,
    path: "/products",
    fields: [ name: String, price_cents: i64, cost_cents: i64 ],
    create: requires role "admin",
    read: public,
    update: requires role "admin",
    delete: requires role "admin",
}

nirdosha_rt::categorical_actions! {
    entity: Product,
    store: product_store,
    field: is_approved: bool,
    actions {
        true  => approve_product    requires role "approver",
        false => disapprove_product requires role "compliance_officer",
    }
}

fn stat_total_products() -> i64 {
    product_store().len() as i64
}

fn stat_approved_products() -> i64 {
    product_store()
        .snapshot()
        .iter()
        .filter(|(_, p)| p.is_approved)
        .count() as i64
}

fn chart_products_by_status() -> String {
    let approved = product_store()
        .snapshot()
        .iter()
        .filter(|(_, p)| p.is_approved)
        .count();
    let pending = product_store().len() - approved;
    serde_json::json!([
        {"label": "Approved", "value": approved},
        {"label": "Pending", "value": pending},
    ])
    .to_string()
}

nirdosha_rt::dashboard! {
    mount: mount_products_dashboard,
    path: "/dashboard",
    title: "Product Overview",
    refresh_seconds: 30,
    widgets {
        Metric { label: "Total Products", fn: stat_total_products },
        Metric { label: "Approved Products", fn: stat_approved_products },
        Chart  { label: "By Status", fn: chart_products_by_status, mark: bar },
    }
}

