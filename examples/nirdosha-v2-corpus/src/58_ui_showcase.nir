/// nirdosha:nav {"module":"Master Data"}
/// nirdosha:screen {"for":"Vendor","title":"Supplier Directory","fields":{"name":{"label":"Supplier Name","pattern":"^[A-Za-z0-9 ]+$"},"email":{"label":"Contact Email","format":"email"},"risk_score":{"label":"Risk Score","min":0,"max":10}},"actions":[{"label":"Audit","fn":"audit_vendor","style":"outlined","confirm":"Run a compliance audit for this supplier?"}]}
/// nirdosha:field {"struct":"Vendor","field":"risk_score","requires":{"role":"admin"}}
#[derive(Clone, Default, serde::Serialize)]
struct Vendor {
    id: i64,
    name: String,
    email: String,
    risk_score: i64,
}

/// nirdosha:contract {"effects":["pure"]}
fn list_vendor() -> Result<Json, ErrorCode> {
    match json_parse("[{\"id\":1,\"name\":\"Acme Inc\",\"email\":\"acme@example.com\",\"risk_score\":2}]") {
        Ok(doc) => Ok(doc),
        Err(_e) => Err(ErrorCode::MalformedListing),
    }
}

/// nirdosha:contract {"effects":["pure"]}
fn get_vendor(_id: i64) -> Result<Json, ErrorCode> {
    match json_parse("{\"id\":1,\"name\":\"Acme Inc\",\"email\":\"acme@example.com\",\"risk_score\":2}") {
        Ok(doc) => Ok(doc),
        Err(_e) => Err(ErrorCode::MalformedListing),
    }
}

#[nirdosha_rt::contract(requires(role = "admin"))]
fn create_vendor(_v: Vendor) -> Result<i64, ErrorCode> {
    Ok(1)
}

#[nirdosha_rt::contract(requires(role = "admin"))]
fn update_vendor(v: Vendor) -> Result<i64, ErrorCode> {
    Ok(v.id)
}

#[nirdosha_rt::contract(requires(role = "admin"))]
fn delete_vendor(_id: i64) -> Result<bool, ErrorCode> {
    Ok(true)
}

#[nirdosha_rt::contract(requires(role = "auditor"))]
fn audit_vendor(id: i64) -> Result<i64, ErrorCode> {
    Ok(id)
}

