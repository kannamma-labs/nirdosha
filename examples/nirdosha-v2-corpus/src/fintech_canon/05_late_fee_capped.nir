//! v2 of `examples/fintech-canon/05_late_fee_capped.nir` — a late fee
//! must never exceed a regulatory/policy cap, regardless of how the
//! base fee was computed upstream.

/// nirdosha:validate {"fn":"apply_late_fee_cap","pre":["base_fee_cents >= 0 && cap_cents >= 0"],"post":["result <= cap_cents"]}
fn apply_late_fee_cap(base_fee_cents: i64, cap_cents: i64) -> i64 {
    if base_fee_cents > cap_cents {
        cap_cents
    } else {
        base_fee_cents
    }
}

fn main() {
    println!("{}", apply_late_fee_cap(9000, 2500));
}
