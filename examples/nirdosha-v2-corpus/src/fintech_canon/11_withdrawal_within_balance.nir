//! v2 of `examples/fintech-canon/11_withdrawal_within_balance.nir` — a
//! withdrawal (no overdraft) must never pay out more than the account
//! actually holds, and must never leave the balance negative — two
//! directions of the same guarantee, both checked.

/// nirdosha:validate {"fn":"withdraw_cents","pre":["balance_cents >= 0 && amount_cents >= 0"],"post":["result >= 0 && result <= balance_cents"]}
fn withdraw_cents(balance_cents: i64, amount_cents: i64) -> i64 {
    if amount_cents > balance_cents {
        balance_cents
    } else {
        balance_cents - amount_cents
    }
}

fn main() {
    println!("{}", withdraw_cents(4000, 9000));
}
