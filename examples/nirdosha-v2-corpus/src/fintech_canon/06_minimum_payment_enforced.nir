//! v2 of `examples/fintech-canon/06_minimum_payment_enforced.nir` — a
//! payment processor that enforces a minimum payment amount must never
//! accept (or silently record) less than that minimum.

/// nirdosha:validate {"fn":"accepted_payment_cents","pre":["requested_cents >= 0 && minimum_cents >= 0"],"post":["result >= minimum_cents"]}
fn accepted_payment_cents(requested_cents: i64, minimum_cents: i64) -> i64 {
    if requested_cents < minimum_cents {
        minimum_cents
    } else {
        requested_cents
    }
}

fn main() {
    println!("{}", accepted_payment_cents(500, 1000));
}
