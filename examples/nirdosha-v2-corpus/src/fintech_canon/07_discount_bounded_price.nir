//! v2 of `examples/fintech-canon/07_discount_bounded_price.nir` — a
//! discount can never make a price negative, and the discounted price
//! can never exceed the original — both directions of the same
//! pricing-engine bug class.

/// nirdosha:validate {"fn":"discounted_price_cents","pre":["price_cents >= 0 && discount_cents >= 0"],"post":["result >= 0 && result <= price_cents"]}
fn discounted_price_cents(price_cents: i64, discount_cents: i64) -> i64 {
    if discount_cents > price_cents {
        0
    } else {
        price_cents - discount_cents
    }
}

fn main() {
    println!("{}", discounted_price_cents(2000, 2500));
}
