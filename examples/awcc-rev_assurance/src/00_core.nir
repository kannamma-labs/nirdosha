//! AWCC Revenue Assurance — foundations. Serves: ALL modules.
//!
//! RA analog of `examples/rtm/src/00_core.nir`.
//! Declares the role/principal vocabulary, purpose taxonomy, audit sampling,
//! approval chains, invariants, and the guard-policy corpus that backs every
//! menu/route guard declared in `menus.toml`.

use crate::domain_types::{AlertUpdate, CaseDispositionUpdate};
use crate::domains::Payment;

// ---- Roles & principals ----
nirdosha_rt::roles! {
    // Human roles
    role RaAnalyst;          // L1 investigator — CDR discrepancies, leak cases
    role RaLead;             // L2 team lead / four-eyes approver
    role FinanceController;  // L3 — final ATRA signer
    role OpsEngineer;        // real-time wall, holds, intervention queue
    role PolicyEngineer;     // rule/threshold/model author
    role Admin;              // system & ops admin
    role Auditor;            // read-only assurance
    role QaReviewer;         // QA sampling & scorecards
    role CsAgent;            // CS transaction status lookup (4 fields only)
    role RetailLiaison;      // business customer status (single field)
    role RegulatorViewer;    // ATRA inspector — scoped delegation view

    // Service principals
    principal SvcIngest    = "spiffe://awcc/ns/ra/sa/ingest";
    principal SvcRecon     = "spiffe://awcc/ns/ra/sa/recon";
    principal SvcRating    = "spiffe://awcc/ns/ra/sa/rating";
    principal SvcAtra      = "spiffe://awcc/ns/ra/sa/atra";
    principal SvcAlerts    = "spiffe://awcc/ns/ra/sa/alerts";
    principal SvcCase      = "spiffe://awcc/ns/ra/sa/case";
    principal SvcBi        = "spiffe://awcc/ns/ra/sa/bi";
    principal McpCopilot   = "mcp:ra-copilot";
}

// ---- Purpose taxonomy ----
nirdosha_guard_macros::purpose_taxonomy! {
    enum Purpose {
        Operations,
        FraudMonitoring,
        AmlInvestigation,
        CustomerService,
        QaReview,
        Audit,
        RegulatoryInspection,
        Analytics,
        ModelGovernance,
        PlatformOperations,
    }
}

// ---- Audit sampling ----
nirdosha_rt::audit_sampling! {
    classification: PUBLIC       -> rate 0.01;
    classification: INTERNAL     -> rate 0.10;
    classification: CONFIDENTIAL -> rate 1.0;
    classification: RESTRICTED   -> rate 1.0;
}

// ---- Approval chains ----
nirdosha_rt::approval_chain! {
    chain atra_release { quorum(2, of = [FinanceController]); timeout(deny); }
}
nirdosha_rt::approval_chain! {
    chain leak_case_review { quorum(2, of = [RaLead]); timeout(deny); }
}
nirdosha_rt::approval_chain! {
    chain policy_release { quorum(2, of = [PolicyEngineer, RaLead]); timeout(deny); cooling(days = 1); }
}
nirdosha_rt::approval_chain! {
    chain model_release { quorum(2, of = [PolicyEngineer, RaLead]); timeout(deny); }
}
nirdosha_rt::approval_chain! {
    chain override_release { quorum(1, of = [RaLead]); timeout(deny); }
}
nirdosha_rt::approval_chain! {
    chain purge_release { quorum(2, of = [Admin, RaLead]); timeout(deny); }
}
nirdosha_rt::approval_chain! {
    chain egress_release { quorum(1, of = [RaLead]); timeout(deny); }
}

// ---- Invariants ----
#[nirdosha_rt::invariant(name = "amount_positive", schema = "payment")]
fn amount_positive(p: &Payment) -> bool { p.amount.0 > 0.0 }

#[nirdosha_rt::invariant(name = "currency_iso", schema = "payment")]
fn currency_iso(p: &Payment) -> bool { p.currency.is_iso_4217() }

#[nirdosha_rt::invariant(name = "rationale_present", schema = "alert")]
fn rationale_present(a: &AlertUpdate) -> bool { !a.rationale.is_empty() }

#[nirdosha_rt::invariant(name = "disposition_code_valid", schema = "alert")]
fn disposition_code_valid(a: &AlertUpdate) -> bool {
    a.disposition_code.is_empty() || crate::domains::DISPOSITION_CODES.contains(&a.disposition_code.as_str())
}

#[nirdosha_rt::invariant(name = "case_disposition_valid", schema = "leak_case")]
fn case_disposition_valid(c: &CaseDispositionUpdate) -> bool {
    c.disposition.is_empty() || crate::domains::LEAK_CASE_DISPOSITION_CODES.contains(&c.disposition.as_str())
}

#[nirdosha_rt::invariant(name = "hold_reason_valid", schema = "payment")]
fn hold_reason_valid(p: &Payment) -> bool {
    match &p.hold_reason {
        Some(reason) => crate::domains::HOLD_REASON_CODES.contains(&reason.0.as_str()),
        None => false,
    }
}

// ---- Guard policies backing menus.toml / routes ----
// Generated from the (action, resource) pairs declared in menus.toml so that
// every non-blocked nav item resolves to a real guard_policy! record.

nirdosha_rt::guard_policy! {
    allow "ra-aggregate-alert" for RaAnalyst, RaLead, FinanceController, Admin
    when action == "aggregate" && resource == "alert"
    purpose(Analytics)
}
nirdosha_rt::guard_policy! {
    allow "ra-aggregate-cdr" for RaAnalyst
    when action == "aggregate" && resource == "cdr"
