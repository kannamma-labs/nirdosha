//! AWCC Revenue Assurance — bridge between guard corpus and UI screens.
//!
//! Minimal RA analog of `examples/rtm/src/bridge.nir`.

use nirdosha_guard_screens::GuardedEntity;

/// Human roles that browser sessions authenticate as.
pub const HUMAN_ROLES: &[&str] = &[
    "RaAnalyst",
    "RaLead",
    "FinanceController",
    "OpsEngineer",
    "PolicyEngineer",
    "Admin",
    "Auditor",
    "QaReviewer",
    "CsAgent",
    "RetailLiaison",
    "RegulatorViewer",
];

fn role_universe() -> Vec<String> {
    HUMAN_ROLES.iter().chain(["SvcAlerts", "SvcCase", "SvcAtra", "SvcRecon", "SvcBi"].iter()).map(|r| r.to_string()).collect()
}

fn make_table<E: GuardedEntity + Send + Sync + 'static>(
    resource_name: &str,
) -> nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, E> {
    nirdosha_guard_screens::GuardedTable::new(
        nirdosha_guard_mic::MemStoreDriver::new(),
        nirdosha_guard_registry::candidates(),
        nirdosha_guard_registry::dump().policies,
        "awcc-ra-demo",
        std::env::temp_dir().join(format!("awcc-ra-demo-{}-audit-{}.jsonl", resource_name, std::process::id())),
        role_universe(),
        "awcc-ra-demo",
        vec![],
    )
}

// ---- Alert / discrepancy row ----
#[derive(Debug, Clone, Default, serde::Serialize, serde::Deserialize)]
pub struct AlertRow {
    pub id: i64,
    pub alert_id: String,
    pub tenant_id: String,
    pub msisdn: String,
    pub cdr_id: String,
    pub status: String,
    pub score: f64,
    pub rule_hits: String,
    pub assignee: String,
    pub disposition_code: String,
    pub rationale: String,
    pub case_id: String,
    pub atra_linked: bool,
}

impl GuardedEntity for AlertRow {
    const RESOURCE: &'static str = "alert";
    fn row_id(&self) -> String { self.alert_id.clone() }
    fn field_policy_exempt() -> &'static [&'static str] { &["id", "alert_id"] }
    fn create_field_policy_exempt() -> &'static [&'static str] { &["id", "alert_id"] }
}

pub fn alert_table() -> &'static nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, AlertRow> {
    static TABLE: std::sync::OnceLock<nirdosha_guard_screens::GuardedTable<nirdosha_guard_mic::MemStoreDriver, AlertRow>> = std::sync::OnceLock::new();
    TABLE.get_or_init(|| make_table::<AlertRow>("alert"))
}

