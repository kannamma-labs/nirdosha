//! M6 CDR Detail — CDR search, ledger view, counterparty analysis, pattern/typology match viewer.
//!
//! AWCC Revenue Assurance screen module.

use crate::bridge::{cdr_table, CdrRow};
use nirdosha_rt::prelude::SharedTable;

fn unused_cdr_store() -> &'static SharedTable<i64, CdrRow> {
    static STORE: std::sync::OnceLock<SharedTable<i64, CdrRow>> = std::sync::OnceLock::new();
    STORE.get_or_init(SharedTable::new)
}

nirdosha_rt::crud_screens! {
    mount: mount_cdr_screens,
    entity: CdrRow,
    store: unused_cdr_store,
    path: "/cdrs",
    fields: [
        cdr_id: String,
        tenant_id: String,
        msisdn: String,
        imsi: String,
        account_id: String,
        call_type: String,
        duration_sec: i64,
        bytes: i64,
        amount: f64,
        currency: String,
        status: String,
        occurred_at: i64,
    ],
    create: public,
    read: public,
    update: public,
    delete: public,
    guard: {
        table: cdr_table,
        purpose: "Operations",
    },
}

pub fn mount_counterparty_analysis(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    router.get_with_auth("/cdrs/{id}/counterparty", "Counterparty Analysis (6.5)", |_req, params, auth| {
        let Some(id) = params.get("id").map(|s| s.to_string()) else { return nirdosha_rt::Response::bad_request("id required") };
        let row = match cdr_table().guarded_get(auth, "Operations", &id) {
            Ok(Some(r)) => r,
            Ok(None) => return nirdosha_rt::Response::json(404, &serde_json::json!({ "error": "not found" })),
            Err(e) => return nirdosha_guard_screens::guard_error_response(e),
        };
        let related = match cdr_table().guarded_snapshot(auth, "Operations") {
            Ok(rows) => rows.into_iter().filter(|r| r.msisdn == row.msisdn && r.cdr_id != id).take(20).collect::<Vec<_>>(),
            Err(e) => return nirdosha_guard_screens::guard_error_response(e),
        };
        nirdosha_rt::Response::json(200, &serde_json::json!({ "cdr_id": id, "msisdn": row.msisdn, "related_cdrs": related }))
    })
}

pub fn mount_pattern_viewer(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    router.get_with_auth("/cdrs/{id}/patterns", "Pattern/Typology Match Viewer (6.6)", |_req, params, auth| {
        let Some(id) = params.get("id").map(|s| s.to_string()) else { return nirdosha_rt::Response::bad_request("id required") };
        let patterns = match cdr_table().guarded_snapshot(auth, "Analytics") {
            Ok(rows) => {
                let mut by_type: std::collections::BTreeMap<String, i64> = std::collections::BTreeMap::new();
                for r in rows {
                    if r.msisdn == id { *by_type.entry(r.call_type.clone()).or_insert(0) += 1; }
                }
                by_type.into_iter().map(|(k, v)| serde_json::json!({ "pattern": k, "count": v })).collect::<Vec<_>>()
            }
            Err(e) => return nirdosha_guard_screens::guard_error_response(e),
        };
        nirdosha_rt::Response::json(200, &serde_json::json!({ "msisdn": id, "patterns": patterns }))
    })
}

pub fn mount_m06_cdr(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    let router = mount_counterparty_analysis(router);
    let router = mount_pattern_viewer(router);
    mount_cdr_screens(router)
}
