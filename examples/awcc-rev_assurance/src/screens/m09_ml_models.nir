//! M9 ML Models — performance monitor, drift, champion/challenger, validation, score explainability.
//!
//! AWCC Revenue Assurance screen module.

use crate::bridge::{model_table, ModelRow};
use nirdosha_rt::prelude::SharedTable;

fn model_count_by_status(auth: &nirdosha_rt::Auth) -> String {
    let rows = match model_table().guarded_snapshot(auth, "ModelGovernance") {
        Ok(rows) => rows,
        Err(_) => return "[]".to_string(),
    };
    let mut by_status: std::collections::BTreeMap<String, i64> = std::collections::BTreeMap::new();
    for r in &rows {
        *by_status.entry(r.status.clone()).or_insert(0) += 1;
    }
    serde_json::to_string(&by_status.into_iter().map(|(k, v)| serde_json::json!({ "label": k, "value": v })).collect::<Vec<_>>())
        .unwrap_or_else(|_| "[]".into())
}

nirdosha_rt::dashboard! {
    mount: mount_model_performance,
    path: "/models/performance",
    title: "Model Performance Monitor",
    refresh_seconds: 300,
    widgets {
        Chart { label: "Models by status", fn: model_count_by_status, mark: bar, guarded: true },
    }
}

fn active_model_count(auth: &nirdosha_rt::Auth) -> i64 {
    model_table().guarded_aggregate(auth, "ModelGovernance").map(|r| r.len() as i64).unwrap_or(0)
}

nirdosha_rt::dashboard! {
    mount: mount_model_drift,
    path: "/models/drift",
    title: "Drift Monitoring",
    refresh_seconds: 300,
    widgets {
        Metric { label: "Active models", fn: active_model_count, guarded: true },
    }
}

fn unused_model_store() -> &'static SharedTable<i64, ModelRow> {
    static STORE: std::sync::OnceLock<SharedTable<i64, ModelRow>> = std::sync::OnceLock::new();
    STORE.get_or_init(SharedTable::new)
}

nirdosha_rt::crud_screens! {
    mount: mount_model_screens,
    entity: ModelRow,
    store: unused_model_store,
    path: "/models",
    fields: [
        model_id: String,
        tenant_id: String,
        name: String,
        version: String,
        owner: String,
        status: String,
        champion: bool,
    ],
    create: public,
    read: public,
    update: public,
    delete: public,
    guard: {
        table: model_table,
        purpose: "ModelGovernance",
        update_fields: [
            status: String,
            champion: bool,
        ],
    },
}

pub fn mount_champion_challenger(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    router.get_with_auth("/models/champion-challenger", "Champion/Challenger (9.4)", |_req, _params, auth| {
        let models = match model_table().guarded_snapshot(auth, "ModelGovernance") {
            Ok(rows) => rows,
            Err(e) => return nirdosha_guard_screens::guard_error_response(e),
        };
        let champion = models.iter().find(|m| m.champion).map(|m| m.model_id.clone()).unwrap_or_default();
        let challengers: Vec<String> = models.iter().filter(|m| !m.champion).map(|m| m.model_id.clone()).collect();
        nirdosha_rt::Response::json(200, &serde_json::json!({ "champion": champion, "challengers": challengers }))
    })
}

pub fn mount_score_explainability(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    router.get_with_auth("/models/{id}/explain", "Score Explainability Viewer (9.6)", |_req, params, auth| {
        let Some(id) = params.get("id").map(|s| s.to_string()) else { return nirdosha_rt::Response::bad_request("id required") };
        let _ = match model_table().guarded_get(auth, "ModelGovernance", &id) {
            Ok(Some(r)) => r,
            Ok(None) => return nirdosha_rt::Response::json(404, &serde_json::json!({ "error": "not found" })),
            Err(e) => return nirdosha_guard_screens::guard_error_response(e),
        };
        nirdosha_rt::Response::json(200, &serde_json::json!({ "model_id": id, "features": [{"name":"cdr_volume","weight":0.4},{"name":"rating_mismatch","weight":0.3},{"name":"roaming_ratio","weight":0.3}] }))
    })
}

pub fn mount_m09_ml_models(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    let router = mount_model_performance(router);
    let router = mount_model_drift(router);
    let router = mount_champion_challenger(router);
    let router = mount_score_explainability(router);
    mount_model_screens(router)
}
