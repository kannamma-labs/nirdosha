//! M20 Audit — audit log search, config change history, regulatory audit pack export.
//!
//! AWCC Revenue Assurance screen module.

use crate::bridge::{audit_record_table, AuditRecordRow};
use nirdosha_rt::prelude::SharedTable;

fn unused_audit_store() -> &'static SharedTable<i64, AuditRecordRow> {
    static STORE: std::sync::OnceLock<SharedTable<i64, AuditRecordRow>> = std::sync::OnceLock::new();
    STORE.get_or_init(SharedTable::new)
}

nirdosha_rt::crud_screens! {
    mount: mount_audit_log_search,
    entity: AuditRecordRow,
    store: unused_audit_store,
    path: "/audit/log",
    fields: [
        record_id: String,
        tenant_id: String,
        actor: String,
        action: String,
        resource: String,
        occurred_at: String,
        details: String,
    ],
    create: public,
    read: public,
    update: public,
    delete: public,
    guard: {
        table: audit_record_table,
        purpose: "Audit",
    },
}

pub fn mount_audit_pack_export(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    router.get_with_auth("/audit/pack", "Regulatory Audit Pack Export (20.3)", |_req, _params, auth| {
        let records = match audit_record_table().guarded_snapshot(auth, "Audit") {
            Ok(rows) => rows,
            Err(e) => return nirdosha_guard_screens::guard_error_response(e),
        };
        nirdosha_rt::Response::json(200, &serde_json::json!({ "records": records.len(), "pack_id": "audit-pack-001" }))
    })
}

pub fn mount_m20_audit(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    let router = mount_audit_pack_export(router);
    mount_audit_log_search(router)
}
