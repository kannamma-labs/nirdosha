//! `awcc-rev-assurance` library target — AWCC Revenue Assurance, Nirdosha v2
//! dialect demo. Holds the policy/catalog corpus so both the binary and the
//! integration tests see the same registered `nirdosha_guard_registry` records.

#![allow(non_upper_case_globals, non_camel_case_types, dead_code)]

#[path = "domain_types.nir"]
pub mod domain_types;
#[path = "00_core.nir"]
pub mod core;
#[path = "10_domains.nir"]
pub mod domains;
#[path = "20_ingestion.nir"]
pub mod ingestion;
#[path = "bridge.nir"]
pub mod bridge;

// Re-export roles at crate root so screen macros can name them.
pub use core::nirdosha_roles;

// ---- Guard-enforced screens (M1–M22) ----
