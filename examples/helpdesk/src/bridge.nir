pub const HUMAN_ROLES: &[&str] = &[
    "Agent",
    "Admin",
];

pub const DEMO_TENANT: &str = "default";
/// Boot-time seeding for singleton guarded rows. Idempotent per
/// process: `std::sync::Once` (the guarded store lives for the process
/// lifetime, and `system_write` refuses a duplicate create rather than
/// upserting). Called from the generated `serve` main and from tests
/// that build a router without running main.
pub fn seed_singletons() {
    static ONCE: std::sync::Once = std::sync::Once::new();
    ONCE.call_once(|| {
        settings_table().system_write(DEMO_TENANT, &SettingsRow { id: 0, setting_id: "singleton".into(), tenant_id: DEMO_TENANT.into(), site_name: Default::default(), maintenance_mode: Default::default() });
    });
}
