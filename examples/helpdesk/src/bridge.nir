//! Generated by `cargo nirdosha generate-screens` from helpdesk's screens.toml.
//! Entities, `GuardedEntity` impls, `GuardedTable` constructors, managed stores,
//! `roles!`, and one real `guard_policy!` per (guarded screen, allowed action) —
//! synthesized from each guarded screen's own `policy` block. Do not edit by
//! hand; edit screens.toml and regenerate.

nirdosha_rt::roles! {
    Agent = "Agent";
    Admin = "Admin";
    Viewer = "Viewer";
}

// ---- approval chains ----

nirdosha_rt::approval_chain! {
    chain ticket_close { quorum(1, of = [Admin]); timeout(deny);  } }

pub fn corpus_approval_chains() -> Vec<nirdosha_guard_core::approval_chain::ApprovalChainDefinition> {
    nirdosha_guard_registry::dump()
        .approval_chains
        .iter()
        .map(|c| nirdosha_guard_core::approval_chain::ApprovalChainDefinition { name: c.name.clone(), quorum: c.quorum, approver_roles: c.approvers.to_vec(), cooling_period_ms: c.cooling_ms })
        .collect()
}

// ---- guard policies, synthesized from each guarded screen's policy block ----

nirdosha_rt::guard_policy! {
    allow "helpdesk-3-1-read" for Agent, Admin
    when action == "read" && resource == "ticket"
    purpose(Operations)
    filter tenant_scope()
    cap(row_cap = 200, max_scan_rows = 20_000)
    obligate audit(sampled)
}

