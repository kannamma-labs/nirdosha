//! Generated by `cargo nirdosha generate-screens` — boot wiring + mount order.
//! Literal-path mounts are registered before wildcard mounts: `Router::dispatch`
//! matches in registration order and a `/{id}` wildcard would otherwise swallow
//! the literal `new`/`board`/`edit` segments.

fn main() {
    helpdesk::bridge::seed_singletons();
    let router = helpdesk::app_shell::mount_app_shell(nirdosha_rt::Router::new(|_req| nirdosha_rt::Auth::login("anon", &[])));
    let router = helpdesk::app_shell::mount_login(router);
    let router = helpdesk::m03_tickets::mount_new_ticket_wizard(router);
    let router = helpdesk::m04_dashboards::mount_ops_dashboard(router);
    let router = helpdesk::m05_admin::mount_app_settings(router);
    let router = helpdesk::m05_admin::mount_team_feed(router);
    let router = helpdesk::m06_board::mount_ticket_board(router);
    let router = helpdesk::m06_board::mount_ticket_board_move(router);
    let router = helpdesk::m03_tickets::mount_tickets(router);
    println!("generated app — listening on http://localhost:8080/");
    router.serve(8080);
}
