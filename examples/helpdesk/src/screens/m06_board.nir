pub fn mount_ticket_board_move(router: nirdosha_rt::Router) -> nirdosha_rt::Router {
    router.post_with_auth("/tickets/{id}/move/{to}", "Move card", |_req, params, auth| {
        let Some(id) = params.get("id") else { return nirdosha_rt::Response::bad_request("id required") };
        let Some(to) = params.get("to") else { return nirdosha_rt::Response::bad_request("to required") };
        let changed: std::collections::HashSet<String> = ["status"].into_iter().map(|s| s.to_string()).collect();
        match ticket_table().guarded_update(auth, "Operations", id, &changed, move |e| { e.status = to.to_string(); }) {
            Ok(_entity) => nirdosha_rt::Response::redirect("/tickets"),
            Err(e) => nirdosha_guard_screens::guard_error_response(e),
        }
    })
}

