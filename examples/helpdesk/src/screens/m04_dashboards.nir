//! Generated by `cargo nirdosha generate-screens` — edit screens.toml, not this file.

// The macro grammar requires `entity:`/`store:` keys even where the
// guard-mode expansion never references them — keep the imports that
// match the invocation text and silence the residue.
#[allow(unused_imports)]
use crate::bridge::{
    ticket_table,
};

pub fn open_ticket_count(auth: &nirdosha_rt::Auth) -> i64 {
    match ticket_table().guarded_snapshot(auth, "Operations") {
        Ok(rows) => rows.iter().filter(|r| r.status == "open").count() as i64,
        Err(_) => 0,
    }
}

pub fn tickets_by_priority(auth: &nirdosha_rt::Auth) -> String {
    let mut counts: std::collections::BTreeMap<String, u64> = std::collections::BTreeMap::new();
    if let Ok(rows) = ticket_table().guarded_snapshot(auth, "Operations") {
        for r in rows.iter() {
            *counts.entry(r.priority.clone()).or_insert(0) += 1;
        }
    }
    let points: Vec<serde_json::Value> = counts.into_iter().map(|(name, count)| serde_json::json!({ "name": name, "count": count })).collect();
    serde_json::to_string(&points).unwrap_or_else(|_| "[]".to_string())
}

nirdosha_rt::dashboard! {
    mount: mount_ops_dashboard,
    path: "/dashboard/ops",
    title: "Ops Dashboard",
    refresh_seconds: 10,
    widgets {
        Metric { label: "Open tickets", fn: open_ticket_count, target: 5, alert_below: false, guarded: true },
        Chart { label: "Tickets by priority", fn: tickets_by_priority, mark: bar, guarded: true },
    }
}

