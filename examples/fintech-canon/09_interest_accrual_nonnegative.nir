// Canon: accruing interest onto a principal must never reduce the
// balance below the principal itself — a sign error here quietly
// erodes customer balances instead of growing them.
fn accrue_interest_cents(principal_cents: i64, interest_cents: i64) -> i64 {
    return principal_cents + interest_cents
}

validate accrue_interest_cents {
    pre: principal_cents >= 0 && interest_cents >= 0
    post: result >= principal_cents
}

fn main() {
    print(accrue_interest_cents(100000, 417))
}
